ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /app

COPY . .

RUN chmod +x docker-entrypoint.sh download_weights.sh

ENV PATH="/app/.venv/bin:$PATH"
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV AVATAR_PORT=8000
ENV TRANSFORMERS_NO_TF=1
EXPOSE ${AVATAR_PORT}

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["--warmup_musetalk"]
