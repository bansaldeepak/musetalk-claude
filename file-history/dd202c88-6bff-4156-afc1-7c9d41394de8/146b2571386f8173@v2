def enable_cuda_perf_flags() -> None:
    """Enable inference-time GPU perf flags. The big win is cudnn.benchmark, which
    lets cuDNN autotune the best conv algorithm per input shape (the UNet/VAE are
    conv-heavy) — but only pays off once each shape has been warmed (see warmup()).
    TF32 mostly helps residual fp32 ops since the main path runs in fp16. Safe on
    Ampere/Ada (L40S, sm_89). Must run before the first CUDA kernel / cuDNN cache."""
    if not torch.cuda.is_available():
        return
    torch.backends.cudnn.benchmark = True
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cudnn.allow_tf32 = True
    torch.set_float32_matmul_precision("high")


def raise_video_bitrate_ceiling(target_bps: int) -> None:
    """Lift aiortc's built-in VP8 rate clamp.

    aiortc ships DEFAULT_BITRATE=500kbps and hard-clamps target_bitrate to
    MAX_BITRATE=1.5Mbps (aiortc/codecs/vpx.py). Those defaults are sized for
    generic webcam video; for a 720x720 talking head they are the actual ceiling
    on how sharp the avatar can look, no matter what we render. The encoder still
    rate-adapts via REMB — this only raises the lid.

    They are module-level globals read at call time inside the target_bitrate
    setter, so rebinding them before any encoder is constructed is sufficient.
    Pinned to aiortc==1.14.0 in requirements.txt; if a future version renames
    them we log loudly rather than silently falling back to 500 kbps.
    """
    if target_bps <= 0:
        return
    try:
        from aiortc.codecs import vpx
    except Exception as e:  # pragma: no cover - import shape changed
        logger.warning(f"[Video] Could not import aiortc vpx codec module: {e}")
        return
    missing = [n for n in ("DEFAULT_BITRATE", "MIN_BITRATE", "MAX_BITRATE") if not hasattr(vpx, n)]
    if missing:
        logger.warning(
            f"[Video] aiortc vpx bitrate constants missing {missing}; "
            "leaving encoder defaults alone (video will stay capped at ~1.5 Mbps)"
        )
        return
    vpx.MAX_BITRATE = max(int(target_bps), int(vpx.MIN_BITRATE))
    vpx.DEFAULT_BITRATE = vpx.MAX_BITRATE
    logger.info(
        f"[Video] VP8 bitrate ceiling raised to {vpx.MAX_BITRATE / 1e6:.2f} Mbps "
        f"(start={vpx.DEFAULT_BITRATE / 1e6:.2f} Mbps, floor={vpx.MIN_BITRATE / 1e6:.2f} Mbps)"
    )


def limit_cpu_thread_pools(cv_threads: int) -> None:
    """Bound OpenCV's worker pool.

    Nothing set this before, so OpenCV spun up one thread per core and
    oversubscribed against the event loop, the single-thread render executor and
    the feature worker — which is what starves the loop and shows up as
    "Dropped N stale mic audio chunks". The per-frame CPU work is small enough
    that a couple of threads is plenty.
    """
    if cv_threads <= 0:
        return
    try:
        previous = cv2.getNumThreads()
        cv2.setNumThreads(cv_threads)
        logger.info(f"[Config] OpenCV threads {previous} -> {cv2.getNumThreads()}")
    except Exception as e:
        logger.warning(f"[Config] Could not set OpenCV thread count: {e}")


