def _import_musetalk() -> None:
    """Bind the MuseTalk model stack into module globals. Idempotent.

    Called from MuseTalkEngine.__init__ — i.e. exactly when something is about
    to use a model. Blank-avatar mode never constructs that class, so it never
    pays this (and never needs the packages installed).

    Locked because the import has heavy side effects (DWPose onto the GPU), so
    two threads racing it must not run it twice — today only one engine is ever
    built, and on the main thread, but that is not a property worth relying on."""
    if _musetalk_imported:
        return
    with _musetalk_import_lock:
        if _musetalk_imported:
            return
        _bind_musetalk_globals()


def _bind_musetalk_globals() -> None:
    global AudioProcessor, get_image_prepare_material, FaceParsing
    global coord_placeholder, get_landmark_and_bbox, read_imgs
    global load_all_model, WhisperModel, _musetalk_imported
    import transformers
