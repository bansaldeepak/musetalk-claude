def _env_float(name: str, default: float) -> float:
    value = os.environ.get(name)
    if not value:
        return default
    try:
        return float(value)
    except ValueError:
        logger.warning(f"[Config] Invalid float for {name}: {value!r}; using {default}")
        return default


def _env_int(name: str, default: int) -> int:
    value = os.environ.get(name)
    if not value:
        return default
    try:
        return int(value)
    except ValueError:
        logger.warning(f"[Config] Invalid int for {name}: {value!r}; using {default}")
        return default


def _env_bool(name: str, default: bool = False) -> bool:
    value = os.environ.get(name)
    if value is None or value.strip() == "":
        return default
    return value.strip().lower() in ("1", "true", "yes", "on")


def _env_choice(name: str, default: str, allowed: Tuple[str, ...]) -> str:
    """Env-backed enum. Anything unrecognised falls back to the default with a
    warning rather than being forwarded verbatim — several of these end up in
    the upstream session.update payload, where a bad value costs the whole
    session's config (session.update is sent once, with no retry)."""
    value = os.environ.get(name)
    if value is None or value == "":
        return default
    value = value.strip()
    if value not in allowed:
        logger.warning(
            f"[Config] Invalid value for {name}: {value!r}; "
            f"expected one of {allowed}; using {default!r}"
        )
        return default
    return value


def _gate_and_resample(gate, audio_bytes: bytes, source_rate: int, target_rate: int) -> bytes:
    """Run the mic gate, then resample for the upstream API.

    Folded into the single existing executor hop rather than added as another
    one — the ingest path is deliberately frugal about GIL handoffs (see
    _input_audio_sender_loop). The gate works at 16 kHz because that is
    Silero's native rate, so a non-16k source is resampled down first; that is
    not the production path (the browser is pinned to 16 kHz) and costs an
    extra resample when it happens.
    """
    if gate is not None and gate.enabled:
        if source_rate != AUDIO_SAMPLE_RATE:
            audio_bytes = _pcm16_resample_bytes(audio_bytes, source_rate, AUDIO_SAMPLE_RATE)
            source_rate = AUDIO_SAMPLE_RATE
        audio_bytes = gate.process(audio_bytes)
        # The gate holds back a sub-window remainder plus its look-ahead ring,
        # so an empty return is normal and just means "nothing due yet".
        if not audio_bytes:
            return b""
    return _pcm16_resample_bytes(audio_bytes, source_rate, target_rate)


def _pcm16_resample_bytes(audio_bytes: bytes, source_rate: int, target_rate: int) -> bytes:
    if not audio_bytes:
        return b""
    samples = np.frombuffer(audio_bytes, dtype=np.int16)
    if samples.size == 0:
        return b""
    if source_rate == target_rate:
        return samples.tobytes()
    resampled = soxr.resample(samples.astype(np.float32), source_rate, target_rate)
    return np.clip(resampled, -32768, 32767).astype(np.int16).tobytes()


def _prefer_vp8_video_codec(pc: RTCPeerConnection) -> None:
    capabilities = RTCRtpSender.getCapabilities("video")
    codecs = capabilities.codecs if capabilities else []
    vp8_codecs = [codec for codec in codecs if codec.mimeType.lower() == "video/vp8"]
    other_codecs = [codec for codec in codecs if codec.mimeType.lower() != "video/vp8"]
    if not vp8_codecs:
        logger.warning("[Server] VP8 codec unavailable; using default video codec negotiation")
        return
    for transceiver in pc.getTransceivers():
        if transceiver.kind != "video":
            continue
        try:
            transceiver.setCodecPreferences(vp8_codecs + other_codecs)
            logger.info("[Server] Preferring VP8 video codec")
        except Exception as e:
            logger.error(f"[Server] Could not set VP8 codec preference: {e}")


def _json_response(status: int, payload: dict) -> web.Response:
    return web.Response(status=status, content_type="application/json", text=json.dumps(payload))


def _truncate_for_log(value: str, limit: int = TAIBOLI_LOG_BODY_LIMIT) -> str:
    stripped = value.lstrip()
    if stripped[:9].lower().startswith("<!doctype") or stripped[:5].lower() == "<html":
        return f"<HTML response ({len(value)} chars)>"
    if len(value) <= limit:
        return value
    return f"{value[:limit]}...<truncated {len(value) - limit} chars>"


def _base64url_decode(value: str) -> bytes:
    padding_len = (-len(value)) % 4
    return base64.urlsafe_b64decode((value + ("=" * padding_len)).encode("ascii"))


def _decode_jwt_payload_without_verification(token: str) -> dict:
    parts = token.split(".")
    if len(parts) != 3:
        return {}
    try:
        return json.loads(_base64url_decode(parts[1]).decode("utf-8"))
    except Exception:
        return {}


def _read_bearer_token(authorization_header: Optional[str]) -> Optional[str]:
    if not authorization_header:
        return None
    parts = authorization_header.split(None, 1)
    if len(parts) == 2 and parts[0].lower() == "bearer":
        token = parts[1].strip()
        return token or None
    return None


def _parse_session_id(params: dict) -> Optional[str]:
    raw_session_id = params.get("sessionId") or params.get("session_id")
    session_id = str(raw_session_id).strip() if raw_session_id is not None else ""
    if not session_id:
        return None
    try:
        uuid.UUID(session_id)
    except ValueError:
        raise web.HTTPBadRequest(
            content_type="application/json",
            text=json.dumps({"error": "sessionId must be a UUID"}),
        )
    return session_id


def _read_trusted_clerk_identity(params: dict, request: web.Request) -> Tuple[Optional[str], Optional[str]]:
    raw_user_id = (
        params.get("clerkUserId")
        or params.get("clerk_user_id")
        or request.headers.get("x-clerk-user-id")
    )
    user_id = str(raw_user_id).strip() if raw_user_id is not None else ""
    raw_session_id = (
        params.get("clerkSessionId")
        or params.get("clerk_session_id")
        or request.headers.get("x-clerk-session-id")
    )
    clerk_session_id = str(raw_session_id).strip() if raw_session_id is not None else ""
    if user_id:
        return user_id, clerk_session_id or None

    token = _read_bearer_token(request.headers.get("authorization")) or request.cookies.get("__session")
    if not token:
        return None, clerk_session_id or None
    payload = _decode_jwt_payload_without_verification(token)
    token_user_id = payload.get("sub")
    if not isinstance(token_user_id, str) or not token_user_id.strip():
        return None, clerk_session_id or None
    token_session_id = payload.get("sid")
    return (
        token_user_id.strip(),
        clerk_session_id or (token_session_id.strip() if isinstance(token_session_id, str) else None),
    )


def _get_docker_host_ip() -> str:
    """
    Attempts to read the default gateway from /proc/net/route, which in a standard
    Docker bridge network points to the Docker host itself.
    Falls back to 'localhost' if it cannot be determined.
    """
    try:
        import socket
        import struct
        with open('/proc/net/route') as fh:
            for line in fh:
                fields = line.strip().split()
                # Find the default route (destination 00000000)
                if fields[1] != '00000000' or not int(fields[3], 16) & 2:
                    continue
                return socket.inet_ntoa(struct.pack('<L', int(fields[2], 16)))
    except Exception as e:
        logger.warning(f"[Config] Failed to read docker host IP: {e}")
    return "localhost"


def _video_to_imgs(vid_path: str, save_path: str, cut_frame: int = 10000000) -> None:
    cap = cv2.VideoCapture(vid_path)
    count = 0
    try:
        while count <= cut_frame:
            ok, frame = cap.read()
            if not ok:
                break
            cv2.imwrite(os.path.join(save_path, f"{count:08d}.png"), frame)
            count += 1
    finally:
        cap.release()
    if count == 0:
        raise RuntimeError(f"No frames could be read from {vid_path}")


def _image_paths(path: str) -> List[str]:
    files = glob.glob(os.path.join(path, "*.[jpJP][pnPN]*[gG]"))
    return sorted(files, key=lambda item: int(os.path.splitext(os.path.basename(item))[0]))


