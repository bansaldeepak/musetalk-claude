        "BARGE_IN_CORROBORATION", "off", ("energy", "gate", "near")
    )
    barge_in_corroboration_ms: int = _env_int("BARGE_IN_CORROBORATION_MS", 1500)
    # How long a barge-in may suppress response audio before we assume the
    # upstream cancel is never coming and resume playback. Azure's semantic_vad
    # fires speech_started on background noise; when it then completes the
    # response normally (status != "cancelled") nothing else ever clears
    # _pending_cancel, so the rest of the reply used to be discarded in silence.
    # 0 restores that behaviour. See _on_gpt_audio_delta.
    pending_cancel_grace_ms: int = _env_int("PENDING_CANCEL_GRACE_MS", 1200)
    # Emits debug.* data channel events to every connection when true, and
    # enables library-level debug logs (websocket frames, aiortc SCTP/ICE).
    # Set only on dev/playground deployments, never where real learners connect.
    session_debug: bool = os.environ.get("SESSION_DEBUG", "") == "true"
    taiboli_api_base_url: str = os.environ.get(
        "TAIBOLI_API_BASE_URL",
        os.environ.get("BACKEND_URL", "https://dev-app.taiboli.in/"),
    )
    taiboli_avatar_api_key: str = os.environ.get(
        "TAIBOLI_AVATAR_API_KEY",
        os.environ.get("AVATAR_API_KEY", ""),
    )
    taiboli_request_timeout_seconds: float = _env_float("TAIBOLI_REQUEST_TIMEOUT_SECONDS", 10.0)
    avatar_config: str = "configs/inference/realtime.yaml"
    avatar_id: Optional[str] = None
    video_path: Optional[str] = None
    result_dir: str = "./results"
    version: str = "v15"
    fps: int = 25
    gpu_id: int = 0
    vae_type: str = "sd-vae"
    unet_config: str = "./models/musetalkV15/musetalk.json"
    unet_model_path: str = "./models/musetalkV15/unet.pth"
    whisper_dir: str = "./models/whisper"
    bbox_shift: int = 0
    extra_margin: int = 10
    parsing_mode: str = "jaw"
    left_cheek_width: int = 90
    right_cheek_width: int = 90
    recreate_avatar: bool = False
    musetalk_batch_size: int = 4
    render_max_wait_ms: int = 8
    av_sync_prebuffer_ms: int = 240
    musetalk_profile: bool = False
    musetalk_metrics_interval_ms: int = 2000
    feature_step_ms: int = 120
    # How far ahead of the audio playback position lip-sync feature extraction is
    # allowed to run, in video frames.
    #
    # Azure delivers a whole turn's audio far faster than real time, so without a
    # bound the feature worker converts the ENTIRE response to prompts in the
    # first few seconds — measured at 16-18 s of video queued within ~4 s. On a
    # 4-core box that lands exactly when the render worker is trying to start the
    # turn: both CPU paths inflate (features 7 -> 30 ms/run, render 38 -> 73
    # ms/frame) while the GPU sits at ~35% util, the renderer falls behind the
    # audio clock, and render_next_frame repeats its last frame — the avatar
    # freezes for the first seconds of a turn while audio keeps playing.
    #
    # 75 frames (3 s) is far more than the renderer's own horizon
    # (render_ahead_frames = 8) while keeping the work paced with playback.
    # 0 disables pacing (restores the old race-ahead behaviour).
    feature_lead_frames: int = 75
    # Frames over which the mouth opens at the start of a turn and closes at the
    # end. Without this the mouth teleports between the closed idle pose and a
    # fully-formed speech pose in a single 40 ms frame, which reads as a snap
    # rather than a mouth moving. Interpolating the whisper PROMPT (not the
    # pixels) makes the UNet draw real intermediate mouth shapes; cross-fading
    # the images instead ghosts the lips. 3 frames = 120 ms, about how long a
    # real mouth takes to open. 0 disables the ramps.
    mouth_ramp_frames: int = 3
    # Jitter cushion: render a bit further ahead and tolerate a slightly-late frame so a
    # transient render spike doesn't fall outside the display window and freeze.
    max_render_lag_frames: int = 3
    # How far past the audio clock the render worker may work.
    #
    # This is really a BATCHING control, not a latency one: frames are displayed
    # against the audio clock either way, so rendering further ahead adds buffer,
    # not delay. At the old value of 8 the worker caught up to the horizon and
    # then received prompts one at a time as playback advanced, pinning it to
    # batch~1 -- the least efficient mode (32.7 ms/frame = 30 fps, ~4% headroom
    # over the 25 fps requirement). Any CPU contention pushed it under and it
    # could not recover until the contention stopped, which is what froze the
    # avatar for the first seconds of a turn.
    #
    # A wider horizon lets it fill batches (batch 4 = 14.1 ms/frame = 71 fps,
    # 2.8x headroom) and absorb spikes. Cost is bounded: at most this many
    # rendered frames buffered, and work discarded on barge-in.
    render_ahead_frames: int = 40
    warmup_musetalk: bool = False
    warmup_seconds: float = 1.5
    # Delivered video size (square). The lipsync model always works on a 256px face crop,
    # so this only scales the composited frame + WebRTC encode load, not model quality.
    # 0 = keep native source resolution.
    output_size: int = 720
    compile_models: bool = _env_bool("COMPILE_MODELS", False)
    compile_mode: str = _env_choice("COMPILE_MODE", "reduce-overhead", ("default", "reduce-overhead"))
    # VAE decoder: "sd" (full quality) or "taesd" (~10x faster tiny decoder, lower
    # fidelity — VALIDATE face/teeth quality before using in production).
    vae_decoder: str = "sd"
    # Idle (not-talking) mouth source. Both render through the UNet so idle shares the
    # exact talking lip color (no color tell):
    #   "unet_closed" — UNet driven by the searched prompt whose output best matches the
    #       real closed mouth: a natural closed mouth, no parted "whistle".
    #   "unet_silence" — UNet driven by a neutral/silent prompt. Pure digital silence is
    #       out-of-distribution for whisper and yields a parted mouth; idle_silence_noise
    #       injects a mic-like noise floor to mitigate that.
    idle_mode: str = "unet_closed"
    idle_silence_noise: float = 0.0
    # Delivered frame size. The avatar is composited at output_size and pasted
    # into the middle of this canvas, so the stream is 16:9 without the model,
    # the blend or the GPU doing any extra work. Set either to 0 to deliver the
    # avatar frame as-is (square).
    #
    # Square frontend views need no special handling: with the avatar centred,
    # CSS object-fit: cover on a 1:1 element crops back to exactly the avatar.
    canvas_width: int = 1280
    canvas_height: int = 720
    # Optional override for the still image behind the avatar (path). Empty means
    # use this avatar's own background, data/background/<video_name>.png, falling
    # back to black bars when there isn't one. Either way it is encoded in the same
    # VP8 frame as the avatar, so it shares the frame's quality rather than staying
    # crisp while the avatar softens.
    canvas_background: str = ""
    # Target VP8 bitrate. aiortc's own ceiling is 1.5 Mbps, which visibly limits a
    # 720px talking head; 0 keeps aiortc's defaults. See raise_video_bitrate_ceiling.
    video_bitrate: int = 4_000_000
    # OpenCV worker threads (0 = leave alone). Bounded so the CV pool doesn't
    # oversubscribe the event loop / render worker.
    cv_threads: int = 2
    # Sample rate delivered to the browser. Azure emits 24 kHz; downsampling that
    # to 16 kHz for playback throws away everything above 8 kHz (the clarity /
    # sibilance band) for no benefit, since aiortc's Opus encoder resamples to
    # 48 kHz regardless. The 16 kHz path is still required for lip-sync features.
    playback_sample_rate: int = GPT_RT_SAMPLE_RATE
    # --- blank-avatar dev mode ----------------------------------------------
    # Serve a plain black frame at the SAME delivered resolution instead of a
    # rendered avatar: no MuseTalk models, no whisper, no GPU, no weights. The
    # realtime voice loop, tool calling, data-channel protocol and the Taiboli
    # bridge all behave exactly as in production, so this is what the CPU-only
    # dev deployment runs (Dockerfile.base.cpu bakes AVATAR_BLANK_MODE=1).
    # Never set this where real learners connect — they would see a black box.
    blank_avatar: bool = _env_bool("AVATAR_BLANK_MODE", False)


class MuseTalkRuntimeMetrics:
    """Rolling render/queue telemetry.

    Collection is ALWAYS on: the counters are a lock plus a few increments,
    which is nothing next to a UNet forward, and having them always populated is
    what makes the /metrics endpoint useful without restarting into a profiling
    mode. `enabled` now gates only the periodic [MuseTalkProfile] log line.
    """

    def __init__(self, enabled: bool = False, interval_ms: int = 2000):
        self.enabled = bool(enabled)
        self.interval_s = max(0.25, float(interval_ms) / 1000.0)
        self._lock = threading.Lock()
        self._reset_window_locked(time.monotonic())

    def _reset_window_locked(self, now: float):
        self.window_started_at = now
        self.feature_runs = 0
        self.feature_ms = 0.0
        self.feature_prompts = 0
        self.render_batches = 0
        self.render_frames = 0
        self.render_ms = 0.0
        self.render_frame_ms_samples: List[float] = []
        self.blend_ms = 0.0
        self.stale_prompt_drops = 0
        self.display_generated = 0
        self.display_repeated = 0
        self.frames_delivered = 0
        self.max_prompt_queue = 0
        self.max_rendered_queue = 0

    def record_feature(self, elapsed_ms: float, prompts: int):
        with self._lock:
            self.feature_runs += 1
            self.feature_ms += float(elapsed_ms)
            self.feature_prompts += int(prompts)

    def record_render(self, elapsed_ms: float, frames: int, blend_ms: float):
        with self._lock:
            self.render_batches += 1
            self.render_frames += int(frames)
            self.render_ms += float(elapsed_ms)
            self.blend_ms += float(blend_ms)
            if frames > 0:
                # Per-frame render time for this batch; the tail (p95/max) is what
                # produces a visible freeze when it overruns the frame budget.
                self.render_frame_ms_samples.append(float(elapsed_ms) / int(frames))

    def record_delivered(self):
        with self._lock:
            self.frames_delivered += 1

    def record_stale_prompt_drops(self, count: int):
        if count <= 0:
            return
        with self._lock:
            self.stale_prompt_drops += int(count)

    def record_display(self, generated: bool, repeated: bool):
        with self._lock:
            if generated:
                self.display_generated += 1
            if repeated:
                self.display_repeated += 1

    def observe_queues(self, prompt_depth: int, rendered_depth: int):
        with self._lock:
            self.max_prompt_queue = max(self.max_prompt_queue, int(prompt_depth))
            self.max_rendered_queue = max(self.max_rendered_queue, int(rendered_depth))

    def maybe_log(self, force: bool = False):
        with self._lock:
            now = time.monotonic()
            elapsed = max(1e-6, now - self.window_started_at)
            if not force and elapsed < self.interval_s:
                return
            if not self.enabled:
                # Still roll the window even when not logging, or
                # render_frame_ms_samples would grow without bound.
                self._reset_window_locked(now)
                return
            feature_avg = self.feature_ms / self.feature_runs if self.feature_runs else 0.0
            render_batch_avg = self.render_ms / self.render_batches if self.render_batches else 0.0
            render_frame_avg = self.render_ms / self.render_frames if self.render_frames else 0.0
            blend_frame_avg = self.blend_ms / self.render_frames if self.render_frames else 0.0
            if self.render_frame_ms_samples:
                render_frame_p95 = float(np.percentile(self.render_frame_ms_samples, 95))
                render_frame_max = float(max(self.render_frame_ms_samples))
            else:
                render_frame_p95 = render_frame_max = 0.0
            generated_fps = self.display_generated / elapsed
            displayed_fps = (self.display_generated + self.display_repeated) / elapsed
            delivered_fps = self.frames_delivered / elapsed
            logger.info(
                "[MuseTalkProfile] "
                f"feature={feature_avg:.1f}ms/run prompts={self.feature_prompts} "
                f"render={render_batch_avg:.1f}ms/batch {render_frame_avg:.1f}ms/frame "
                f"(p95={render_frame_p95:.1f} max={render_frame_max:.1f}) "
                f"blend={blend_frame_avg:.1f}ms/frame generated_fps={generated_fps:.1f} "
                f"display_fps={displayed_fps:.1f} delivered_fps={delivered_fps:.1f} "
                f"repeated={self.display_repeated} stale_prompts={self.stale_prompt_drops} "
                f"q_prompt={self.max_prompt_queue} q_rendered={self.max_rendered_queue}"
            )
            self._reset_window_locked(now)


async def _preconnect_azure_ws(config: "ServerConfig"):
    """Open an Azure Realtime WebSocket without sending session.update.

    Runs concurrently with fetch_instructions so the handshake overlaps with
    the Taiboli API round-trip instead of serialising after it.
    Returns the open websocket, or None on failure (caller falls back to
    the normal connect path).
    """
    if config.local_realtime_url.strip():
        return None
    if not config.azure_openai_api_key:
        return None
    endpoint = config.azure_openai_endpoint.strip().rstrip("/")
    if endpoint.startswith("https://"):
        endpoint = endpoint[len("https://"):]
    elif endpoint.startswith("http://"):
        endpoint = endpoint[len("http://"):]
    if config.azure_realtime_url_style == "preview":
        url = (
            f"wss://{endpoint}/openai/realtime"
            f"?api-version={config.azure_api_version}"
            f"&deployment={config.azure_openai_deployment}"
        )
    else:
        url = f"wss://{endpoint}/openai/v1/realtime?model={config.azure_openai_deployment}"
    headers = {"api-key": config.azure_openai_api_key}
    try:
        ws = await websockets.connect(
            url,
            additional_headers=headers,
            ping_interval=20,
            ping_timeout=20,
            max_size=None,
        )
        logger.info("[Realtime] Pre-opened Azure WebSocket during fetch")
        return ws
    except TypeError:
        try:
            ws = await websockets.connect(
                url,
                extra_headers=headers,
                ping_interval=20,
                ping_timeout=20,
                max_size=None,
            )
            logger.info("[Realtime] Pre-opened Azure WebSocket during fetch (extra_headers)")
            return ws
        except Exception as e:
            logger.warning(f"[Realtime] Pre-connect failed: {e}; will connect normally")
            return None
    except Exception as e:
        logger.warning(f"[Realtime] Pre-connect failed: {e}; will connect normally")
        return None


class AzureRealtimeSession:
    def __init__(
        self,
        config: ServerConfig,
        system_prompt: str,
        tools: list,
        on_audio_delta,
        on_text_delta,
        on_transcript_delta,
        on_tool_call,
        on_response_created,
        on_response_done,
        on_speech_started,
        on_speech_stopped,
        on_input_transcript_delta,
        on_input_transcript,
        on_error,
        on_session_updated=None,
        on_output_item_done=None,
        on_raw_event=None,
        on_closed=None,
    ):
        self.config = config
        self.system_prompt = system_prompt
        self.tools = tools
        self.on_audio_delta = on_audio_delta
        self.on_text_delta = on_text_delta
        self.on_transcript_delta = on_transcript_delta
        self.on_tool_call = on_tool_call
        self.on_response_created = on_response_created
        self.on_response_done = on_response_done
        self.on_speech_started = on_speech_started
        self.on_speech_stopped = on_speech_stopped
        self.on_input_transcript_delta = on_input_transcript_delta
        self.on_input_transcript = on_input_transcript
        self.on_error = on_error
        self.on_session_updated = on_session_updated
        self.on_output_item_done = on_output_item_done
        self.on_raw_event = on_raw_event
        self.on_closed = on_closed
        self.ws = None
        self._listen_task = None
        self._send_lock = asyncio.Lock()
        self._closed = False
        self.is_local = False
        self._response_active = False
        self._pending_response_create = False
        # session.update verification state. The payload is sent once and never
        # acknowledged, so a rejected experimental field would silently cost the
        # whole session's config — these let us detect that and fall back.
        self._last_session_payload = None
        self._disabled_session_fields = set()
        self._session_update_retries = 0
        self._session_updated_seen = False
        self.noise_reduction_echoed = False
        self.session_fields_stripped = False

    def _azure_ws_url(self) -> str:
        endpoint = self.config.azure_openai_endpoint.strip().rstrip("/")
        if endpoint.startswith("https://"):
            endpoint = endpoint[len("https://"):]
        elif endpoint.startswith("http://"):
            endpoint = endpoint[len("http://"):]

        if self.config.azure_realtime_url_style == "preview":
            return (
                f"wss://{endpoint}/openai/realtime"
                f"?api-version={self.config.azure_api_version}"
                f"&deployment={self.config.azure_openai_deployment}"
            )
        return f"wss://{endpoint}/openai/v1/realtime?model={self.config.azure_openai_deployment}"

    def _session_payload(self) -> dict:
        # Experimental fields are dropped once the endpoint has rejected them,
        # so the retry converges on the known-good relay-parity payload.
        noise_reduction = self.config.input_noise_reduction
        eagerness = self.config.semantic_vad_eagerness
        if "noise_reduction" in self._disabled_session_fields:
            noise_reduction = ""
        if "eagerness" in self._disabled_session_fields:
            eagerness = ""
        payload = relay_protocol.build_realtime_session_payload(
            url_style=self.config.azure_realtime_url_style,
            is_local=self.is_local,
            instructions=self.system_prompt,
            tools=self.tools,
            voice=self.config.gpt_rt_voice,
            speed=self.config.gpt_rt_voice_speed,
            transcription_model=self.config.input_transcription_model,
            transcription_language=self.config.input_transcription_language,
            turn_detection_type=self.config.turn_detection_type,
            vad_threshold=self.config.vad_threshold,
            vad_prefix_padding_ms=self.config.vad_prefix_padding_ms,
            vad_silence_duration_ms=self.config.vad_silence_duration_ms,
            local_input_rate=AUDIO_SAMPLE_RATE,
            remote_rate=GPT_RT_SAMPLE_RATE,
            noise_reduction=noise_reduction,
            semantic_vad_eagerness=eagerness,
        )
        self._last_session_payload = payload
        return payload

    def _experimental_fields_sent(self) -> bool:
        """True when the last payload carried a field the relay never sends."""
        session = (self._last_session_payload or {}).get("session", {})
        audio_input = session.get("audio", {}).get("input", {})
        if "noise_reduction" in audio_input:
            return True
        return "eagerness" in audio_input.get("turn_detection", {})

    async def _strip_experimental_and_resend(self, why: str):
        """Fall back to the relay-parity payload after a suspected rejection.

        session.update is sent once and never acknowledged, so a rejected field
        does not just lose that field — it loses voice, transcription language
        and turn detection too. One retry, guarded by a counter so it cannot
        loop. Strips everything experimental at once rather than parsing the
        error's `param`, which avoids depending on the endpoint's error format.
        """
        if self._session_update_retries or not self._experimental_fields_sent():
            return
        self._session_update_retries += 1
        self._disabled_session_fields.update({"noise_reduction", "eagerness"})
        self.session_fields_stripped = True
        logger.warning(
            f"[Realtime] {why}; retrying session.update without noise_reduction/eagerness"
        )
        await self._send(self._session_payload())

    def _verify_session_echo(self, event: dict):
        """Diff what the endpoint echoed back against what we sent.

        Compares presence and the `type` value only — the service normalises
        and back-fills defaults, so exact dict equality produces false alarms.
        A field we sent that is missing from the echo is the "silently
        swallowed" case, which is the most likely failure mode for
        noise_reduction on Azure.
        """
        sent = (self._last_session_payload or {}).get("session", {})
        sent_input = sent.get("audio", {}).get("input", {})
        if not sent_input:
            return
        echoed = event.get("session", {})
        echo_input = echoed.get("audio", {}).get("input", {})

        if "noise_reduction" in sent_input:
            want = sent_input["noise_reduction"]
            want_type = want.get("type") if isinstance(want, dict) else None
            if "noise_reduction" not in echo_input:
                logger.warning(
                    f"[Realtime] noise_reduction={want_type!r} was sent but is ABSENT from the "
                    f"session.updated echo — the endpoint may not support it. Input filtering is "
                    f"NOT active upstream; rely on the local mic gate instead."
                )
            else:
                got = echo_input["noise_reduction"]
                got_type = got.get("type") if isinstance(got, dict) else None
                self.noise_reduction_echoed = True
                level = logger.info if got_type == want_type else logger.warning
                level(f"[Realtime] noise_reduction sent={want_type!r} echo={got_type!r}")

        want_eager = sent_input.get("turn_detection", {}).get("eagerness")
        if want_eager:
            got_eager = echo_input.get("turn_detection", {}).get("eagerness")
            level = logger.info if got_eager == want_eager else logger.warning
            level(f"[Realtime] semantic_vad eagerness sent={want_eager!r} echo={got_eager!r}")

    async def _connect_azure(self):
        if not self.config.azure_openai_api_key:
            raise RuntimeError("AZURE_OPENAI_API_KEY is not configured")
        headers = {"api-key": self.config.azure_openai_api_key}
        azure_url = self._azure_ws_url()
        logger.info(f"[Realtime] Connecting to Azure at {azure_url}")
        try:
            self.ws = await websockets.connect(
                azure_url,
                additional_headers=headers,
                ping_interval=20,
                ping_timeout=20,
                max_size=None,
            )
        except TypeError as e:
            logger.warning(f"[Realtime] TypeError with additional_headers, retrying with extra_headers: {e}")
            try:
                self.ws = await websockets.connect(
                    azure_url,
                    extra_headers=headers,
                    ping_interval=20,
                    ping_timeout=20,
                    max_size=None,
                )
            except Exception as conn_err:
                logger.error(f"[Realtime] Azure connection failed with extra_headers: {conn_err}")
                raise
        except Exception as conn_err:
            logger.error(f"[Realtime] Azure connection failed with additional_headers: {conn_err}")
            raise
        logger.info("[Realtime] Connected to Azure OpenAI")

    async def connect(self, pre_opened_ws=None):
        if pre_opened_ws is not None:
            self.ws = pre_opened_ws
            self.is_local = False
            logger.info("[Realtime] Using pre-opened Azure WebSocket")
        else:
            local_url = self.config.local_realtime_url.strip()
            if local_url:
                logger.info(f"[Realtime] Attempting local connection to {local_url}")
                try:
                    self.ws = await websockets.connect(
                        local_url,
                        ping_interval=20,
                        ping_timeout=20,
                        max_size=None,
                    )
                    self.is_local = True
                    logger.info("[Realtime] Connected to local Live Parlor server (is_local=True)")
                except Exception as local_err:
                    logger.warning(f"[Realtime] Local connection failed: {local_err}. Falling back to Azure OpenAI...")
                    self.is_local = False
                    await self._connect_azure()
            else:
                self.is_local = False
                await self._connect_azure()

        await self._send(self._session_payload())
        self._listen_task = asyncio.create_task(self._listen_loop())
        logger.info("[Realtime] Session update sent")

    async def update_system_prompt(self, system_prompt: str):
        self.system_prompt = system_prompt
        await self._send(self._session_payload())

    async def send_session_update(self, instructions: str, tools: list) -> bool:
        """Send a mid-session update with replacement instructions and tools.

        Returns True if session.updated confirmation received within timeout.
        """
        tool_names = [t.get("name", "?") for t in tools if isinstance(t, dict)]
        logger.info(
            f"[Realtime] Sending mid-session session.update: "
            f"instructions={len(instructions)} chars, "
            f"tools={tool_names}"
        )
        self.system_prompt = instructions
        self.tools = tools
        payload: dict = {
            "type": "session.update",
            "session": {
                "type": "realtime",
                "instructions": instructions,
            },
        }
        if tools is not None:
            payload["session"]["tools"] = tools
            payload["session"]["tool_choice"] = "auto" if tools else "none"
        self._session_update_event = asyncio.Event()
        await self._send(payload)
        confirmed = await self._await_session_updated(timeout=5.0)
        if confirmed:
            logger.info("[Realtime] Mid-session session.update confirmed by provider")
        else:
            logger.error("[Realtime] Mid-session session.update NOT confirmed (timed out)")
        return confirmed

    async def _await_session_updated(self, timeout: float = 5.0) -> bool:
        try:
            await asyncio.wait_for(self._session_update_event.wait(), timeout)
            return True
        except asyncio.TimeoutError:
            logger.warning("[Realtime] Mid-session session.update confirmation timed out")
            return False

    async def trigger_response(self):
        """Send response.create to prompt the model to speak."""
        logger.debug("[Realtime] response.create (trigger_response)")
        await self._send({"type": "response.create"})

    async def _send(self, payload: dict):
        if self._closed or self.ws is None:
            return
        ptype = payload.get("type")
        if ptype == "conversation.item.create":
            item = payload.get("item", {})
            itype = item.get("type", "?")
            if itype == "function_call_output":
                logger.debug(f"[Realtime] >>> conversation.item.create: type={itype} call_id={item.get('call_id', '?')}")
            elif itype == "message":
                role = item.get("role", "?")
                content = item.get("content", [])
                text = (content[0].get("text", "") if content else "")[:80]
                logger.debug(f"[Realtime] >>> conversation.item.create: type={itype} role={role} text={text!r}")
            else:
                logger.debug(f"[Realtime] >>> conversation.item.create: type={itype}")
        async with self._send_lock:
            await self.ws.send(json.dumps(payload))

    async def send_audio(self, audio_base64: str):
        await self._send({"type": "input_audio_buffer.append", "audio": audio_base64})

    async def send_audio_binary(self, pcm_bytes: bytes):
        # LOCAL only: raw PCM16 as a binary WS frame (ws_server accepts binary
        # input directly). Avoids base64 + the input resample round-trip.
        if self._closed or self.ws is None:
            return
        async with self._send_lock:
            await self.ws.send(pcm_bytes)

    async def send_user_text(self, text: str):
        logger.debug(f"[Realtime] send_user_text: {text[:80]}")
        await self._send({
            "type": "conversation.item.create",
            "item": {
                "type": "message",
                "role": "user",
                "content": [{"type": "input_text", "text": text}],
            },
        })
        logger.debug("[Realtime] response.create (send_user_text)")
        await self._send({"type": "response.create"})

    async def send_tool_result(self, call_id: str, result: str):
        logger.debug(f"[Realtime] send_tool_result: call_id={call_id} active={self._response_active}")
        await self._send({
            "type": "conversation.item.create",
            "item": {"type": "function_call_output", "call_id": call_id, "output": result},
        })
        if self._response_active:
            self._pending_response_create = True
            logger.info("[Realtime] response.create deferred — cancelling active response")
            logger.debug("[Realtime] response.cancel (send_tool_result, deferred)")
            await self._send({"type": "response.cancel"})
        else:
            logger.debug("[Realtime] response.create (send_tool_result, direct)")
            await self._send({"type": "response.create"})

    async def send_raw(self, payload: dict):
        """Forward a browser-sent Realtime-protocol message verbatim (the
        client speaks raw conversation.item.create / response.create for
        request_selection outcomes and structured text input)."""
        ptype = payload.get("type", "?")
        if ptype in ("response.create", "response.cancel"):
            logger.debug(f"[Realtime] {ptype} (send_raw / browser passthrough)")
        await self._send(payload)

    async def send_greeting(self):
        """Trigger the model's opening turn by injecting a user message and
        requesting a bare response.create. This keeps the full session
        instructions intact (no per-response override that would replace them)."""
        await self._send({
            "type": "conversation.item.create",
            "item": {
                "type": "message",
                "role": "user",
                "content": [{"type": "input_text", "text": relay_protocol.GREETING_USER_MESSAGE}],
            },
        })
        logger.debug("[Realtime] response.create (send_greeting)")
        await self._send({"type": "response.create"})

    async def interrupt(self):
        logger.debug("[Realtime] response.cancel (interrupt) — clearing pending_response_create")
        self._pending_response_create = False
        await self._send({"type": "response.cancel"})

    async def _listen_loop(self):
        try:
            async for message in self.ws:
                try:
                    event = json.loads(message)
                except json.JSONDecodeError as e:
                    logger.error(f"[Realtime] Failed to parse WebSocket message as JSON: {e}. Message: {_truncate_for_log(str(message))}")
                    self.on_error({"type": "error", "error": {"message": f"JSON decode error: {e}"}})
                    continue
                if self.on_raw_event:
                    try:
                        self.on_raw_event(event)
                    except Exception as e:
                        logger.error(f"[Realtime] Raw event hook failed: {e}")
                event_type = event.get("type", "")
                if event_type in ("response.output_audio.delta", "response.audio.delta"):
                    audio_b64 = event.get("delta", "")
                    if audio_b64:
                        self.on_audio_delta(audio_b64)
                elif event_type in ("response.output_audio_transcript.delta", "response.audio_transcript.delta"):
                    text = event.get("delta", "")
                    if text:
                        self.on_transcript_delta(text)
                elif event_type == "response.output_text.delta":
                    text = event.get("delta", "")
                    if text:
                        self.on_text_delta(text)
                elif event_type == "response.created":
                    resp_id = event.get("response", {}).get("id", "?")
                    logger.debug(f"[Realtime] response.created: id={resp_id}")
                    self._response_active = True
                    self.on_response_created(event)
                elif event_type == "session.updated":
                    # Azure has applied our session.update — the D5 greeting
                    # trigger. Fires well after WS open; session.created is too
                    # early (instructions/tools not configured yet).
                    self._session_updated_seen = True
                    try:
                        self._verify_session_echo(event)
                    except Exception as e:
                        # Diagnostics must never break the greeting path.
                        logger.warning(f"[Realtime] session echo check failed: {e}")
                    if hasattr(self, "_session_update_event"):
                        self._session_update_event.set()
                    if self.on_session_updated:
                        self.on_session_updated(event)
                elif event_type == "response.function_call_arguments.done":
                    self.on_tool_call(event)
                elif event_type == "response.output_item.done":
                    # GA omits `name` from function_call_arguments.done; the
                    # function_call item here carries it (relay parity).
                    if self.on_output_item_done:
                        self.on_output_item_done(event)
                elif event_type == "response.done":
                    resp = event.get("response", {})
                    resp_id = resp.get("id", "?")
                    resp_status = resp.get("status", "?")
                    logger.debug(f"[Realtime] response.done: id={resp_id} status={resp_status} pending={self._pending_response_create}")
                    if resp_status == "failed":
                        details = resp.get("status_details") or {}
                        error_code = details.get("error", {}).get("code", "")
                        logger.warning(f"[Realtime] response FAILED: {json.dumps(details)}")
                        if error_code == "inference_rate_limit_exceeded":
                            self._rate_limit_retries = getattr(self, "_rate_limit_retries", 0) + 1
                            if self._rate_limit_retries <= 3:
                                delay = self._rate_limit_retries * 1.0
                                logger.info(f"[Realtime] Rate-limited — auto-retry in {delay}s (attempt {self._rate_limit_retries})")
                                self._response_active = False
                                async def _rate_limit_retry(secs):
                                    await asyncio.sleep(secs)
                                    if not self._closed:
                                        logger.debug(f"[Realtime] response.create (rate-limit retry)")
                                        await self._send({"type": "response.create"})
                                asyncio.create_task(_rate_limit_retry(delay))
                                continue
                            else:
                                logger.warning("[Realtime] Rate-limit retries exhausted — waiting for user speech")
                    else:
                        self._rate_limit_retries = 0
                    self._response_active = False
                    if self._pending_response_create:
                        self._pending_response_create = False
                        logger.debug("[Realtime] response.create (pending from deferred cancel)")
                        await self._send({"type": "response.create"})
                    self.on_response_done(event)
                elif event_type == "input_audio_buffer.speech_started":
                    logger.debug("[Realtime] speech_started (VAD)")
                    self.on_speech_started(event)
                elif event_type == "input_audio_buffer.speech_stopped":
                    logger.debug("[Realtime] speech_stopped (VAD)")
                    self.on_speech_stopped(event)
                elif event_type == "conversation.item.input_audio_transcription.delta":
                    self.on_input_transcript_delta(event)
                elif event_type == "conversation.item.input_audio_transcription.completed":
                    self.on_input_transcript(event)
                elif event_type == "conversation.item.input_audio_transcription.failed":
                    logger.warning(f"[Realtime] Input transcription failed: {event.get('error', {})}")
                elif event_type == "error":
                    # An error before session.updated is very likely our own
                    # session.update being rejected — retry without the
                    # experimental fields rather than running the whole session
                    # with none of the relay-parity config applied.
                    if not self._session_updated_seen:
                        detail = event.get("error", {})
                        await self._strip_experimental_and_resend(
                            f"error before session.updated ({detail!r})"
                        )
                    self.on_error(event)
        except asyncio.CancelledError:
            pass
        except Exception as e:
            logger.error(f"[Realtime] Listen loop exception: {e}")
            self.on_error({"type": "error", "error": {"message": str(e)}})
        finally:
            # The upstream socket is gone. Unless this is our own close(), the
            # session is dead — without this, a dropped Azure WS left a zombie
            # avatar idling forever with no error surfaced (relay parity:
            # azure close/error tears the whole connection down).
            if not self._closed and self.on_closed:
                try:
                    self.on_closed()
                except Exception as e:
                    logger.error(f"[Realtime] on_closed hook failed: {e}")

    async def close(self):
        self._closed = True
        if self._listen_task:
            self._listen_task.cancel()
        if self.ws is not None:
            await self.ws.close()


class TaiboliBridgeError(Exception):
    def __init__(self, status: int, message: str):
        super().__init__(message)
        self.status = status
        self.message = message


class TaiboliBridgeClient:
    def __init__(
        self,
        config: ServerConfig,
        session_id: str,
        clerk_user_id: str,
        clerk_session_id: Optional[str] = None,
        request_id: Optional[str] = None,
    ):
        self.config = config
        self.session_id = session_id
        self.clerk_user_id = clerk_user_id
        self.clerk_session_id = clerk_session_id
        self.request_id = request_id or str(uuid.uuid4())

    def _api_url(self, path: str) -> str:
        base_url = self.config.taiboli_api_base_url.strip().rstrip("/")
        if not base_url:
            raise RuntimeError("TAIBOLI_API_BASE_URL is not configured")
        if not base_url.endswith("/api"):
            base_url = f"{base_url}/api"
        return f"{base_url}{path}"

    def _headers(self) -> dict:
        if not self.config.taiboli_avatar_api_key:
            raise RuntimeError("TAIBOLI_AVATAR_API_KEY or AVATAR_API_KEY is not configured")
        headers = {
            "Authorization": f"Bearer {self.config.taiboli_avatar_api_key}",
            "X-Clerk-User-Id": self.clerk_user_id,
            "X-Request-Id": self.request_id,
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        }
        if self.clerk_session_id:
            headers["X-Clerk-Session-Id"] = self.clerk_session_id
        return headers

    def _safe_clerk_user_id(self) -> str:
        if len(self.clerk_user_id) <= 12:
            return self.clerk_user_id
        return f"{self.clerk_user_id[:8]}...{self.clerk_user_id[-4:]}"

    def _log_api_failure(
        self,
        method: str,
        path: str,
        *,
        status: Optional[int] = None,
        body: Optional[str] = None,
        headers: Optional[dict] = None,
        error: Optional[str] = None,
    ) -> None:
        details = [
            f"method={method}",
            f"path={path}",
            f"session_id={self.session_id}",
            f"clerk_user_id={self._safe_clerk_user_id()}",
            f"request_id={self.request_id}",
        ]
        if status is not None:
            details.append(f"status={status}")
        if headers:
            details.append(f"headers={json.dumps(headers, sort_keys=True)}")
        if error:
            details.append(f"error={error!r}")
        if body:
            details.append(f"body={_truncate_for_log(body)!r}")
        logger.error("[Taiboli] API request failed: " + " ".join(details))

    def _selected_response_headers(self, response: aiohttp.ClientResponse) -> dict:
        selected = {}
        for header in ("content-type", "cf-ray", "server", "x-request-id"):
            value = response.headers.get(header)
            if value:
                selected[header] = value
        return selected

    async def _request_json(self, method: str, path: str, json_body: Optional[dict] = None) -> dict:
        timeout = aiohttp.ClientTimeout(total=self.config.taiboli_request_timeout_seconds)
        async with aiohttp.ClientSession(timeout=timeout) as client:
            try:
                async with client.request(
                    method,
                    self._api_url(path),
                    headers=self._headers(),
                    json=json_body,
                ) as response:
                    text = await response.text()
                    response_headers = self._selected_response_headers(response)
                    if response.status < 200 or response.status >= 300:
                        message = text[:500] if text else f"Taiboli returned {response.status}"
                        self._log_api_failure(method, path, status=response.status, body=text, headers=response_headers)
                        raise TaiboliBridgeError(response.status, message)
                    if not text:
                        return {}
                    try:
                        return json.loads(text)
                    except json.JSONDecodeError as e:
                        self._log_api_failure(
                            method,
                            path,
                            status=response.status,
                            body=text,
                            headers=response_headers,
                            error=f"invalid_json: {e}",
                        )
                        raise TaiboliBridgeError(500, "Taiboli returned invalid JSON") from e
            except TaiboliBridgeError:
                raise
            except asyncio.TimeoutError as e:
                self._log_api_failure(method, path, error=f"timeout after {self.config.taiboli_request_timeout_seconds}s")
                raise TaiboliBridgeError(500, "Taiboli API request timed out") from e
            except aiohttp.ClientError as e:
                self._log_api_failure(method, path, error=f"{type(e).__name__}: {e}")
                raise TaiboliBridgeError(500, "Taiboli API request failed") from e

    async def fetch_instructions(self) -> dict:
        data = await self._request_json("GET", f"/avatar/sessions/{self.session_id}/instructions")
        instructions = (data.get("instructions") or "").strip()
        if not instructions:
            logger.error(
                "[Taiboli] API returned empty instructions: "
                f"session_id={self.session_id} "
                f"clerk_user_id={self._safe_clerk_user_id()} "
                f"request_id={self.request_id} "
                f"response={_truncate_for_log(json.dumps(data, sort_keys=True))!r}"
            )
            raise TaiboliBridgeError(500, "Taiboli returned empty avatar instructions")
        return data

    async def store_exchange(
        self,
        exchange_number: int,
        user_message: str,
        assistant_message: str,
        latency_ms: Optional[int],
        tool_calls: Optional[list] = None,
        tool_results: Optional[list] = None,
        token_usage: Optional[dict] = None,
    ) -> None:
        payload = {
            "exchangeNumber": exchange_number,
            "userMessage": user_message,
            "assistantMessage": assistant_message,
            "inputGuardrailTag": "ON_TOPIC",
            "outputGuardrailTag": "CLEAN",
            "metadata": {
                "provider": "azure_openai_realtime",
                "avatarModel": "musetalk",
                "avatarTurnId": f"{self.request_id}:{exchange_number}",
            },
        }
        if latency_ms is not None:
            payload["latencyMs"] = latency_ms
        if tool_calls:
            payload["toolCalls"] = tool_calls
        if tool_results:
            payload["toolResults"] = tool_results
        if token_usage:
            payload["tokenUsage"] = token_usage
        await self._request_json("POST", f"/avatar/sessions/{self.session_id}/exchanges", payload)

    async def end_session(self, reason: str, first_audio_latency_ms: Optional[int]) -> None:
        payload = {
            "reason": reason,
            "metadata": {"provider": "azure_openai_realtime", "avatarModel": "musetalk", "requestId": self.request_id},
        }
        if first_audio_latency_ms is not None:
            payload["firstAudioLatencyMs"] = first_audio_latency_ms
        await self._request_json("POST", f"/avatar/sessions/{self.session_id}/end", payload)

    async def flip_content(
        self,
        content_type: str,
        content_id: str,
        event_metadata: Optional[dict] = None,
    ) -> None:
        payload: dict = {
            "contentType": content_type,
            "contentId": content_id,
        }
        if event_metadata:
            payload["eventMetadata"] = event_metadata
        await self._request_json(
            "POST",
            f"/avatar/sessions/{self.session_id}/content-flip",
            payload,
        )

    async def patch_tool_result(
        self,
        exchange_number: int,
        name: str,
        call_id: str,
        result: dict,
    ) -> None:
        payload = {
            "toolResult": {
                "name": name,
                "callId": call_id,
                "result": result,
            }
        }
        await self._request_json(
            "PATCH",
            f"/avatar/sessions/{self.session_id}/exchanges/{exchange_number}/tool-results",
            payload,
        )


class MuseTalkAvatar:
    def __init__(
        self,
        avatar_id: str,
        video_path: str,
        config: ServerConfig,
        vae,
        # Quoted: annotations are evaluated when this class body runs, i.e. at
        # import, and FaceParsing is not bound until _import_musetalk().
        face_parser: "FaceParsing",
    ):
        self.avatar_id = avatar_id
        self.video_path = video_path
        self.config = config
        self.vae = vae
        self.face_parser = face_parser
        base_root = os.path.join(config.result_dir, config.version, "avatars")
        self.avatar_path = os.path.join(base_root, avatar_id)
        self.full_imgs_path = os.path.join(self.avatar_path, "full_imgs")
        self.coords_path = os.path.join(self.avatar_path, "coords.pkl")
        self.latents_out_path = os.path.join(self.avatar_path, "latents.pt")
        self.mask_out_path = os.path.join(self.avatar_path, "mask")
        self.mask_coords_path = os.path.join(self.avatar_path, "mask_coords.pkl")
        self.avatar_info_path = os.path.join(self.avatar_path, "avatar_info.json")
        # Derived render state (composited base frames, blend params, idle
        # frames). Rebuildable from the files above, cached because recomputing
        # it costs ~60 s of every startup.
        self.runtime_path = os.path.join(self.avatar_path, "runtime")
        self.cycle_length = 0
        self.frame_list_cycle: List[np.ndarray] = []
        self.coord_list_cycle: List[List[int]] = []
        self.input_latent_list_cycle: List[torch.Tensor] = []
        self.input_latent_tensor: Optional[torch.Tensor] = None
        self.mask_list_cycle: List[np.ndarray] = []
        self.mask_alpha_list_cycle: List[np.ndarray] = []
        self.mask_coords_list_cycle: List[List[int]] = []
        # Precomputed idle frames: each cyclic reference pose rendered through the
        # real UNet+VAE+blend pipeline with a neutral (silent) prompt, so idle
        # frames match the talking reconstruction style and the transition is seamless.
        self.idle_rendered_cycle: Optional[List[np.ndarray]] = None
        # The exact prompt idle_rendered_cycle was rendered with. Turn-boundary
        # ramps interpolate to/from it, so it has to be the searched prompt, not
        # a re-derived guess — cached alongside the frames for that reason.
        self.idle_prompt: Optional[torch.Tensor] = None

    def expected_info(self) -> dict:
        return {
            "avatar_id": self.avatar_id,
            "video_path": self.video_path,
            "bbox_shift": self.config.bbox_shift,
            "version": self.config.version,
            "extra_margin": self.config.extra_margin,
            "parsing_mode": self.config.parsing_mode,
            "left_cheek_width": self.config.left_cheek_width,
            "right_cheek_width": self.config.right_cheek_width,
        }

    # Bump when the derived-cache layout or the maths that fills it changes, so
    # stale caches are rebuilt instead of silently reused.
    RUNTIME_CACHE_VERSION = 1
    # Separate version for the idle frames only, so changing how the closed mouth
    # is chosen does not also throw away the multi-GB geometry cache (which is
    # unaffected and expensive to rebuild).
    IDLE_CACHE_VERSION = 5

    def _runtime_geometry_key(self) -> dict:
        """Identity of the derived geometry cache: everything that changes the
        composited base frames or the blend parameters."""
        key = dict(self.expected_info())
        key["output_size"] = int(getattr(self.config, "output_size", 0) or 0)
        key["runtime_cache_version"] = self.RUNTIME_CACHE_VERSION
        return key

    def _runtime_idle_key(self) -> dict:
        """Idle frames additionally depend on how the idle mouth is produced."""
        key = self._runtime_geometry_key()
        key["idle_mode"] = self.config.idle_mode
        key["idle_silence_noise"] = float(self.config.idle_silence_noise)
        key["idle_cache_version"] = self.IDLE_CACHE_VERSION
        return key

    def _read_runtime_meta(self) -> dict:
        try:
            with open(os.path.join(self.runtime_path, "meta.json"), "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}

    def runtime_geometry_cached(self) -> bool:
        meta = self._read_runtime_meta()
        if meta.get("geometry_key") != self._runtime_geometry_key():
            return False
        return all(
            os.path.isfile(os.path.join(self.runtime_path, name))
            for name in ("rgb_frames.npy", "alpha.npy")
        )

    def runtime_idle_cached(self) -> bool:
        meta = self._read_runtime_meta()
        return (
            meta.get("idle_key") == self._runtime_idle_key()
            and os.path.isfile(os.path.join(self.runtime_path, "idle_frames.npy"))
        )

    def load_or_prepare(self, recreate: bool = False) -> None:
        if recreate and os.path.exists(self.avatar_path):
            shutil.rmtree(self.avatar_path)

        if self._cache_exists():
            self._validate_cache()
            # Source PNGs are only needed when the derived cache can't be reused.
            self._load_cache(need_source_images=not self.runtime_geometry_cached())
            return

        self.prepare()
        self._load_cache(need_source_images=True)

    def _cache_exists(self) -> bool:
        return (
            os.path.exists(self.avatar_info_path)
            and os.path.exists(self.coords_path)
            and os.path.exists(self.latents_out_path)
            and os.path.exists(self.mask_coords_path)
            and os.path.isdir(self.full_imgs_path)
            and os.path.isdir(self.mask_out_path)
        )

    def _validate_cache(self) -> None:
        with open(self.avatar_info_path, "r", encoding="utf-8") as f:
            actual = json.load(f)
        expected = self.expected_info()
        mismatches = [
            key for key, value in expected.items()
            if str(actual.get(key)) != str(value)
        ]
        if mismatches:
            names = ", ".join(mismatches)
            raise RuntimeError(
                f"MuseTalk avatar cache mismatch for {self.avatar_id}: {names}. "
                "Run with --recreate_avatar to rebuild it."
            )

    def _load_cache(self, need_source_images: bool = True) -> None:
        """Load the on-disk avatar cache.

        Decoding full_imgs/ and mask/ is by far the slowest part of startup
        (~1440 1080p PNGs, ~38 s). When the derived runtime cache is usable we
        skip it entirely — nothing downstream needs the source frames, since
        prepare_runtime_tensors' outputs are what the render path actually reads.
        """
        logger.info(f"[MuseTalk] Loading avatar cache: {self.avatar_path}")
        with open(self.coords_path, "rb") as f:
            self.coord_list_cycle = pickle.load(f)
        with open(self.mask_coords_path, "rb") as f:
            self.mask_coords_list_cycle = pickle.load(f)
        self.input_latent_list_cycle = torch.load(self.latents_out_path, map_location="cpu")
        self.input_latent_tensor = None
        self.mask_alpha_list_cycle = []
        if need_source_images:
            img_list = _image_paths(self.full_imgs_path)
            mask_list = _image_paths(self.mask_out_path)
            self.frame_list_cycle = read_imgs(img_list)
            self.mask_list_cycle = read_imgs(mask_list)
            frame_count = len(self.frame_list_cycle)
            lengths = {
                frame_count,
                len(self.coord_list_cycle),
                len(self.input_latent_list_cycle),
                len(self.mask_list_cycle),
                len(self.mask_coords_list_cycle),
            }
        else:
            frame_count = len(self.coord_list_cycle)
            lengths = {
                frame_count,
                len(self.input_latent_list_cycle),
                len(self.mask_coords_list_cycle),
            }
        if len(lengths) != 1 or not frame_count:
            raise RuntimeError(f"Invalid MuseTalk avatar cache lengths: {lengths}")
        self.cycle_length = frame_count
        logger.info(f"[MuseTalk] Avatar {self.avatar_id} ready with {frame_count} cyclic frames")

    @torch.no_grad()
    def prepare(self) -> None:
        logger.info(f"[MuseTalk] Preparing avatar {self.avatar_id} from {self.video_path}")
        os.makedirs(self.full_imgs_path, exist_ok=True)
        os.makedirs(self.mask_out_path, exist_ok=True)

        if os.path.isfile(self.video_path):
            _video_to_imgs(self.video_path, self.full_imgs_path)
        elif os.path.isdir(self.video_path):
            for filename in _image_paths(self.video_path):
                shutil.copyfile(filename, os.path.join(self.full_imgs_path, os.path.basename(filename)))
        else:
            raise FileNotFoundError(f"Avatar video_path not found: {self.video_path}")

        input_img_list = _image_paths(self.full_imgs_path)
        if not input_img_list:
            raise RuntimeError(f"No avatar frames found in {self.full_imgs_path}")

        coord_list, frame_list = get_landmark_and_bbox(input_img_list, self.config.bbox_shift)
        coord_list = self._repair_and_expand_coords(coord_list, frame_list)

        input_latent_list = []
        for bbox, frame in tqdm(list(zip(coord_list, frame_list)), desc="encoding avatar latents"):
            x1, y1, x2, y2 = bbox
            crop_frame = frame[y1:y2, x1:x2]
            resized_crop = cv2.resize(crop_frame, (256, 256), interpolation=cv2.INTER_LANCZOS4)
            latent = self.vae.get_latents_for_unet(resized_crop).detach().cpu()
            input_latent_list.append(latent)

        frame_cycle = frame_list + frame_list[::-1]
        coord_cycle = coord_list + coord_list[::-1]
        latent_cycle = input_latent_list + input_latent_list[::-1]

        mask_coords_cycle = []
        mask_cycle = []
        for i, frame in enumerate(tqdm(frame_cycle, desc="preparing blend masks")):
            frame_path = os.path.join(self.full_imgs_path, f"{i:08d}.png")
            cv2.imwrite(frame_path, frame)
            mask, crop_box = get_image_prepare_material(
                frame,
                coord_cycle[i],
                fp=self.face_parser,
                mode=self.config.parsing_mode,
            )
            cv2.imwrite(os.path.join(self.mask_out_path, f"{i:08d}.png"), mask)
            mask_cycle.append(mask)
            mask_coords_cycle.append(crop_box)

        with open(self.avatar_info_path, "w", encoding="utf-8") as f:
            json.dump(self.expected_info(), f, indent=2)
        with open(self.coords_path, "wb") as f:
            pickle.dump(coord_cycle, f)
        with open(self.mask_coords_path, "wb") as f:
            pickle.dump(mask_coords_cycle, f)
        torch.save(latent_cycle, self.latents_out_path)
        logger.info(f"[MuseTalk] Avatar cache written to {self.avatar_path}")

    def _repair_and_expand_coords(self, coord_list, frame_list) -> List[List[int]]:
        repaired = []
        last_valid = None
        for bbox, frame in zip(coord_list, frame_list):
            if bbox == coord_placeholder:
                if last_valid is None:
                    raise RuntimeError("No face detected in the first avatar frame")
                bbox = last_valid
            x1, y1, x2, y2 = [int(v) for v in bbox]
            if self.config.version == "v15":
                y2 = min(y2 + self.config.extra_margin, frame.shape[0])
            if x2 <= x1 or y2 <= y1:
                if last_valid is None:
                    raise RuntimeError(f"Invalid face bbox: {bbox}")
                bbox = last_valid
            else:
                bbox = [x1, y1, x2, y2]
                last_valid = bbox
            repaired.append(list(bbox))
        return repaired

    def _save_runtime_geometry(self) -> None:
        """Persist the composited base frames + blend parameters.

        Base frames go to a single .npy so they can be memory-mapped back
        (file-backed pages are evictable, unlike 1440 heap arrays). Alpha and
        base_part are stored as uint8 so they can be mmap'd back directly on
        warm start — no per-frame recomputation needed.
        """
        try:
            os.makedirs(self.runtime_path, exist_ok=True)
            frames = np.ascontiguousarray(np.stack(self.rgb_frame_list_cycle, axis=0))
            np.save(os.path.join(self.runtime_path, "rgb_frames.npy"), frames)

            alphas, base_parts, geometry = [], [], []
            for params in self.blend_params_cycle:
                if not params["valid"]:
                    geometry.append({"valid": False})
                    continue
                a = params["alpha_inter"]
                alphas.append(np.ascontiguousarray(
                    np.rint(a[:, :, 0] * 255.0).clip(0, 255).astype(np.uint8)
                ).reshape(-1))
                bp = params["base_part_inter"]
                base_parts.append(
                    np.rint(bp).clip(0, 255).astype(np.uint8).reshape(-1)
                )
                geometry.append({
                    "valid": True,
                    "interp": int(params["interp"]),
                    "face_size": list(params["face_size"]),
                    "inter_coords": list(params["inter_coords"]),
                    "face_coords": list(params["face_coords"]),
                    "alpha_shape": list(a.shape[:2]),
                })
            np.save(
                os.path.join(self.runtime_path, "alpha.npy"),
                np.concatenate(alphas) if alphas else np.zeros(0, dtype=np.uint8),
            )
            np.save(
                os.path.join(self.runtime_path, "base_part.npy"),
                np.concatenate(base_parts) if base_parts else np.zeros(0, dtype=np.uint8),
            )
            meta = self._read_runtime_meta()
            meta["geometry_key"] = self._runtime_geometry_key()
            meta["geometry"] = geometry
            with open(os.path.join(self.runtime_path, "meta.json"), "w", encoding="utf-8") as f:
                json.dump(meta, f)
            logger.info(f"[MuseTalk] Runtime geometry cache written to {self.runtime_path}")
        except Exception as e:
            # Never fail startup over a cache write; we just pay the cost again.
            logger.warning(f"[MuseTalk] Could not write runtime geometry cache: {e}")

    def _load_runtime_geometry(self) -> bool:
        try:
            meta = self._read_runtime_meta()
            geometry = meta.get("geometry") or []
            frames = np.load(os.path.join(self.runtime_path, "rgb_frames.npy"), mmap_mode="r")
            alpha_flat = np.load(os.path.join(self.runtime_path, "alpha.npy"), mmap_mode="r")
            if len(geometry) != len(frames):
                raise RuntimeError(f"geometry/frame count mismatch: {len(geometry)} vs {len(frames)}")

            base_part_path = os.path.join(self.runtime_path, "base_part.npy")
            base_part_flat = np.load(base_part_path, mmap_mode="r") if os.path.exists(base_part_path) else None

            self.rgb_frame_list_cycle = [frames[i] for i in range(len(frames))]
            self.blend_params_cycle = []
            alpha_offset = 0
            bp_offset = 0
            for entry in geometry:
                if not entry.get("valid"):
                    self.blend_params_cycle.append({"valid": False})
                    continue
                ah, aw = entry["alpha_shape"]
                alpha_count = ah * aw
                alpha = (alpha_flat[alpha_offset:alpha_offset + alpha_count].reshape(ah, aw).astype(np.float32) / 255.0)[:, :, None]
                alpha_offset += alpha_count

                if base_part_flat is not None:
                    bp_count = ah * aw * 3
                    base_part = base_part_flat[bp_offset:bp_offset + bp_count].reshape(ah, aw, 3).astype(np.float32)
                    bp_offset += bp_count
                else:
                    iy1, iy2, ix1, ix2 = entry["inter_coords"]
                    base_inter = np.asarray(frames[len(self.blend_params_cycle)][iy1:iy2, ix1:ix2], dtype=np.float32)
                    base_part = np.ascontiguousarray((1.0 - alpha) * base_inter)

                self.blend_params_cycle.append({
                    "valid": True,
                    "interp": entry["interp"],
                    "face_size": tuple(entry["face_size"]),
                    "inter_coords": tuple(entry["inter_coords"]),
                    "face_coords": tuple(entry["face_coords"]),
                    "alpha_inter": np.ascontiguousarray(alpha),
                    "base_part_inter": np.ascontiguousarray(base_part),
                })
            self.cycle_length = len(self.rgb_frame_list_cycle)
            cache_mode = "direct" if base_part_flat is not None else "recomputed"
            logger.info(
                f"[MuseTalk] Reused runtime geometry cache ({self.cycle_length} frames, "
                f"base_part={cache_mode}) — skipped source-image decode"
            )
            return True
        except Exception as e:
            logger.warning(f"[MuseTalk] Runtime geometry cache unusable ({e}); rebuilding")
            self.rgb_frame_list_cycle = []
            self.blend_params_cycle = []
            return False

    def prepare_runtime_tensors(self, device: torch.device, dtype: torch.dtype) -> None:
        if not self.input_latent_list_cycle:
            self.input_latent_tensor = None
        else:
            self.input_latent_tensor = torch.cat(self.input_latent_list_cycle, dim=0).to(device=device, dtype=dtype)

        self.rgb_frame_list_cycle = []
        self.blend_params_cycle = []

        if self.runtime_geometry_cached() and self._load_runtime_geometry():
            if self.input_latent_tensor is not None:
                self.input_latent_list_cycle = []
            return

        if not self.frame_list_cycle:
            # Cache said it was usable, then failed to load; the source images
            # were skipped on that promise, so re-read them before rebuilding.
            # _load_cache clears input_latent_tensor, so rebuild it afterwards.
            self._load_cache(need_source_images=True)
            if self.input_latent_list_cycle:
                self.input_latent_tensor = torch.cat(
                    self.input_latent_list_cycle, dim=0
                ).to(device=device, dtype=dtype)

        # Optional: downscale the ENTIRE composite path to output_size so the per-frame
        # base-frame copy + alpha-blend (and the WebRTC encode) run at the smaller size.
        # The lipsync model is unaffected (it always works on the 256px face crop); we
        # just scale the base frames + bbox/mask coords proportionally before computing
        # blend params, so the proven CPU blend math runs unchanged at the smaller scale.
        out_size = int(getattr(self.config, "output_size", 0) or 0)

        for idx in range(len(self.frame_list_cycle)):
            ori_frame = self.frame_list_cycle[idx]
            rgb_frame = cv2.cvtColor(ori_frame, cv2.COLOR_BGR2RGB)

            bbox = self.coord_list_cycle[idx]
            x1, y1, x2, y2 = [int(v) for v in bbox]
            x_s, y_s, x_e, y_e = [int(v) for v in self.mask_coords_list_cycle[idx]]

            frame_h0, frame_w0 = rgb_frame.shape[:2]
            if out_size and max(frame_h0, frame_w0) != out_size:
                s = out_size / float(max(frame_h0, frame_w0))
                new_w, new_h = max(2, round(frame_w0 * s)), max(2, round(frame_h0 * s))
                rgb_frame = cv2.resize(rgb_frame, (new_w, new_h), interpolation=cv2.INTER_AREA)
                x1, y1, x2, y2 = round(x1 * s), round(y1 * s), round(x2 * s), round(y2 * s)
                x_s, y_s, x_e, y_e = round(x_s * s), round(y_s * s), round(x_e * s), round(y_e * s)

            self.rgb_frame_list_cycle.append(np.ascontiguousarray(rgb_frame))

            face_w = max(1, x2 - x1)
            face_h = max(1, y2 - y1)

            crop_w = max(1, x_e - x_s)
            crop_h = max(1, y_e - y_s)

            mask = self.mask_list_cycle[idx]
            if mask.ndim == 3:
                mask_gray = cv2.cvtColor(mask, cv2.COLOR_BGR2GRAY)
            else:
                mask_gray = mask
            if mask_gray.shape[:2] != (crop_h, crop_w):
                mask_gray = cv2.resize(mask_gray, (crop_w, crop_h), interpolation=cv2.INTER_LINEAR)
            alpha_full = (mask_gray.astype(np.float32) / 255.0)[:, :, None]

            frame_h, frame_w = rgb_frame.shape[:2]
            src_x1, src_y1 = max(0, x_s), max(0, y_s)
            src_x2, src_y2 = min(frame_w, x_e), min(frame_h, y_e)
            
            ix1, iy1 = max(x1, src_x1), max(y1, src_y1)
            ix2, iy2 = min(x1 + face_w, src_x2), min(y1 + face_h, src_y2)
            
            if ix2 > ix1 and iy2 > iy1:
                # Copy, don't slice: a view keeps the whole alpha_full crop alive
                # for the lifetime of the entry, so 1440 of them retain ~3x the
                # memory the intersections actually need.
                alpha_inter = np.ascontiguousarray(
                    alpha_full[iy1 - y_s : iy2 - y_s, ix1 - x_s : ix2 - x_s]
                )
                base_inter = rgb_frame[iy1:iy2, ix1:ix2].astype(np.float32)
                base_part_inter = (1.0 - alpha_inter) * base_inter
                
                # The model always emits a 256px face, so pasting it onto this
                # frame's bbox is a resample in one direction or the other.
                # INTER_LINEAR aliases when shrinking (the common case at
                # output_size=720, where the bbox is well under 256px) and is
                # soft when enlarging. Pick the right filter per pose once, here,
                # instead of branching in the per-frame path.
                shrinking = (face_w * face_h) < (256 * 256)
                self.blend_params_cycle.append({
                    "valid": True,
                    "interp": cv2.INTER_AREA if shrinking else cv2.INTER_CUBIC,
                    "face_size": (face_w, face_h),
                    "inter_coords": (iy1, iy2, ix1, ix2),
                    "face_coords": (iy1 - y1, iy2 - y1, ix1 - x1, ix2 - x1),
                    "alpha_inter": alpha_inter,
                    "base_part_inter": base_part_inter
                })
            else:
                self.blend_params_cycle.append({"valid": False})

        # Everything the runtime needs now lives in rgb_frame_list_cycle /
        # blend_params_cycle / input_latent_tensor. The source arrays below are
        # dead from here on and are the single largest block of resident memory:
        # frame_list_cycle holds every frame at SOURCE resolution (1440 x 1080p
        # BGR ~= 4.7 GB) and mask_list_cycle another ~1.3 GB. Dropping them here
        # cuts steady-state RSS by roughly 6 GB.
        self._save_runtime_geometry()

        self.frame_list_cycle = []
        self.mask_list_cycle = []
        if self.input_latent_tensor is not None:
            # The GPU tensor is the only latent source used at runtime; the CPU
            # list is a duplicate (see _unet_decode / _decode_ref_faces).
            self.input_latent_list_cycle = []

    def save_idle_cache(self, rendered: List[np.ndarray], prompt: Optional[torch.Tensor] = None) -> None:
        try:
            os.makedirs(self.runtime_path, exist_ok=True)
            np.save(
                os.path.join(self.runtime_path, "idle_frames.npy"),
                np.ascontiguousarray(np.stack(rendered, axis=0)),
            )
            if prompt is not None:
                np.save(os.path.join(self.runtime_path, "idle_prompt.npy"),
                        prompt.detach().cpu().float().numpy())
                self.idle_prompt = prompt.detach().cpu().float()
            meta = self._read_runtime_meta()
            meta["idle_key"] = self._runtime_idle_key()
            with open(os.path.join(self.runtime_path, "meta.json"), "w", encoding="utf-8") as f:
                json.dump(meta, f)
            logger.info(f"[MuseTalk] Idle cycle cached to {self.runtime_path}")
        except Exception as e:
            logger.warning(f"[MuseTalk] Could not write idle cache: {e}")

    def load_idle_cache(self) -> bool:
        try:
            frames = np.load(os.path.join(self.runtime_path, "idle_frames.npy"), mmap_mode="r")
            if len(frames) != len(self.rgb_frame_list_cycle):
                raise RuntimeError(
                    f"idle frame count {len(frames)} != cycle length {len(self.rgb_frame_list_cycle)}"
                )
            self.idle_rendered_cycle = [frames[i] for i in range(len(frames))]
            # Without this the cached path has no prompt to ramp from, and the
            # boundary would snap again on every restart.
            self.idle_prompt = torch.from_numpy(
                np.load(os.path.join(self.runtime_path, "idle_prompt.npy"))
            ).float()
            logger.info(
                f"[MuseTalk] Reused idle cache ({len(frames)} frames, memory-mapped) — "
                "skipped closed-mouth prompt search and idle render"
            )
            return True
        except Exception as e:
            logger.warning(f"[MuseTalk] Idle cache unusable ({e}); recomputing")
            self.idle_rendered_cycle = None
            self.idle_prompt = None
            return False

    def idle_frame_rgb(self, frame_index: int) -> np.ndarray:
        if self.idle_rendered_cycle is not None:
            return self.idle_rendered_cycle[frame_index % len(self.idle_rendered_cycle)]
        return self.rgb_frame_list_cycle[frame_index % len(self.rgb_frame_list_cycle)]

    def blend_frame_rgb(self, frame_index: int, res_frame_rgb: np.ndarray) -> np.ndarray:
        idx = frame_index % len(self.rgb_frame_list_cycle)
        rgb_frame = self.rgb_frame_list_cycle[idx]
        params = self.blend_params_cycle[idx]

        if not params["valid"]:
            return rgb_frame.copy()

        face_w, face_h = params["face_size"]
        try:
            face = cv2.resize(
                res_frame_rgb.astype(np.uint8, copy=False),
                (face_w, face_h),
                interpolation=params.get("interp", cv2.INTER_LINEAR),
            ).astype(np.float32)
        except Exception as e:
            logger.error(f"[MuseTalk] Frame resize failed for frame_index {frame_index}: {e}")
            return rgb_frame.copy()

        iy1, iy2, ix1, ix2 = params["inter_coords"]
        fy1, fy2, fx1, fx2 = params["face_coords"]
        alpha = params["alpha_inter"]
        base_part = params["base_part_inter"]

        face_inter = face[fy1:fy2, fx1:fx2]

        out = rgb_frame.copy()
        out[iy1:iy2, ix1:ix2] = np.clip((alpha * face_inter) + base_part, 0, 255).astype(np.uint8)
        return out


class MuseTalkEngine:
    def __init__(self, config: ServerConfig):
        # Deferred until now: importing the MuseTalk stack loads DWPose and
        # face_alignment onto the GPU as a side effect (AGENTS.md §11.6).
        _import_musetalk()
        self.config = config
        self.device = torch.device(f"cuda:{config.gpu_id}" if torch.cuda.is_available() else "cpu")
        self.weight_dtype = torch.float16 if self.device.type == "cuda" else torch.float32
        self.vae = None
        self.unet = None
        self.pe = None
        self.timesteps = None
        self.audio_processor = None
        self.whisper = None
        self.face_parser = None
        self.avatar: Optional[MuseTalkAvatar] = None
        # inference_lock serializes the UNet+VAE render path. whisper gets its OWN lock
        # and CUDA stream so the ~120ms-periodic feature encode overlaps with render
        # instead of stalling it (they were sharing one lock => periodic hitch).
        self.inference_lock = threading.Lock()
        self.whisper_lock = threading.Lock()
        self.whisper_stream = torch.cuda.Stream(device=self.device) if self.device.type == "cuda" else None
        # >0 => pad every render batch to this fixed size so torch.compile sees a single
        # static shape (no mid-session recompiles). Set in initialize() when compiling.
        self._fixed_batch = 0

    def initialize(self) -> None:
            logger.info(f"[MuseTalk] Loading models on {self.device}")
            enable_cuda_perf_flags()
            self.vae, self.unet, self.pe = load_all_model(
                unet_model_path=self.config.unet_model_path,
                vae_type=self.config.vae_type,
                unet_config=self.config.unet_config,
                device=self.device,
            )
            self.timesteps = torch.tensor([0], device=self.device)
            self.pe = self.pe.to(self.device)
            self.vae.vae = self.vae.vae.to(self.device)
            self.unet.model = self.unet.model.to(self.device)
            if self.weight_dtype == torch.float16:
                self.pe = self.pe.half()
                self.vae.vae = self.vae.vae.half()
                self.unet.model = self.unet.model.half()

            # Optional: tiny VAE decoder. Enabled before build_idle_cycle so idle frames
            # are decoded with the same decoder as talking frames (no idle<->talk pop).
            if self.config.vae_decoder == "taesd":
                try:
                    self.vae.enable_taesd()
                    logger.info("[MuseTalk] TAESD tiny VAE decoder enabled — VALIDATE face/teeth quality")
                except Exception as e:
                    logger.warning(f"[MuseTalk] TAESD load failed ({e}); using full sd-vae decoder")

            # Optional: torch.compile the UNet. Requires fixed-size batches (padded in
            # _unet_decode) so there is one compiled shape. The first inference (in
            # build_idle_cycle/warmup below) pays the one-time compile cost.
            if self.config.compile_models and self.device.type == "cuda":
                self._fixed_batch = max(1, self.config.musetalk_batch_size)
                try:
                    compile_start = time.perf_counter()
                    self.unet.model = torch.compile(self.unet.model, mode=self.config.compile_mode, dynamic=False)
                    logger.info(
                        f"[MuseTalk] torch.compile enabled for UNet "
                        f"(mode={self.config.compile_mode}, fixed batch={self._fixed_batch}, "
                        f"compile={time.perf_counter() - compile_start:.1f}s)"
                    )
                except Exception as e:
                    self._fixed_batch = 0
                    logger.warning(f"[MuseTalk] torch.compile failed ({e}); running eager")

            self.audio_processor = AudioProcessor(feature_extractor_path=self.config.whisper_dir)
            self.whisper = WhisperModel.from_pretrained(self.config.whisper_dir)
            self.whisper = self.whisper.to(device=self.device, dtype=self.weight_dtype).eval()
            self.whisper.requires_grad_(False)

            self.face_parser = FaceParsing(
                left_cheek_width=self.config.left_cheek_width,
                right_cheek_width=self.config.right_cheek_width,
            )

            avatar_id, video_path = self._resolve_avatar_selection()
            self.avatar = MuseTalkAvatar(avatar_id, video_path, self.config, self.vae, self.face_parser)
            self.avatar.load_or_prepare(recreate=self.config.recreate_avatar)
            self.avatar.prepare_runtime_tensors(self.device, self.unet.model.dtype)
            self.build_idle_cycle()
            if self.config.warmup_musetalk:
                self.warmup(self.config.warmup_seconds)
            logger.info("[MuseTalk] Initialization complete")

    def _resolve_avatar_selection(self) -> Tuple[str, str]:
        if self.config.video_path:
            return self.config.avatar_id or "prod_avatar", self.config.video_path
        inference_config = OmegaConf.load(self.config.avatar_config)
        if not inference_config:
            raise RuntimeError(f"Avatar config is empty: {self.config.avatar_config}")
        avatar_id = self.config.avatar_id or list(inference_config.keys())[0]
        if avatar_id not in inference_config:
            raise RuntimeError(f"avatar_id {avatar_id!r} not found in {self.config.avatar_config}")
        entry = inference_config[avatar_id]
        video_path = str(entry["video_path"])
        if self.config.version != "v15":
            self.config.bbox_shift = int(entry.get("bbox_shift", self.config.bbox_shift))
        return avatar_id, video_path

    def render_batch(
        self,
        prompts: List[torch.Tensor],
        frame_indices: List[int],
        metrics: Optional[MuseTalkRuntimeMetrics] = None,
        cycle_indices: Optional[List[int]] = None,
    ) -> List[np.ndarray]:
        if not prompts:
            return []
        assert self.avatar is not None
        # cycle_indices selects the reference pose (latent + blend base). When the
        # caller does not pass one, the audio-sync frame_indices double as the cycle
        # position (legacy behavior). Decoupling them lets the talking cycle continue
        # from the idle cycle so head pose never jumps at turn boundaries.
        cycle_indices = cycle_indices if cycle_indices is not None else frame_indices
        total_start = time.perf_counter()
        decoded_rgb = self._unet_decode(prompts, cycle_indices)

        frames = []
        blend_ms = 0.0
        for cycle_index, res_frame in zip(cycle_indices, decoded_rgb):
            blend_start = time.perf_counter()
            frames.append(self.avatar.blend_frame_rgb(cycle_index, res_frame))
            blend_ms += (time.perf_counter() - blend_start) * 1000.0
        if metrics:
            metrics.record_render((time.perf_counter() - total_start) * 1000.0, len(frames), blend_ms)
        return frames

    def _unet_decode(self, prompts: List[torch.Tensor], cycle_indices: List[int]) -> np.ndarray:
        """Run the audio-conditioned UNet + VAE decode for a batch. Returns the
        decoded faces (B, 256, 256, 3) uint8 RGB, before pasteback/blend."""
        assert self.avatar is not None
        n = len(prompts)
        with self.inference_lock, torch.inference_mode():
            whisper_batch = torch.stack([torch.as_tensor(prompt) for prompt in prompts])
            whisper_batch = whisper_batch.to(device=self.device, dtype=self.weight_dtype)
            if self.avatar.input_latent_tensor is not None:
                latent_indices = torch.as_tensor(
                    [i % self.avatar.input_latent_tensor.shape[0] for i in cycle_indices],
                    device=self.device,
                    dtype=torch.long,
                )
                latent_batch = self.avatar.input_latent_tensor.index_select(0, latent_indices)
            else:
                latent_batch = torch.cat(
                    [self.avatar.input_latent_list_cycle[i % len(self.avatar.input_latent_list_cycle)] for i in cycle_indices],
                    dim=0,
                ).to(device=self.device, dtype=self.unet.model.dtype)
            # When compiling, pad to a single fixed batch shape (repeat the last row) so
            # torch.compile/cudagraphs see one shape and never recompile mid-session.
            if self._fixed_batch and n < self._fixed_batch:
                pad = self._fixed_batch - n
                whisper_batch = torch.cat([whisper_batch, whisper_batch[-1:].repeat(pad, *([1] * (whisper_batch.dim() - 1)))], dim=0)
                latent_batch = torch.cat([latent_batch, latent_batch[-1:].repeat(pad, *([1] * (latent_batch.dim() - 1)))], dim=0)
            audio_feature_batch = self.pe(whisper_batch)
            pred_latents = self.unet.model(
                latent_batch,
                self.timesteps,
                encoder_hidden_states=audio_feature_batch,
            ).sample
            pred_latents = pred_latents.to(device=self.device, dtype=self.vae.vae.dtype)
            # Slice back to the real frames (drop padding) before the host copy.
            return self.vae.decode_latents_tensor(pred_latents)[:n].cpu().numpy()

    def idle_frame_rgb(self, frame_index: int) -> np.ndarray:
        assert self.avatar is not None
        return self.avatar.idle_frame_rgb(frame_index)

    def _synthetic_warmup_audio(self, duration_s: float) -> np.ndarray:
        duration_s = max(0.1, float(duration_s))
        sample_count = int(AUDIO_SAMPLE_RATE * duration_s)
        t = np.arange(sample_count, dtype=np.float32) / AUDIO_SAMPLE_RATE
        envelope = np.minimum(1.0, np.maximum(0.0, np.sin(np.pi * np.arange(sample_count, dtype=np.float32) / sample_count)))
        tone_a = np.sin(2.0 * np.pi * 180.0 * t)
        tone_b = 0.45 * np.sin(2.0 * np.pi * 310.0 * t)
        return (0.16 * envelope * (tone_a + tone_b) * 32767.0).astype(np.int16)

    def _extract_warmup_prompts(self, audio_16k: np.ndarray) -> Tuple[List[Tuple[int, torch.Tensor]], float]:
        extractor = StreamingMuseTalkFeatureExtractor(self, fps=self.config.fps)
        feature_start = time.perf_counter()
        prompts = extractor.process_chunk(audio_16k)
        prompts.extend(extractor.flush())
        return prompts, (time.perf_counter() - feature_start) * 1000.0

    def _silence_audio(self, noise_rms: float = 0.0, duration_s: float = 1.0) -> np.ndarray:
        """~1s of quiet int16 audio. noise_rms>0 injects a deterministic low-level
        noise floor; pure digital zeros are out-of-distribution for whisper and map
        to a parted mouth."""
        n = int(AUDIO_SAMPLE_RATE * duration_s)
        if noise_rms and noise_rms > 0.0:
            rng = np.random.default_rng(1234)
            audio = rng.standard_normal(n) * (noise_rms * 32768.0)
            return np.clip(audio, -32768, 32767).astype(np.int16)
        return np.zeros(n, dtype=np.int16)

    def _silence_prompt(self, noise_rms: float = 0.0) -> torch.Tensor:
        """Neutral audio prompt for the idle (silent) mouth.

        Runs ~1s of quiet audio through the real whisper path and picks an interior
        frame (the extractor only zero-pads the first/last frames of a turn). Falls
        back to the dry_run zeros shape if extraction yields nothing.
        """
        try:
            prompts, _ = self._extract_warmup_prompts(self._silence_audio(noise_rms))
            if prompts:
                return prompts[len(prompts) // 2][1].detach().clone()
        except Exception as e:
            logger.warning(f"[MuseTalk] Silence prompt extraction failed ({e}); using zeros")
        return torch.zeros((50, 384), dtype=torch.float32)

    def _decode_ref_faces(self, indices: List[int]) -> np.ndarray:
        """VAE-roundtrip of the ORIGINAL source faces for the given cycle indices.

        Currently unused — kept because the trap below is worth not relearning.
        Channels 4:8 of the input latent are the VAE encoding of the full unmasked
        face, so decoding them reproduces the source frame's face.

        NOTE: these are whatever the source video was doing at that moment. For a
        talking-head source that is usually a mouth mid-speech, NOT a closed
        mouth — do not use them as a closed-mouth target (that bug is what left
        idle permanently ajar). They are still a valid appearance reference for
        everything outside the mouth. Returns (B, 256, 256, 3) uint8 RGB."""
        assert self.avatar is not None
        with self.inference_lock, torch.inference_mode():
            if self.avatar.input_latent_tensor is not None:
                idx_t = torch.as_tensor(indices, device=self.device, dtype=torch.long)
                ref_latents = self.avatar.input_latent_tensor.index_select(0, idx_t)[:, 4:8]
            else:
                ref_latents = torch.cat(
                    [self.avatar.input_latent_list_cycle[i % len(self.avatar.input_latent_list_cycle)] for i in indices],
                    dim=0,
                )[:, 4:8].to(device=self.device, dtype=self.vae.vae.dtype)
            return self.vae.decode_latents_tensor(ref_latents).cpu().numpy()

    def build_idle_cycle(self) -> None:
        """Render every cyclic reference pose once, at startup, with a fixed neutral
        prompt (unet_closed: searched closed-mouth prompt; unet_silence: silent prompt).

        Idle output is deterministic (fixed cyclic latents + fixed prompt), so the N
        unique idle frames are precomputed and then cycled at ~zero runtime cost. Going
        through the same UNet render path makes idle match the talking reconstruction
        style and lip color exactly, so there is no pop when speech starts. Doubles as
        warmup.
        """
        assert self.avatar is not None
        n = len(self.avatar.rgb_frame_list_cycle)
        if n == 0:
            logger.warning("[MuseTalk] Idle cycle precompute skipped: no avatar frames")
            return

        # Idle output is fully determined by (avatar, geometry, idle settings), so
        # it is cacheable. This skips both the closed-mouth prompt search and the
        # full-cycle render — together ~35 s of every startup.
        if self.avatar.runtime_idle_cached() and self.avatar.load_idle_cache():
            return

        mode = self.config.idle_mode
        if mode == "unet_closed":
            unet_prompt = self._find_closed_prompt()
        else:  # unet_silence
            unet_prompt = self._silence_prompt(self.config.idle_silence_noise)
        batch_size = max(1, self.config.musetalk_batch_size)
        rendered: List[np.ndarray] = []
        start = time.perf_counter()
        for offset in range(0, n, batch_size):
            indices = list(range(offset, min(offset + batch_size, n)))
            rendered.extend(self.render_batch([unet_prompt] * len(indices), indices))
        self.avatar.idle_rendered_cycle = rendered
        self.avatar.idle_prompt = unet_prompt.detach().cpu().float()
        logger.info(
            f"[MuseTalk] Precomputed {len(rendered)} idle frames "
            f"(mode={mode}, noise={self.config.idle_silence_noise}) in "
            f"{time.perf_counter() - start:.1f}s"
        )
        self.avatar.save_idle_cache(rendered, unet_prompt)

    def _parse_face(self, face_rgb: np.ndarray) -> Optional[np.ndarray]:
        """Raw BiSeNet label map for a 256px face crop (CelebAMask-HQ classes).
        Returns None if parsing is unavailable, so callers can degrade instead of
        failing startup."""
        if self.face_parser is None:
            return None
        try:
            from PIL import Image
            image = Image.fromarray(np.ascontiguousarray(face_rgb.astype(np.uint8))).resize(
                (512, 512), Image.BILINEAR
            )
            tensor = torch.unsqueeze(self.face_parser.preprocess(image), 0)
            if self.device.type == "cuda":
                tensor = tensor.to(self.device)
            with torch.inference_mode():
                out = self.face_parser.net(tensor)[0]
            return out.squeeze(0).cpu().numpy().argmax(0)
        except Exception as e:
            logger.warning(f"[MuseTalk] Face parsing failed: {e}")
            return None

    def _mouth_seal(self, face_rgb: np.ndarray) -> Optional[Tuple[float, float, int, float]]:
        """Lip seal: (teeth_px, gap_px, lip_px, lip_saturation). Lower seal is better.

        The obvious measure — BiSeNet's inner-mouth class 11 as a fraction of the
        mouth — saturates: once the gap is a hairline the parser stops labelling
        it at all and every candidate reads 0.000, so "sealed" and "slightly
        ajar" become indistinguishable. That is how an idle mouth with a visible
        sliver of teeth scored a perfect zero.

        So measure the gap geometrically instead: the area enclosed by the lips
        but not lip itself (convex hull of the lip mask minus the mask), and how
        many of those pixels look like teeth (bright and desaturated). Both keep
        resolving well below the parser's labelling threshold.
        """
        parsing = self._parse_face(face_rgb)
        if parsing is None:
            return None
        parsing = cv2.resize(parsing.astype(np.uint8), (face_rgb.shape[1], face_rgb.shape[0]),
                             interpolation=cv2.INTER_NEAREST)
        lips = np.isin(parsing, (12, 13)).astype(np.uint8)
        inner = (parsing == 11).astype(np.uint8)
        lip_px = int(lips.sum())
        if lip_px < 50:
            return None
        contours, _ = cv2.findContours(lips | inner, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not contours:
            return None
        hull = np.zeros_like(lips)
        cv2.drawContours(hull, [cv2.convexHull(np.vstack(contours))], -1, 1, -1)
        gap = (hull > 0) & (lips == 0)
        hsv = cv2.cvtColor(face_rgb.astype(np.uint8), cv2.COLOR_RGB2HSV)
        teeth = gap & (hsv[:, :, 1] < 70) & (hsv[:, :, 2] > 130)
        # Lip colour, measured on the candidate itself. Pushing the prompt far
        # out of distribution washes the lips out, and that has to be caught
        # WITHOUT comparing to the source (see the guard note in the search).
        lip_saturation = float(hsv[:, :, 1][lips > 0].mean())
        return float(teeth.sum()), float(gap.sum()), lip_px, lip_saturation

    def _closed_prompt_candidates(self) -> List[Tuple[str, torch.Tensor]]:
        """Audio prompts that might drive a shut mouth.

        Digital silence is the obvious candidate but is not always the best one:
        it is out-of-distribution for whisper, and on some avatars it produces a
        slightly parted "whistle" mouth. So we also sample real speech — the
        quietest frames, which is where inter-word gaps and bilabial closures
        (/m/, /b/, /p/) live — and let the measurement decide.
        """
        candidates: List[Tuple[str, torch.Tensor]] = []
        for noise in (0.0, 0.001, 0.003, 0.01, 0.03):
            try:
                candidates.append((f"silence:{noise:g}", self._silence_prompt(noise)))
            except Exception as e:
                logger.warning(f"[MuseTalk] Silence candidate {noise} failed: {e}")

        try:
            synth, _ = self._extract_warmup_prompts(self._synthetic_warmup_audio(2.0))
            step = max(1, len(synth) // 6)
            candidates.extend((f"synth:{k}", synth[k][1]) for k in range(0, len(synth), step))
        except Exception as e:
            logger.warning(f"[MuseTalk] Synthetic candidates failed: {e}")

        # Extrapolate PAST silence, away from a wide-open mouth. Prompt space is
        # smooth and monotonic here, so w>1 presses the lips together further
        # than silence alone — which matters when the source video never shows a
        # closed mouth and the model has no truly-sealed appearance to copy.
        # Bounded, because far extrapolation goes out of distribution and washes
        # the lips out; the lip-colour guard in the search rejects any that do.
        try:
            base = self._silence_prompt(0.0).float()
            loudest = max(
                self._extract_warmup_prompts(self._synthetic_warmup_audio(2.0))[0],
                key=lambda item: float(item[1].abs().mean()),
            )[1].float()
            for weight in (1.25, 1.5, 1.75, 2.0):
                candidates.append((f"sealed:{weight:g}", torch.lerp(loudest, base, weight)))
        except Exception as e:
            logger.warning(f"[MuseTalk] Sealed-lip candidates failed: {e}")

        for wav_path in sorted(glob.glob(os.path.join(ROOT_DIR, "data", "audio", "*.wav")))[:2]:
            try:
                import librosa
                audio, _ = librosa.load(wav_path, sr=AUDIO_SAMPLE_RATE)
                audio = (np.clip(audio, -1.0, 1.0) * 32767).astype(np.int16)[: AUDIO_SAMPLE_RATE * 12]
                prompts, _ = self._extract_warmup_prompts(audio)
                if not prompts:
                    continue
                samples_per_frame = max(1, AUDIO_SAMPLE_RATE // self.config.fps)
                energies = []
                for position, (frame_index, _) in enumerate(prompts):
                    window = audio[frame_index * samples_per_frame:(frame_index + 1) * samples_per_frame]
                    rms = float(np.sqrt(np.mean(window.astype(np.float32) ** 2) + 1e-9)) if window.size else 0.0
                    energies.append((rms, position))
                energies.sort()
                tag = os.path.splitext(os.path.basename(wav_path))[0][:6]
                for _, position in energies[:6]:
                    candidates.append((f"{tag}:{prompts[position][0]}", prompts[position][1]))
            except Exception as e:
                logger.warning(f"[MuseTalk] Speech candidates from {os.path.basename(wav_path)} failed: {e}")
        return candidates

    def _find_closed_prompt(self) -> torch.Tensor:
        """Pick the audio prompt whose RENDERED mouth is actually shut.

        The previous implementation scored candidates by L1 against the avatar's
        own source frames, assuming those show a closed mouth. For a talking-head
        source they do not: measured on this avatar, every sampled source frame
        had an open mouth (inner-mouth ratio 0.25-0.33, not one below 0.02). So
        the search was fitting a *talking* mouth, and it duly picked the most open
        candidate in the library — which is why idle sat permanently ajar.

        Instead, measure the generated mouth directly with the face parser that is
        already loaded, and minimise how far the lips are apart. Two REFERENCE-FREE
        guards stop a candidate winning degenerately: the lips must survive (a
        smeared mouth with no lip pixels is not a closed mouth) and must stay
        lip-coloured (pushing the prompt too far washes them out). Both are
        measured on the candidate itself — see the note on the guards for why
        comparing against the avatar's own frames backfires here.
        """
        assert self.avatar is not None
        n = len(self.avatar.rgb_frame_list_cycle)
        poses = sorted({int(n * f) for f in (0.0, 0.17, 0.33, 0.5)})
        candidates = self._closed_prompt_candidates()
        if not candidates:
            logger.warning("[MuseTalk] No closed-mouth candidates; falling back to silence")
            return self._silence_prompt(self.config.idle_silence_noise)

        scored = []
        for name, prompt in candidates:
            faces = self._unet_decode([prompt] * len(poses), poses).astype(np.float32)
            teeth_values, gap_values, lip_counts, saturations = [], [], [], []
            for face in faces:
                measured = self._mouth_seal(face)
                if measured is not None:
                    teeth_values.append(measured[0])
                    gap_values.append(measured[1])
                    lip_counts.append(measured[2])
                    saturations.append(measured[3])
            if not teeth_values:
                continue
            scored.append({
                "name": name,
                "prompt": prompt,
                "teeth": float(np.mean(teeth_values)),
                "gap": float(np.mean(gap_values)),
                "lips": float(np.mean(lip_counts)),
                "saturation": float(np.mean(saturations)),
            })

        if not scored:
            # Parsing unavailable — keep the avatar working rather than fail boot.
            logger.warning("[MuseTalk] Mouth measurement unavailable; using silence prompt")
            return self._silence_prompt(self.config.idle_silence_noise)

        median_lips = float(np.median([s["lips"] for s in scored])) or 1.0
        median_saturation = float(np.median([s["saturation"] for s in scored])) or 1.0
        # NOTE: do NOT reintroduce an L1-to-source term here. The only reference
        # available is the avatar's own frames, whose mouths are open, and an
        # open mouth also changes the jaw and chin OUTSIDE any mouth mask — so
        # that term rewards open mouths and rejects exactly the sealed ones we
        # are looking for. Measured: the worst-sealed candidate scored the best
        # on it. Guards here are reference-free: the lips must still be there and
        # still be lip-coloured.
        healthy = [
            s for s in scored
            if s["lips"] >= 0.5 * median_lips and s["saturation"] >= 0.6 * median_saturation
        ]
        if not healthy:
            healthy = scored

        winner = min(healthy, key=lambda s: (s["teeth"], s["gap"]))

        runners = [s for s in sorted(healthy, key=lambda s: (s["teeth"], s["gap"]))[:4]
                   if s["name"] != winner["name"]][:3]
        runner_text = ", ".join(
            "{0}(teeth={1:.0f},gap={2:.0f})".format(s["name"], s["teeth"], s["gap"]) for s in runners
        )
        logger.info(
            f"[MuseTalk] Closed-mouth prompt selected: {winner['name']} "
            f"(teeth={winner['teeth']:.0f}px, gap={winner['gap']:.0f}px, "
            f"lips={winner['lips']:.0f}px, lip_sat={winner['saturation']:.0f}) "
            f"from {len(scored)} candidates; next best: {runner_text}"
        )
        if winner["teeth"] > 20:
            logger.warning(
                f"[MuseTalk] Best idle mouth still shows teeth ({winner['teeth']:.0f}px). "
                "The avatar may look like it is holding its mouth open while listening."
            )
        return winner["prompt"]

    def warmup(self, duration_s: float) -> None:
        """Lock in tuned kernels + allocator state so the first turn has no cold-start
        spikes. With cudnn.benchmark on, cuDNN autotunes per input shape; the render
        worker emits ANY batch size 1..musetalk_batch_size, and whisper sees a range of
        growing input lengths every feature_step_ms — so we warm all of those here.

        NOTE: warmup only removes cold-start spikes. Sustained mid-turn stutter is a
        throughput/contention problem (see the streaming/contention fixes), not
        something warmup can fix.
        """
        duration_s = max(0.1, float(duration_s))
        logger.info(f"[MuseTalk] Warming realtime path with {duration_s:.1f}s synthetic speech")
        metrics = MuseTalkRuntimeMetrics(self.config.musetalk_profile, self.config.musetalk_metrics_interval_ms)

        # Warm whisper through the real streaming path: feed audio in feature_step_ms
        # increments so the encoder sees the growing input lengths it will see live.
        audio = self._synthetic_warmup_audio(duration_s)
        extractor = StreamingMuseTalkFeatureExtractor(self, fps=self.config.fps)
        step_samples = max(1, int(AUDIO_SAMPLE_RATE * self.config.feature_step_ms / 1000.0))
        prompts: List[Tuple[int, torch.Tensor]] = []
        feature_start = time.perf_counter()
        for off in range(0, len(audio), step_samples):
            prompts.extend(extractor.process_chunk(audio[off:off + step_samples]))
        prompts.extend(extractor.flush())
        metrics.record_feature((time.perf_counter() - feature_start) * 1000.0, len(prompts))

        if not prompts:
            logger.warning("[MuseTalk] Warmup skipped: no prompts generated")
            return

        # Lock a cuDNN plan + allocator blocks for EVERY batch size 1..N.
        # First call per shape pays cuDNN autotuning (~100-450ms); second call
        # settles the allocator. A third adds <30ms and no functional benefit.
        batch_size = max(1, self.config.musetalk_batch_size)
        prompt_pool = [p for _, p in prompts]
        render_start = time.perf_counter()
        rendered = 0
        for size in range(1, batch_size + 1):
            batch = [prompt_pool[i % len(prompt_pool)] for i in range(size)]
            indices = list(range(size))
            for _ in range(2):
                rendered += len(self.render_batch(batch, indices, metrics=metrics))

        if self.device.type == "cuda":
            torch.cuda.synchronize(self.device)

        render_s = max(1e-6, time.perf_counter() - render_start)
        logger.info(
            f"[MuseTalk] Warmup complete: batch sizes 1..{batch_size} x2, "
            f"{rendered} frames, render_fps={rendered / render_s:.1f}"
        )
        metrics.maybe_log(force=True)

    def warm_render_thread(self, batches: int = 1, on_ready=None) -> None:
        """Pay this THREAD's CUDA init cost up front.

        PyTorch keeps cuDNN/cuBLAS handles per thread, so a freshly spawned
        worker pays them on its first inference no matter how thoroughly the
        process was warmed at startup — measured ~700 ms for the first batch vs
        ~55 ms steady (12.9x), i.e. ~22 dropped video frames.

        Every session spawns its own render worker, so without this the cost
        lands on the first thing the user hears the avatar say. Called at the top
        of the worker loop, which starts during WebRTC negotiation while the
        avatar is still idling (idle frames don't touch this thread), so the
        stall happens where nobody can see it.
        """
        if self.device.type != "cuda" or self.avatar is None:
            return
        try:
            started = time.perf_counter()
            prompt = torch.zeros((50, 384), dtype=torch.float32)
            n = max(1, self.config.musetalk_batch_size)
            # EVERY shape, not just the extremes. cudnn.benchmark autotunes per
            # input shape and the cache is per-thread, so any size this worker
            # emits for the first time mid-session pays ~700 ms of autotuning —
            # which lands on the user as a frozen mouth. The mouth ramps render
            # their own size, so include that too.
            ramp = max(0, self.config.mouth_ramp_frames)
            # 1..n are the plain batches and the closing ramp renders `ramp`
            # alone, but the OPENING ramp rides the first batch of a turn and
            # that batch carries however many prompts were queued at that
            # instant — so every ramp+1 .. ramp+n occurs, not just ramp+n.
            # Warming only the extremes left 5 and 6 cold and they land on the
            # FIRST batch of a live turn: measured here, batch 5 cost 741 ms on
            # its first call against 76 ms steady (~17 frozen frames) exactly as
            # the avatar starts talking. Cover the contiguous range.
            sizes = set(range(1, n + ramp + 1))
            # The shapes a turn actually opens with. Signal readiness after these
            # so the greeting isn't held behind the rarer partial-batch sizes —
            # each shape costs ~0.7 s to autotune, and the greeting waits on this.
            priority = [size for size in (n + ramp if ramp else n, n) if size in sizes]
            rest = sorted(sizes.difference(priority), reverse=True)
            for _ in range(max(1, batches)):
                for size in priority:
                    self.render_batch([prompt] * size, list(range(size)))
            torch.cuda.synchronize(self.device)
            logger.info(
                f"[MuseTalk] Render thread ready in {(time.perf_counter() - started) * 1000:.0f} ms "
                f"(shapes {priority}); warming {rest} in the background"
            )
            if on_ready is not None:
                on_ready()
            for _ in range(max(1, batches)):
                for size in rest:
                    self.render_batch([prompt] * size, list(range(size)))
            torch.cuda.synchronize(self.device)
            logger.info(f"[MuseTalk] Render thread fully warmed in {(time.perf_counter() - started) * 1000:.0f} ms")
        except Exception as e:
            logger.warning(f"[MuseTalk] Render thread warmup failed: {e}")

    def warm_feature_thread(self) -> None:
        """Same per-thread cost, for the whisper encoder on the feature worker.
        Uses a throwaway extractor so no session state is touched."""
        if self.device.type != "cuda":
            return
        try:
            started = time.perf_counter()
            extractor = StreamingMuseTalkFeatureExtractor(self, fps=self.config.fps)
            extractor.process_chunk(self._synthetic_warmup_audio(0.6))
            extractor.flush()
            torch.cuda.synchronize(self.device)
            logger.info(f"[MuseTalk] Feature thread warmed in {(time.perf_counter() - started) * 1000:.0f} ms")
        except Exception as e:
            logger.warning(f"[MuseTalk] Feature thread warmup failed: {e}")

    def dry_run(self) -> None:
        logger.info("[MuseTalk] Running dry-run render")
        silent_prompt = torch.zeros((50, 384), dtype=torch.float32)
        frame = self.render_batch([silent_prompt], [0])[0]
        logger.info(f"[MuseTalk] Dry-run frame shape: {frame.shape}, dtype={frame.dtype}")

        metrics = MuseTalkRuntimeMetrics(True, self.config.musetalk_metrics_interval_ms)
        duration_s = 3.0
        prompts, feature_ms = self._extract_warmup_prompts(self._synthetic_warmup_audio(duration_s))
        metrics.record_feature(feature_ms, len(prompts))
        render_start = time.perf_counter()
        rendered = 0
        batch_size = max(1, self.config.musetalk_batch_size)
        for offset in range(0, len(prompts), batch_size):
            batch = prompts[offset:offset + batch_size]
            frame_indices = [item[0] for item in batch]
            prompt_batch = [item[1] for item in batch]
            rendered += len(self.render_batch(prompt_batch, frame_indices, metrics=metrics))
        render_s = max(1e-6, time.perf_counter() - render_start)
        logger.info(
            f"[MuseTalk] Dry-run benchmark: {duration_s:.1f}s audio, "
            f"{len(prompts)} prompts, {rendered} frames, render_fps={rendered / render_s:.1f}"
        )
        metrics.maybe_log(force=True)


class _BlankAvatarStub:
    """Stands in for MuseTalkAvatar in blank-avatar mode.

    Only the three attributes read from outside MuseTalkAvatar are provided:
    `avatar_id` and `video_path` for /health, the data-channel `status` message
    and the canvas background lookup (empty path => plain black bars), and
    `idle_prompt = None`, which keeps _request_closing_ramp on its existing
    early-return path so no mouth ramp is ever requested.
    """

    avatar_id = "blank"
    video_path = ""
    idle_prompt = None


class BlankAvatarEngine:
    """Drop-in replacement for MuseTalkEngine that renders nothing.

    Serves one black frame at exactly the geometry a real avatar run would
    deliver, so the browser, the SDP negotiation and every downstream consumer
    of the video track see the same resolution and frame rate as production —
    only the pixels are black. Nothing here touches a model, a weight file or
    the GPU, which is the whole point: the CPU-only dev deployment exists so
    developers can exercise the Azure Realtime loop, tool calling and the
    Taiboli bridge without an expensive GPU box.

    Only three members are actually reached in blank mode: `avatar`,
    `idle_frame_rgb` and `initialize`. `render_batch`, `warm_render_thread` and
    `warm_feature_thread` are unreachable — their only callers are the render
    and feature worker loops, and AvatarSession starts neither — and exist as
    safe no-ops so the stub stays a true drop-in rather than something every
    caller has to special-case.
    """

    def __init__(self, config: ServerConfig):
        self.config = config
        self.avatar = _BlankAvatarStub()
        self.inference_lock = threading.Lock()
        self.whisper_lock = threading.Lock()
        self.whisper_stream = None
        self.device = torch.device("cpu")
        self.weight_dtype = torch.float32
        self.vae = None
        self.unet = None
        self.pe = None
        self.audio_processor = None
        self.whisper = None
        self.face_parser = None
        # A real run composites the avatar square at output_size and pastes it
        # into the canvas (AGENTS.md §5), so a square frame of that size gives
        # AvatarVideoTrack._init_canvas identical inputs. output_size=0 means
        # "native source resolution", which has no meaning without a source
        # video — fall back to the canvas height, which is what preserves the
        # avatar_width == canvas_height invariant square crops depend on.
        size = int(getattr(config, "output_size", 0) or 0)
        if size <= 0:
            size = int(getattr(config, "canvas_height", 0) or 0) or 720
        size = max(2, size - (size % 2))  # yuv420p needs even dimensions
        self.frame_size = size
        self._black_frame = np.zeros((size, size, 3), dtype=np.uint8)

    def initialize(self) -> None:
        logger.warning(
            f"[MuseTalk] BLANK AVATAR MODE — no models, no GPU. Serving a black "
            f"{self.frame_size}x{self.frame_size} frame on a "
            f"{self.config.canvas_width}x{self.config.canvas_height} canvas. "
            "This is a dev deployment; do not point real learners at it."
        )
        if torch.cuda.is_available():
            logger.warning(
                "[MuseTalk] ***** A GPU IS PRESENT AND THE AVATAR IS DISABLED ANYWAY. *****\n"
                "  If this host serves real learners, blank mode is a misconfiguration: "
                "unset AVATAR_BLANK_MODE or pass --no-blank_avatar."
            )

    def idle_frame_rgb(self, frame_index: int) -> np.ndarray:
        return self._black_frame

    def render_batch(self, prompts, frame_indices, metrics=None, cycle_indices=None) -> List[np.ndarray]:
        return []

    def warm_render_thread(self, batches: int = 1, on_ready=None) -> None:
        # Nothing to autotune, but the greeting waits on this signal.
        if on_ready is not None:
            on_ready()

    def warm_feature_thread(self) -> None:
        return


class StreamingMuseTalkFeatureExtractor:
    def __init__(self, engine: MuseTalkEngine, fps: int, left: int = 2, right: int = 2):
        self.engine = engine
        self.fps = int(fps)
        self.left = int(left)
        self.right = int(right)
        self.audio_bytes = bytearray()
        self.next_frame_index = 0

    def reset(self) -> None:
        self.audio_bytes = bytearray()
        self.next_frame_index = 0

    def process_chunk(self, audio_16k: np.ndarray) -> List[Tuple[int, torch.Tensor]]:
        if audio_16k.size:
            audio = np.ascontiguousarray(audio_16k.astype(np.int16, copy=False))
            self.audio_bytes.extend(audio.tobytes())
        return self._extract_ready(force=False)

    def flush(self) -> List[Tuple[int, torch.Tensor]]:
        return self._extract_ready(force=True)

    def _extract_ready(self, force: bool) -> List[Tuple[int, torch.Tensor]]:
        sample_count = len(self.audio_bytes) // 2
        if sample_count == 0:
            return []
        right_context_samples = int(((self.right + 1) * 2 / 50.0) * AUDIO_SAMPLE_RATE)
        usable_samples = sample_count if force else max(0, sample_count - right_context_samples)
        ready_frames = int(math.floor((usable_samples / AUDIO_SAMPLE_RATE) * self.fps))
        if ready_frames <= self.next_frame_index:
            return []

        whisper_feature = self._encode_audio_features(sample_count)
        if whisper_feature is None:
            return []

        audio_feature_length = 2 * (self.left + self.right + 1)
        whisper_idx_multiplier = 50.0 / self.fps
        prompts = []
        for frame_index in range(self.next_frame_index, ready_frames):
            audio_index = int(math.floor(frame_index * whisper_idx_multiplier))
            audio_clip = whisper_feature[:, audio_index:audio_index + audio_feature_length]
            if audio_clip.shape[1] != audio_feature_length:
                break
            prompt = torch.reshape(audio_clip, (audio_clip.shape[0], audio_clip.shape[1] * audio_clip.shape[2], audio_clip.shape[3]))
            prompts.append((frame_index, prompt.squeeze(0).detach().cpu()))
            self.next_frame_index = frame_index + 1
        return prompts

    def _encode_audio_features(self, sample_count: int) -> Optional[torch.Tensor]:
        engine = self.engine
        audio_samples = np.frombuffer(self.audio_bytes, dtype=np.int16, count=sample_count)
        audio_float = audio_samples.astype(np.float32) / 32768.0
        segment_len = 30 * AUDIO_SAMPLE_RATE
        segments = [
            audio_float[i:i + segment_len]
            for i in range(0, len(audio_float), segment_len)
        ]
        input_features = []
        for segment in segments:
            input_features.append(engine.audio_processor.feature_extractor(
                segment,
                return_tensors="pt",
                sampling_rate=AUDIO_SAMPLE_RATE,
            ).input_features)
        features = []
        # whisper runs under its own lock + CUDA stream (not the render inference_lock),
        # so it overlaps with UNet/VAE instead of stalling the render worker.
        stream_ctx = torch.cuda.stream(engine.whisper_stream) if engine.whisper_stream is not None else contextlib.nullcontext()
        with engine.whisper_lock, torch.inference_mode(), stream_ctx:
            for input_feature in input_features:
                input_feature = input_feature.to(engine.device, dtype=engine.weight_dtype)
                hidden_states = engine.whisper.encoder(input_feature, output_hidden_states=True).hidden_states
                audio_feats = torch.stack(hidden_states, dim=2)
                features.append(audio_feats)
        # Ensure the encoder is complete before any default-stream op (cat/slice below)
        # or the CPU copy in the caller reads the features (cross-stream safety).
        if engine.whisper_stream is not None:
            engine.whisper_stream.synchronize()
        if not features:
            return None
        whisper_feature = torch.cat(features, dim=1)
        actual_length = int(math.floor((sample_count / AUDIO_SAMPLE_RATE) * 50))
        whisper_feature = whisper_feature[:, :actual_length, ...]
        if whisper_feature.shape[1] == 0:
            return None
        padding_nums = int(math.ceil(50.0 / self.fps))
        left_pad = torch.zeros_like(whisper_feature[:, :padding_nums * self.left])
        right_pad = torch.zeros_like(whisper_feature[:, :padding_nums * 3 * self.right])
        return torch.cat([left_pad, whisper_feature, right_pad], dim=1)


class AvatarAudioTrack(MediaStreamTrack):
    kind = "audio"

    def __init__(self, session: "AvatarSession"):
        super().__init__()
        self.session = session
        # Playback rate is independent of the 16 kHz lip-sync rate. Everything
        # below derives from it, and _current_audio_target_frame converts the
        # consumed-sample count into video frames using the SAME rate — they must
        # not drift apart or audio and mouth desync.
        self.sample_rate = int(session.config.playback_sample_rate)
        self.samples_per_frame = int(self.sample_rate * AUDIO_PTIME)
        self.prebuffer_samples = int(self.sample_rate * session.config.av_sync_prebuffer_ms / 1000)
        self._start_time = None
        self._frame_count = 0
        self._audio_chunks = deque()
        self._chunk_offset = 0
        self._buffered_samples = 0
        self._real_audio_samples_consumed = 0
        self._playback_started = False
        self._force_playback = False
        self._buffer_lock = threading.Lock()
        self._silence_bytes = bytes(self.samples_per_frame * 2)
        logger.info(
            f"[AudioTrack] {self.sample_rate}Hz, {self.samples_per_frame} samples/frame, "
            f"prebuffer={self.prebuffer_samples} samples"
        )

    def begin_turn(self):
        with self._buffer_lock:
            self._audio_chunks.clear()
            self._chunk_offset = 0
            self._buffered_samples = 0
            self._real_audio_samples_consumed = 0
            self._playback_started = False
            self._force_playback = False

    def queue_audio(self, audio_bytes: bytes):
        samples = np.frombuffer(audio_bytes, dtype=np.int16)
        if samples.size == 0:
            return
        with self._buffer_lock:
            self._audio_chunks.append(samples)
            self._buffered_samples += int(samples.size)

    def force_playback(self):
        with self._buffer_lock:
            self._force_playback = True

    def clear_audio(self):
        with self._buffer_lock:
            self._audio_chunks.clear()
            self._chunk_offset = 0
            self._buffered_samples = 0
            self._real_audio_samples_consumed = 0
            self._playback_started = False
            self._force_playback = False

    def buffered_samples(self) -> int:
        with self._buffer_lock:
            return self._buffered_samples

    def get_real_audio_consumed(self) -> int:
        with self._buffer_lock:
            return self._real_audio_samples_consumed

    def _get_sample_bytes(self, count: int) -> bytes:
        with self._buffer_lock:
            if not self._playback_started:
                if self._buffered_samples >= self.prebuffer_samples or self._force_playback:
                    self._playback_started = True
                else:
                    return self._silence_bytes

            if self._buffered_samples <= 0:
                return self._silence_bytes

            output = np.empty(count, dtype=np.int16) if self._buffered_samples >= count else np.zeros(count, dtype=np.int16)
            written = 0
            consumed = 0
            while written < count and self._audio_chunks:
                chunk = self._audio_chunks[0]
                available = len(chunk) - self._chunk_offset
                take = min(count - written, available)
                output[written:written + take] = chunk[self._chunk_offset:self._chunk_offset + take]
                written += take
                consumed += take
                self._chunk_offset += take
                self._buffered_samples -= take
                if self._chunk_offset >= len(chunk):
                    self._audio_chunks.popleft()
                    self._chunk_offset = 0
            self._real_audio_samples_consumed += consumed
            return output.tobytes()

    async def recv(self) -> AudioFrame:
        if self._start_time is None:
            self._start_time = time.monotonic()
        sample_bytes = self._get_sample_bytes(self.samples_per_frame)
        frame = AudioFrame(format="s16", layout="mono", samples=self.samples_per_frame)
        frame.sample_rate = self.sample_rate
        frame.pts = self._frame_count * self.samples_per_frame
        frame.time_base = fractions.Fraction(1, self.sample_rate)
        frame.planes[0].update(sample_bytes)
        self._frame_count += 1
        target_time = self._start_time + (self._frame_count * AUDIO_PTIME)
        delay = target_time - time.monotonic()
        if delay > 0:
            await asyncio.sleep(delay)
        return frame


def resolve_canvas_background_path(config: ServerConfig, video_path: str) -> str:
    """Path of the still image to sit behind the avatar, or "" for black bars.

    Backgrounds are per-avatar and discovered by name: an avatar sourced from
    data/video/priya.mp4 uses data/background/priya.png. Nothing to configure —
    add the PNG to get a background, remove it to go back to black bars.
    An explicit --canvas_background still overrides, and relative paths resolve
    against the repo root rather than the CWD.
    """
    configured = (getattr(config, "canvas_background", "") or "").strip()
    if configured:
        return configured if os.path.isabs(configured) else os.path.join(ROOT_DIR, configured)
    video_name = os.path.splitext(os.path.basename(video_path or ""))[0]
    if not video_name:
        return ""
    candidate = os.path.join(BACKGROUND_DIR, f"{video_name}.png")
    return candidate if os.path.isfile(candidate) else ""


class AvatarVideoTrack(MediaStreamTrack):
    kind = "video"

    def __init__(self, session: "AvatarSession"):
        super().__init__()
        self.session = session
        self.frame_rate = min(session.config.frame_rate, session.config.fps, 25)
        self.frame_duration = 1.0 / self.frame_rate
        self._start_time = None
        self._frame_count = 0
        self._render_errors = 0
        self._stopped = False
        first_frame = self._normalize_rgb_frame(session.engine.idle_frame_rgb(0))
        self._init_canvas(first_frame.shape[0], first_frame.shape[1])
        self._latest_frame = self._to_video_frame(first_frame)
        logger.info(
            f"[VideoTrack] Initialized at {self.frame_rate} FPS, delivering {self.width}x{self.height}"
        )

    def _init_canvas(self, frame_h: int, frame_w: int) -> None:
        """Set up the delivered frame, pasting the avatar onto a wider canvas.

        The avatar itself stays square — the model, the blend and the whole
        render path are untouched, so the extra width costs no GPU work. Only
        the delivered frame grows, which is what makes a 16:9 stream cheap.

        Compositing here rather than in the browser is deliberate: the canvas is
        encoded in the SAME VP8 frame as the avatar, so it shares the frame's
        quantiser. If the avatar degrades under bitrate pressure the background
        degrades with it, instead of a crisp CSS background framing a soft
        avatar. Flat bars also cost almost nothing to encode (~5% here).
        """
        config = self.session.config
        canvas_w = int(getattr(config, "canvas_width", 0) or 0)
        canvas_h = int(getattr(config, "canvas_height", 0) or 0)
        # yuv420p needs even dimensions in both planes.
        canvas_w -= canvas_w % 2
        canvas_h -= canvas_h % 2

        if canvas_w <= 0 or canvas_h <= 0 or (canvas_w == frame_w and canvas_h == frame_h):
            self._canvas = None
            self._paste = None
            self.height, self.width = frame_h, frame_w
            return

        # Only ever shrink: upscaling the avatar to fill the canvas would spend
        # bitrate on invented detail.
        scale = min(1.0, canvas_w / frame_w, canvas_h / frame_h)
        paste_w = max(2, int(frame_w * scale)) & ~1
        paste_h = max(2, int(frame_h * scale)) & ~1
        # Even offsets keep the avatar aligned to the chroma grid, so the
        # subsampled planes don't smear its edges into the background.
        x0 = ((canvas_w - paste_w) // 2) & ~1
        y0 = ((canvas_h - paste_h) // 2) & ~1

        self._canvas = self._build_background(canvas_h, canvas_w)
        self._paste = (y0, y0 + paste_h, x0, x0 + paste_w)
        self.height, self.width = canvas_h, canvas_w
        logger.info(
            f"[VideoTrack] Canvas {canvas_w}x{canvas_h}; avatar {paste_w}x{paste_h} "
            f"at ({x0},{y0}). Square crops (object-fit: cover) recover the avatar exactly."
        )

    def _build_background(self, height: int, width: int) -> np.ndarray:
        """Canvas the avatar is pasted onto. Black unless this avatar has a still
        (see resolve_canvas_background_path); the image is cover-fitted to the
        canvas — scaled to cover, then centre-cropped — so any source resolution
        fills the frame without distortion or letterboxing."""
        avatar = getattr(self.session.engine, "avatar", None)
        path = resolve_canvas_background_path(self.session.config, getattr(avatar, "video_path", "") or "")
        if path:
            try:
                image = cv2.imread(path, cv2.IMREAD_COLOR)
                if image is None:
                    raise RuntimeError("file missing or not a readable image")
                image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
                src_h, src_w = image.shape[:2]
                scale = max(width / src_w, height / src_h)
                image = cv2.resize(
                    image,
                    (max(width, int(round(src_w * scale))), max(height, int(round(src_h * scale)))),
                    interpolation=cv2.INTER_AREA if scale <= 1.0 else cv2.INTER_CUBIC,
                )
                top = (image.shape[0] - height) // 2
                left = (image.shape[1] - width) // 2
                logger.info(
                    f"[VideoTrack] Canvas background {path} ({src_w}x{src_h}) fitted to {width}x{height}"
                )
                return np.ascontiguousarray(image[top:top + height, left:left + width])
            except Exception as e:
                logger.warning(f"[VideoTrack] Canvas background {path!r} unusable ({e}); using black")
        else:
            logger.info("[VideoTrack] No canvas background for this avatar; using black bars")
        return np.zeros((height, width, 3), dtype=np.uint8)

    def _normalize_rgb_frame(self, frame_rgb: np.ndarray) -> np.ndarray:
        frame = np.asarray(frame_rgb)
        # Fast path: blended frames are already uint8/RGB/contiguous with even dims.
        if (frame.dtype == np.uint8 and frame.ndim == 3 and frame.shape[2] == 3
                and frame.flags["C_CONTIGUOUS"]
                and frame.shape[0] % 2 == 0 and frame.shape[1] % 2 == 0):
            return frame
        if frame.ndim == 2:
            frame = np.repeat(frame[:, :, None], 3, axis=2)
        elif frame.ndim == 3 and frame.shape[2] >= 3:
            frame = frame[:, :, :3]
        else:
            raise ValueError(f"Unsupported video frame shape: {frame.shape}")
        if frame.dtype != np.uint8:
            if np.issubdtype(frame.dtype, np.floating) and (float(np.nanmax(frame)) if frame.size else 0.0) <= 1.0:
                frame = frame * 255.0
            frame = np.nan_to_num(frame, copy=False)
            frame = np.clip(frame, 0, 255).astype(np.uint8)
        height = frame.shape[0] - (frame.shape[0] % 2)
        width = frame.shape[1] - (frame.shape[1] % 2)
        if height <= 0 or width <= 0:
            raise ValueError(f"Unsupported video frame dimensions: {frame.shape[:2]}")
        return np.ascontiguousarray(frame[:height, :width])

    def _render_and_normalize(self) -> Optional[VideoFrame]:
        frame = self.session.render_next_frame()
        if frame is None:
            return None
        return self._to_video_frame(self._normalize_rgb_frame(frame))

    def _to_video_frame(self, frame_rgb: np.ndarray) -> VideoFrame:
        """Build the encoder-ready frame. Handing the sender rgb24 makes libav
        convert to yuv420p on the event loop for every frame; doing it here keeps
        that work on the render executor. pts/time_base are still stamped in recv,
        which owns the clock."""
        if self._canvas is not None:
            y0, y1, x0, x1 = self._paste
            if frame_rgb.shape[0] != (y1 - y0) or frame_rgb.shape[1] != (x1 - x0):
                frame_rgb = cv2.resize(frame_rgb, (x1 - x0, y1 - y0), interpolation=cv2.INTER_AREA)
            # Only the avatar region is rewritten; the surrounding canvas was
            # built once and stays put, so this is a single memcpy per frame.
            self._canvas[y0:y1, x0:x1] = frame_rgb
            frame_rgb = self._canvas
        self.height, self.width = frame_rgb.shape[:2]
        return VideoFrame.from_ndarray(frame_rgb, format="rgb24").reformat(format="yuv420p")

    async def recv(self) -> VideoFrame:
        # Single authoritative clock: pace by wall time, then produce exactly ONE frame
        # per delivered frame (render + normalize on render_executor, off the event-loop
        # thread). 1:1 production==delivery eliminates the old dual-clock drift where the
        # producer and recv ran on independent clocks and skipped/repeated frames.
        loop = asyncio.get_running_loop()
        if self._start_time is None:
            self._start_time = time.monotonic()
        else:
            target_time = self._start_time + (self._frame_count * self.frame_duration)
            delay = target_time - time.monotonic()
            if delay > 0:
                await asyncio.sleep(delay)
        try:
            video_frame = await loop.run_in_executor(self.session.render_executor, self._render_and_normalize)
            if video_frame is not None:
                self._latest_frame = video_frame
        except Exception as e:
            self._render_errors += 1
            logger.error(f"[VideoTrack] Render error #{self._render_errors}: {e}")
        # Repeat-frames reuse the cached VideoFrame; pts/time_base are rewritten
        # per delivery so a repeat still advances the presentation clock.
        frame = self._latest_frame
        frame.pts = int(self._frame_count * VIDEO_CLOCK_RATE / self.frame_rate)
        frame.time_base = VIDEO_TIME_BASE
        self._frame_count += 1
        self.session.metrics.record_delivered()
        return frame

    def stop(self):
        if self._stopped:
            return
        self._stopped = True
        super().stop()


class AvatarSession:
    def __init__(
        self,
        engine: MuseTalkEngine,
        config: ServerConfig,
        taiboli_bridge: Optional[TaiboliBridgeClient] = None,
        system_prompt: Optional[str] = None,
        tools: Optional[list] = None,
        greeting_enabled: bool = False,
        initial_exchange_number: int = 0,
        song_lyrics: Optional[dict] = None,
        song_metadata: Optional[dict] = None,
        runtime_clock: Optional[RuntimeClockConfig] = None,
        slug_to_object_id: Optional[Dict[str, str]] = None,
    ):
        self.engine = engine
        self.config = config
        # Blank-avatar dev mode: no lip-sync at all. The feature extractor is
        # never built (it would load whisper), and neither worker thread is
        # started (see start()) — everything else in this class is unchanged,
        # so the browser-visible protocol stays byte-identical to production.
        self.blank_avatar = bool(getattr(config, "blank_avatar", False))
        self.taiboli_bridge = taiboli_bridge
        self.taiboli_session_id = taiboli_bridge.session_id if taiboli_bridge else None
        self.feature_extractor = (
            None if self.blank_avatar else StreamingMuseTalkFeatureExtractor(engine, fps=config.fps)
        )
        self.metrics = MuseTalkRuntimeMetrics(config.musetalk_profile, config.musetalk_metrics_interval_ms)
        self.audio_executor = concurrent.futures.ThreadPoolExecutor(max_workers=1, thread_name_prefix="musetalk-audio")
        self.render_executor = concurrent.futures.ThreadPoolExecutor(max_workers=1, thread_name_prefix="musetalk-video")
        self._input_audio_queue = asyncio.Queue(maxsize=MIC_AUDIO_QUEUE_MAX_CHUNKS)
        self._input_audio_sender_task = None
        self._dropped_input_audio_chunks = 0
        self._dropped_input_audio_ms = 0.0       # total mic audio lost to overflow
        self._max_input_queue_depth = 0          # high-water backlog (drained per send)
        self.input_audio_sample_rate = AUDIO_SAMPLE_RATE
        self.video_track: Optional[AvatarVideoTrack] = None
        self.audio_track: Optional[AvatarAudioTrack] = None
        self.data_channel = None
        self.is_running = False
        self.is_speaking = False
        self.total_frames = 0
        # Continuous-clock cycle position captured at each turn start, so the talking
        # render continues the avatar cycle from where idle left off (no pose jump).
        self._cycle_offset = 0
        self._loop = asyncio.get_running_loop()
        self._feature_generation = 0
        self._feature_condition = threading.Condition()
        self._feature_lock = threading.Lock()
        self._feature_audio_chunks = deque()
        self._feature_flush_requested = False
        self._feature_flush_callbacks = deque()
        self._feature_worker_stop = False
        self._feature_worker = threading.Thread(target=self._feature_worker_loop, name="musetalk-feature-worker", daemon=True)
        self._started_at = None
        # Set by the server when start() is launched concurrently with SDP
        # negotiation; close() cancels it if teardown wins the race.
        self.start_task: Optional[asyncio.Task] = None
        self._first_audio_latency_ms = None
        self._pending_tool_results: Dict[str, asyncio.Future] = {}
        self._exchange_number = max(0, int(initial_exchange_number))
        self._current_assistant_transcript = ""
        self._current_assistant_text = ""
        self._current_turn_tool_calls: list = []
        self._current_turn_tool_results: list = []
        self._current_turn_usage: Optional[dict] = None
        self._turn_started_at = None
        self._pending_exchange_tasks = set()
        self._speaking_done_task = None
        self._ended = False
        # --- Relay-parity state (loop-thread-only: Azure callbacks, data
        # channel callbacks and call_later timers all run on the event loop,
        # so none of this needs locks) -----------------------------------
        self.greeting_enabled = greeting_enabled
        # Doubles as the mic gate: audio is dropped until the greeting is
        # sent so buffered input_audio_buffer.append frames can't collide
        # with the greeting response.create (Azure server_error otherwise).
        self._greeting_sent = not greeting_enabled
        self._greeting_fallback_handle = None
        self._mic_frames_relayed = 0
        # A tool call surfaces on both function_call_arguments.done and
        # output_item.done; dedupe by call_id so it's emitted once.
        self._emitted_tool_call_ids = set()
        self._selection_slug_enum = extract_selection_slug_enum(
            tools if tools is not None else AVATAR_TOOLS_RT
        )
        self._coverage = CoverageTracker()
        self._pending_flips: set = set()
        self._tool_result_tracker = ToolResultTracker()
        self._runtime_clock = runtime_clock
        self._last_user_turn_at: Optional[float] = None
        self._slug_to_object_id: Dict[str, str] = slug_to_object_id or {}
        self._song_lyrics = song_lyrics or {}
        self._song_metadata = song_metadata or {}
        self._pending_segment: Optional[relay_protocol.PendingSegment] = None
        self._segment_timer_handle = None
        self._mic_muted_for_segment = False
        # Keeps the browser inside one speaking envelope across a song
        # segment: suppresses speaking_done when the preamble drains and the
        # next speaking_start when the continuation reply begins.
        self._segment_speaking_hold = False
        # Skip stale audio deltas from a response that was cancelled
        # (explicit interrupt or barge-in flush).
        self._pending_cancel = False
        # Deadline for the above. A real cancel stops the delta stream almost
        # immediately; deltas still arriving past this point mean no cancel is
        # coming, so we resume rather than swallow the rest of the reply.
        self._pending_cancel_deadline = 0.0
        # "vad" (upstream speech_started) or "interrupt" (explicit browser
        # request). Only the VAD path can produce a *false* barge-in — an
        # explicit interrupt is by definition what the user asked for — so the
        # KPI below must not conflate them.
        self._pending_cancel_reason = ""
        # Barge-in health counters (cumulative per session, surfaced on
        # /metrics). false_barge_ins is the primary signal for noisy-room
        # false positives: speech_started fired, but the response completed
        # normally, so the upstream VAD never actually treated it as a turn.
        self._speech_started_count = 0
        self._false_barge_ins = 0
        self._pending_cancel_recovered = 0
        self._barge_ins_vetoed = 0
        # A vetoed speech_started must also suppress its matching
        # speech_stopped, or the browser sees an unpaired event.
        self._vetoed_speech_started = False
        # Per-session so the VAD's LSTM state, carry buffer and look-ahead ring
        # belong to one learner. Driven only from audio_executor (max_workers=1),
        # which gives the serialisation stateful DSP needs.
        self.mic_gate = mic_gate.build_from_config(config)
        # Fires when the upstream Realtime socket dies — set by the server to
        # tear down the whole peer connection.
        self.on_fatal = None
        self._session_router = None
        self._pairer = relay_protocol.ExchangePairer(
            schedule=lambda delay, fn: asyncio.get_running_loop().call_later(delay, fn),
            cancel=lambda handle: handle.cancel(),
            persist=self._persist_exchange,
        )
        # session_config debug payload is deferred to data-channel open —
        # unlike the relay, Azure connects before the browser channel exists.
        self._debug_session_config_payload = None
        self._prompt_condition = threading.Condition()
        self._prompt_queue = deque()
        self._rendered_frames: Dict[int, np.ndarray] = {}
        # Turn-boundary mouth ramps. _closing_frames holds the short "mouth
        # shutting" animation rendered when a turn ends; it is displayed OUTSIDE
        # the audio clock, because by then there is no audio left to sync to.
        self._opening_frames: deque = deque()
        self._spoke_a_frame = False
        self._closing_frames: deque = deque()
        self._closing_requested = False
        self._closing_hold_until = 0.0
        self._last_speech_prompt: Optional[torch.Tensor] = None
        self._render_worker_stop = False
        # Set once the render worker's thread-local CUDA handles exist. The
        # greeting waits on this so the very first thing the learner hears is
        # not rendered by a cold thread.
        self._render_warm = threading.Event()
        if self.blank_avatar:
            # No render thread will ever run, so nothing else would set this and
            # the greeting would sit out its full 5 s warm deadline in silence.
            self._render_warm.set()
        self._greeting_warm_deadline = 0.0
        self._render_worker = threading.Thread(target=self._render_worker_loop, name="musetalk-render-worker", daemon=True)
        self._last_speech_frame = self.engine.idle_frame_rgb(0)
        self.system_prompt = system_prompt or config.system_prompt
        self.gpt_rt = AzureRealtimeSession(
            config=config,
            system_prompt=self.system_prompt,
            tools=tools if tools is not None else AVATAR_TOOLS_RT,
            on_audio_delta=self._on_gpt_audio_delta,
            on_text_delta=self._on_gpt_text_delta,
            on_transcript_delta=self._on_gpt_transcript_delta,
            on_tool_call=self._on_gpt_tool_call,
            on_response_created=self._on_gpt_response_created,
            on_response_done=self._on_gpt_response_done,
            on_speech_started=self._on_user_speech_started,
            on_speech_stopped=self._on_user_speech_stopped,
            on_input_transcript_delta=self._on_input_transcript_delta,
            on_input_transcript=self._on_input_transcript,
            on_error=self._on_gpt_error,
            on_session_updated=self._on_session_updated,
            on_output_item_done=self._on_output_item_done,
            on_raw_event=self._on_azure_raw_event,
            on_closed=self._on_realtime_closed,
        )

    async def start(self, pre_opened_ws=None):
        self.is_running = True
        self._started_at = time.time()
        self._started_mono = time.monotonic()
        # Load the VAD on the audio executor during negotiation, so the first
        # mic chunk of the session doesn't pay for it. Same reasoning as the
        # render/feature thread warms in AGENTS.md §11.12.
        if self.mic_gate.enabled:
            asyncio.get_running_loop().run_in_executor(
                self.audio_executor, self.mic_gate.ensure_loaded
            )
        # Upper bound on how long the greeting may wait for a warm renderer.
        self._greeting_warm_deadline = time.monotonic() + 5.0
        if not self.blank_avatar:
            self._feature_worker.start()
            self._render_worker.start()
        await self.gpt_rt.connect(pre_opened_ws=pre_opened_ws)
        # session.update is on the wire — greet on session.updated, or after
        # the D5 fallback window if Azure never confirms (relay parity).
        if self.greeting_enabled and not self._greeting_sent:
            self._greeting_fallback_handle = self._loop.call_later(
                relay_protocol.GREETING_FALLBACK_SECONDS, self._send_greeting_once
            )
        # Some rejections are silent: no error event, no session.updated, just
        # nothing. Re-send without the experimental fields well inside the
        # greeting fallback window so the retry's session.updated still beats
        # it and the learner never notices the round trip.
        if self.gpt_rt._experimental_fields_sent():
            self._loop.call_later(
                SESSION_UPDATE_RETRY_SECONDS, self._retry_session_update_if_silent
            )
        self._debug_session_config_payload = {
            "mode": "full",
            "toolNames": [t.get("name") for t in (self.gpt_rt.tools or []) if isinstance(t, dict)],
            "instructionsLength": len(self.system_prompt or ""),
        }
        self._input_audio_sender_task = asyncio.create_task(self._input_audio_sender_loop())

    async def send_user_text(self, text: str):
        normalized = text.strip()
        if normalized:
            self.record_user_text(normalized)
            await self.gpt_rt.send_user_text(normalized)

    def record_user_text(self, text: str):
        """Feed browser-injected user text (user_message events or the raw
        conversation.item.create passthrough) into transcript pairing."""
        self._pairer.on_user_text(text)
        self._turn_started_at = time.time()

    def set_input_audio_sample_rate(self, sample_rate: int):
        if sample_rate > 0:
            self.input_audio_sample_rate = sample_rate
            logger.info(f"[Session] Browser audio sample rate: {sample_rate}Hz")
            self.emit_debug("relay_decision", {
                "action": "sample_rate_configured",
                "inputSampleRate": sample_rate,
            })

    def queue_user_audio_bytes(self, audio_bytes: bytes, sample_rate: Optional[int] = None):
        if not audio_bytes or not self.is_running:
            return
        # Don't forward mic audio until the greeting has been sent: the
        # browser auto-starts the mic the moment the data channel opens, and
        # frames buffered before session.updated would flush as a burst of
        # input_audio_buffer.append that collides with the greeting
        # response.create (Azure server_error). The learner isn't speaking
        # pre-greeting, so dropping these costs nothing.
        if not self._greeting_sent:
            return
        if self._mic_muted_for_segment:
            return
        self._mic_frames_relayed += 1
        if self._mic_frames_relayed % 100 == 0:
            self.emit_debug("relay_decision", {
                "action": "mic_frames_relayed",
                "inboundFrames": self._mic_frames_relayed,
            })
        item = (audio_bytes, sample_rate or self.input_audio_sample_rate)
        try:
            self._input_audio_queue.put_nowait(item)
        except asyncio.QueueFull:
            try:
                stale_bytes, stale_rate = self._input_audio_queue.get_nowait()
                self._input_audio_queue.task_done()
                # int16 mono: 2 bytes/sample. Tally lost audio so logs show severity.
                self._dropped_input_audio_ms += (len(stale_bytes) / 2) / max(stale_rate, 1) * 1000.0
            except asyncio.QueueEmpty:
                pass
            self._dropped_input_audio_chunks += 1
            if self._dropped_input_audio_chunks in (1, 10) or self._dropped_input_audio_chunks % 50 == 0:
                logger.warning(
                    f"[Session] Dropped {self._dropped_input_audio_chunks} stale mic audio chunks "
                    f"(~{self._dropped_input_audio_ms:.0f} ms total) — event loop starved under render load"
                )
            try:
                self._input_audio_queue.put_nowait(item)
            except asyncio.QueueFull:
                pass

    async def _input_audio_sender_loop(self):
        loop = asyncio.get_running_loop()
        while self.is_running:
            try:
                audio_bytes, source_rate = await self._input_audio_queue.get()
            except asyncio.CancelledError:
                break

            # Coalesce any chunks that backed up behind a render-induced loop stall
            # into a single send: drain everything now queued, concatenate in FIFO
            # order, and send once. Whole-sample (1024-byte) chunks keep the stream
            # sample-aligned, so ws_server receives the identical bytes in fewer/
            # larger frames. Sample rate is fixed per session (the browser sends
            # audio_stream_config once before any audio), so every queued chunk
            # shares source_rate and concatenation is correct.
            batch = [audio_bytes]
            taken = 1
            while True:
                try:
                    nxt_bytes, _ = self._input_audio_queue.get_nowait()
                except asyncio.QueueEmpty:
                    break
                taken += 1
                batch.append(nxt_bytes)
            if taken > self._max_input_queue_depth:
                self._max_input_queue_depth = taken
                if taken >= MIC_AUDIO_QUEUE_MAX_CHUNKS // 2:
                    logger.info(
                        f"[Session] Mic relay coalesced {taken} backed-up chunks "
                        f"(cap {MIC_AUDIO_QUEUE_MAX_CHUNKS}) — bridging a render stall without dropping"
                    )
            combined = b"".join(batch)

            try:
                # LOCAL: forward the browser's 16 kHz audio as raw binary (ws_server
                # consumes 16 kHz directly). The browser AudioContext is 16 kHz, so
                # this is a passthrough — send inline (no per-chunk executor hop / GIL
                # handoff) so the sender keeps draining while render threads hold the
                # GIL. Azure: resample to 24 kHz + base64.
                if self.gpt_rt.is_local:
                    if source_rate == AUDIO_SAMPLE_RATE:
                        audio_16k = combined
                    else:
                        audio_16k = await loop.run_in_executor(
                            self.audio_executor,
                            _pcm16_resample_bytes,
                            combined,
                            source_rate,
                            AUDIO_SAMPLE_RATE,
                        )
                    if audio_16k:
                        await self.gpt_rt.send_audio_binary(audio_16k)
                else:
                    audio_24k = await loop.run_in_executor(
                        self.audio_executor,
                        _gate_and_resample,
                        self.mic_gate,
                        combined,
                        source_rate,
                        GPT_RT_SAMPLE_RATE,
                    )
                    if audio_24k:
                        await self.gpt_rt.send_audio(base64.b64encode(audio_24k).decode("ascii"))
            except asyncio.CancelledError:
                break
            except Exception as e:
                logger.error(f"[Session] User audio forwarding failed: {e}")
            finally:
                # One task_done() per get()/get_nowait() consumed this iteration.
                for _ in range(taken):
                    self._input_audio_queue.task_done()

    def _begin_speaking(self):
        if self._speaking_done_task and not self._speaking_done_task.done():
            self._speaking_done_task.cancel()
        if self.is_speaking:
            return
        self._reset_sync_state()
        self._opening_frames.clear()
        self._spoke_a_frame = False
        self._closing_frames.clear()
        self._closing_hold_until = 0.0
        self._last_speech_prompt = None
        self._cycle_offset = self.total_frames
        if self.audio_track:
            self.audio_track.begin_turn()
        self.is_speaking = True
        if self._segment_speaking_hold:
            # The continuation reply after a song segment stays inside the
            # original speaking envelope — the browser never saw a
            # speaking_done, so don't send a second speaking_start.
            self._segment_speaking_hold = False
        else:
            self._send_dc({"event": "speaking_start"})
        logger.info("[Session] GPT audio started")

    def _reset_sync_state(self):
        self._feature_generation += 1
        self._reset_feature_state()
        with self._prompt_condition:
            self._prompt_queue.clear()
            self._rendered_frames.clear()
            self._prompt_condition.notify_all()

    def _reset_feature_state(self):
        with self._feature_condition:
            with self._feature_lock:
                if self.feature_extractor is not None:
                    self.feature_extractor.reset()
            self._feature_audio_chunks.clear()
            self._feature_flush_requested = False
            self._feature_flush_callbacks.clear()
            self._feature_condition.notify_all()

    def _schedule_on_loop(self, callback):
        try:
            self._loop.call_soon_threadsafe(callback)
        except RuntimeError:
            pass

    def _on_gpt_audio_delta(self, audio_base64: str):
        # Skip stale audio frames arriving after an interrupt/barge-in cancel.
        if self._pending_cancel:
            grace_ms = self.config.pending_cancel_grace_ms
            if grace_ms <= 0 or time.monotonic() < self._pending_cancel_deadline:
                return
            # Deltas are still flowing well past the point where a genuine
            # cancel would have landed, so Azure is not cancelling — this was a
            # false barge-in (background noise tripping semantic_vad). Un-mute
            # instead of discarding the remainder of the tutor's reply.
            #
            # Safe to resume: _flush_playback_buffers() reset the audio clock
            # (clear_audio -> _real_audio_samples_consumed = 0) and the feature
            # extractor together, so playback restarts as a coherent sub-turn
            # rather than desyncing against a stale frame index.
            self._pending_cancel = False
            self._pending_cancel_recovered += 1
            logger.warning(
                f"[Session] pending_cancel expired after {grace_ms} ms with audio still "
                f"arriving — resuming playback (suspected false barge-in)"
            )
            self.emit_debug("relay_decision", {"action": "pending_cancel_recovered"})
        try:
            if self._first_audio_latency_ms is None and self._started_at is not None:
                self._first_audio_latency_ms = int((time.time() - self._started_at) * 1000)
            audio_bytes_24k = base64.b64decode(audio_base64)
            if not audio_bytes_24k:
                return
            # Playback keeps Azure's native rate (no resample when they match);
            # only the lip-sync feature path needs 16 kHz, because that is what
            # whisper consumes.
            playback_rate = self.config.playback_sample_rate
            audio_playback = (
                audio_bytes_24k
                if playback_rate == GPT_RT_SAMPLE_RATE
                else _pcm16_resample_bytes(audio_bytes_24k, GPT_RT_SAMPLE_RATE, playback_rate)
            )
            if not audio_playback:
                return
            self._begin_speaking()
            if self.audio_track:
                self.audio_track.queue_audio(audio_playback)
            # Hand the feature worker Azure's native-rate bytes; it resamples to
            # 16 kHz on its own thread so no soxr work runs on the event loop.
            self._append_lip_sync_features(audio_bytes_24k)
        except Exception as e:
            logger.error(f"[Session] GPT audio delta failed: {e}")

    def _append_lip_sync_features(self, audio_16k: bytes):
        if not audio_16k:
            return
        if self.blank_avatar:
            # No feature worker is running, so anything appended here would sit
            # in the deque forever — and _finish_speaking_when_drained counts it
            # as pending, which would stall speaking_done until its 30 s timeout.
            return
        with self._feature_condition:
            self._feature_audio_chunks.append(bytes(audio_16k))
            self._feature_condition.notify_all()

    def _blank_flush_callbacks(self):
        """Blank mode's stand-in for the feature worker's callback drain."""
        with self._feature_condition:
            callbacks = list(self._feature_flush_callbacks)
            self._feature_flush_callbacks.clear()
        for callback in callbacks:
            callback()

    def _flush_lip_sync_features(self, on_complete=None):
        if self.blank_avatar:
            # There is nothing to flush, but the callback carries llm_done and
            # the speaking drain. Queue it the same way the real path does and
            # run it from a later loop iteration, so a _reset_feature_state()
            # racing in between still discards it exactly as in production —
            # and _feature_flush_requested stays False, which is what keeps
            # _finish_speaking_when_drained from waiting on a worker that
            # will never run.
            if on_complete:
                with self._feature_condition:
                    self._feature_flush_callbacks.append(on_complete)
            self._schedule_on_loop(self._blank_flush_callbacks)
            return
        with self._feature_condition:
            self._feature_flush_requested = True
            if on_complete:
                self._feature_flush_callbacks.append(on_complete)
            self._feature_condition.notify_all()

    def _feature_worker_loop(self):
        self.engine.warm_feature_thread()
        step_s = max(0.02, self.config.feature_step_ms / 1000.0)
        while True:
            with self._feature_condition:
                while (
                    not self._feature_worker_stop
                    and not self._feature_audio_chunks
                    and not self._feature_flush_requested
                ):
                    self._feature_condition.wait(timeout=0.1)
                if self._feature_worker_stop:
                    return
                # At the start of a turn the whole pipeline is empty and every
                # millisecond here is dead air the renderer can't cover, so emit
                # the first prompts immediately instead of sitting out a full
                # coalesce window. Mid-turn, coalescing is what keeps whisper
                # from running per-delta.
                turn_start = self.feature_extractor.next_frame_index == 0
                if self._feature_audio_chunks and not self._feature_flush_requested and not turn_start:
                    coalesce_started = time.monotonic()
                    while (
                        not self._feature_worker_stop
                        and not self._feature_flush_requested
                        and time.monotonic() - coalesce_started < step_s
                    ):
                        remaining = step_s - (time.monotonic() - coalesce_started)
                        if remaining <= 0:
                            break
                        self._feature_condition.wait(timeout=remaining)
                    if self._feature_worker_stop:
                        return
                chunks = list(self._feature_audio_chunks)
                self._feature_audio_chunks.clear()
                flush_requested = self._feature_flush_requested
                callbacks = list(self._feature_flush_callbacks) if flush_requested else []
                if flush_requested:
                    self._feature_flush_requested = False
                    self._feature_flush_callbacks.clear()
                generation = self._feature_generation

            # Pace extraction against playback. Without this the worker converts
            # the whole turn's audio as fast as Azure streams it, starving the
            # render worker for CPU exactly when the turn starts (see
            # ServerConfig.feature_lead_frames). A flush or shutdown always wins.
            lead_limit = int(self.config.feature_lead_frames)
            if chunks and lead_limit > 0 and not flush_requested:
                while not self._feature_worker_stop:
                    lead = self.feature_extractor.next_frame_index - self._current_audio_target_frame()
                    if lead < lead_limit:
                        break
                    with self._feature_condition:
                        if self._feature_flush_requested or self._feature_worker_stop:
                            break
                        self._feature_condition.wait(timeout=0.05)
                if self._feature_worker_stop:
                    return

            if chunks:
                try:
                    # Deltas are appended at Azure's native rate and resampled
                    # here, not on the event loop: one soxr call per coalesced
                    # batch instead of one per delta, off the loop thread, and
                    # more accurate than resampling each fragment separately.
                    audio_bytes = _pcm16_resample_bytes(
                        b"".join(chunks), GPT_RT_SAMPLE_RATE, AUDIO_SAMPLE_RATE
                    )
                    audio_16k = np.frombuffer(audio_bytes, dtype=np.int16)
                    started = time.perf_counter()
                    with self._feature_lock:
                        prompts = self.feature_extractor.process_chunk(audio_16k)
                    self.metrics.record_feature((time.perf_counter() - started) * 1000.0, len(prompts))
                    self._queue_feature_prompts(prompts, generation)
                except Exception as e:
                    logger.error(f"[Session] MuseTalk feature extraction failed: {e}")

            if flush_requested:
                try:
                    started = time.perf_counter()
                    with self._feature_lock:
                        prompts = self.feature_extractor.flush()
                    self.metrics.record_feature((time.perf_counter() - started) * 1000.0, len(prompts))
                    self._queue_feature_prompts(prompts, generation)
                except Exception as e:
                    logger.error(f"[Session] MuseTalk feature flush failed: {e}")
                for callback in callbacks:
                    self._schedule_on_loop(callback)
            self.metrics.maybe_log()

    def _queue_feature_prompts(self, prompts: List[Tuple[int, torch.Tensor]], generation: int):
        if generation != self._feature_generation or not prompts:
            return
        with self._prompt_condition:
            for item in prompts:
                self._prompt_queue.append(item)
            self.metrics.observe_queues(len(self._prompt_queue), len(self._rendered_frames))
            self._prompt_condition.notify_all()

    def _current_audio_target_frame(self) -> int:
        # get_real_audio_consumed() counts samples at the PLAYBACK rate, so the
        # samples-per-video-frame divisor must use that same rate (not the 16 kHz
        # lip-sync rate) or the whole render pipeline gates against a clock
        # running at the wrong speed.
        audio_played = self.audio_track.get_real_audio_consumed() if self.audio_track else 0
        samples_per_frame = max(1, int(self.config.playback_sample_rate / self.config.fps))
        return int(audio_played // samples_per_frame)

    def _render_worker_loop(self):
        # Pay this thread's CUDA handle init now, during connection setup,
        # rather than on the user's first spoken response. See warm_render_thread.
        # Readiness fires after the shapes a turn opens with; the remaining
        # partial-batch shapes keep warming behind it.
        self.engine.warm_render_thread(on_ready=self._render_warm.set)
        self._render_warm.set()
        max_wait = max(0, self.config.render_max_wait_ms) / 1000.0

        def drop_stale_prompts_locked(target_idx: int):
            stale_before = max(0, target_idx - self.config.max_render_lag_frames)
            dropped = 0
            while self._prompt_queue and self._prompt_queue[0][0] < stale_before:
                self._prompt_queue.popleft()
                dropped += 1
            if dropped:
                self.metrics.record_stale_prompt_drops(dropped)

        while True:
            # Outside the lock on purpose: these render, and holding
            # _prompt_condition through a GPU call would stall frame delivery.
            if self._closing_requested:
                self._render_closing_ramp()
            with self._prompt_condition:
                while (not self._render_worker_stop and not self._prompt_queue
                       and not self._closing_requested):
                    self._prompt_condition.wait(timeout=0.1)
                if self._render_worker_stop:
                    return
                target_idx = self._current_audio_target_frame()
                drop_stale_prompts_locked(target_idx)
                if not self._prompt_queue:
                    continue
                eligible_until = target_idx + self.config.render_ahead_frames
                if self._prompt_queue[0][0] > eligible_until:
                    self._prompt_condition.wait(timeout=0.02)
                    continue
                # Wait for a full batch to become ELIGIBLE, not merely queued.
                # Once the renderer is caught up the horizon releases exactly one
                # prompt per frame of audio playback, so a long _prompt_queue
                # never means a batch is renderable — the old len(_prompt_queue)
                # test saw the feature worker's 100+ queued prompts, exited
                # instantly, and pinned this worker to batch 1. That is the
                # model's worst mode: measured live at 1.15 frames/batch and
                # 40 ms/frame against a 40 ms budget (p95 49 ms), versus
                # 16.6 ms/frame at batch 4. Display buffer we already hold is
                # what makes waiting free, so spend that and nothing else.
                batch_size = max(1, self.config.musetalk_batch_size)
                frame_s = 1.0 / max(1, self.config.fps)
                start = time.monotonic()
                while not self._render_worker_stop:
                    target_idx = self._current_audio_target_frame()
                    drop_stale_prompts_locked(target_idx)
                    eligible_until = target_idx + self.config.render_ahead_frames
                    eligible = 0
                    for queued_idx, _ in self._prompt_queue:
                        if queued_idx > eligible_until:
                            break
                        eligible += 1
                        if eligible >= batch_size:
                            break
                    if eligible >= batch_size or not self._prompt_queue:
                        break
                    # Keep batch_size frames in hand as the floor and never wait
                    # longer than the audio needs to release a full batch, so the
                    # wait is always paid for by frames already on the shelf. At
                    # turn start the shelf is empty, so this collapses back to
                    # render_max_wait_ms and start-of-turn latency is unchanged.
                    surplus_frames = len(self._rendered_frames) - batch_size
                    budget = max_wait
                    if surplus_frames > 0:
                        budget = max(max_wait, min(batch_size * frame_s,
                                                   surplus_frames * frame_s))
                    waited = time.monotonic() - start
                    if waited >= budget:
                        break
                    self._prompt_condition.wait(timeout=min(0.02, budget - waited))
                target_idx = self._current_audio_target_frame()
                drop_stale_prompts_locked(target_idx)
                eligible_until = target_idx + self.config.render_ahead_frames
                batch = []
                while self._prompt_queue and len(batch) < self.config.musetalk_batch_size:
                    if self._prompt_queue[0][0] > eligible_until:
                        break
                    batch.append(self._prompt_queue.popleft())
                self.metrics.observe_queues(len(self._prompt_queue), len(self._rendered_frames))
            if not batch:
                continue
            frame_indices = [item[0] for item in batch]
            prompts = [item[1] for item in batch]
            # Remember the real last prompt so the closing animation starts from
            # the mouth shape actually on screen.
            self._last_speech_prompt = prompts[-1]
            # Keep _rendered_frames keyed by the audio-sync frame_index, but render
            # each onto the continuous avatar cycle so head pose matches idle.
            cycle_indices = [self._cycle_offset + fi for fi in frame_indices]
            # First batch of a turn: prepend the mouth-opening ramp so it rides
            # the SAME GPU call. Rendering it separately both delayed this batch
            # and raced it — whichever landed first won, so the ramp sometimes
            # never showed and the mouth snapped anyway.
            ramp_prompts, ramp_cycles = self._opening_ramp_inputs(frame_indices, prompts)
            try:
                all_frames = self.engine.render_batch(
                    ramp_prompts + prompts, ramp_cycles + cycle_indices,
                    metrics=self.metrics, cycle_indices=ramp_cycles + cycle_indices)
            except Exception as e:
                logger.error(f"[RenderWorker] MuseTalk render failed: {e}")
                continue
            if ramp_prompts:
                with self._prompt_condition:
                    if self.is_speaking and not self._spoke_a_frame:
                        self._opening_frames.extend(all_frames[:len(ramp_prompts)])
                frames = all_frames[len(ramp_prompts):]
            else:
                frames = all_frames
            with self._prompt_condition:
                for frame_index, frame in zip(frame_indices, frames):
                    self._rendered_frames[frame_index] = frame
                self.metrics.observe_queues(len(self._prompt_queue), len(self._rendered_frames))
            self.metrics.maybe_log()

    def _opening_ramp_inputs(self, frame_indices, prompts):
        """Prompts/poses for the mouth opening, or ([], []) when not applicable.

        Returned rather than rendered so the caller can fold them into the first
        real batch: one GPU call, so the ramp cannot arrive late (and be dropped)
        or delay the audio-synced frames behind it.

        Interpolating the whisper PROMPT makes the UNet draw real intermediate
        mouth shapes; cross-fading rendered images instead ghosts the lips.
        """
        ramp = self.config.mouth_ramp_frames
        avatar = self.engine.avatar
        if ramp <= 0 or avatar is None or avatar.idle_prompt is None or 0 not in frame_indices:
            return [], []
        try:
            idle_prompt = avatar.idle_prompt.float()
            first_prompt = prompts[frame_indices.index(0)].float()
            ramp_prompts, ramp_cycles = [], []
            for step in range(ramp):
                weight = (step + 1) / (ramp + 1)
                ramp_prompts.append(torch.lerp(idle_prompt, first_prompt, weight))
                # Poses immediately before frame 0, so head motion stays continuous.
                ramp_cycles.append(self._cycle_offset - ramp + step)
            return ramp_prompts, ramp_cycles
        except Exception as e:
            logger.warning(f"[RenderWorker] Opening ramp inputs failed: {e}")
            return [], []

    def _request_closing_ramp(self):
        """Ask the render worker for the mouth-closing animation.

        Called as the turn drains, from the event loop — so it only sets a flag;
        the render itself belongs on the worker thread.
        """
        if self.config.mouth_ramp_frames <= 0 or self._last_speech_prompt is None:
            return
        if self.engine.avatar is None or self.engine.avatar.idle_prompt is None:
            return
        # Hold the last spoken frame rather than cutting to idle while the ramp
        # renders (~50 ms), so the gap can't itself become a snap.
        self._closing_hold_until = time.monotonic() + 0.25
        with self._prompt_condition:
            self._closing_requested = True
            self._prompt_condition.notify_all()

    def _render_closing_ramp(self):
        """Render the mouth shutting, from the last spoken shape back to idle.

        Runs on the render worker. These frames are displayed OUTSIDE the audio
        clock: the audio has already finished, so there is nothing left to sync
        against and the normal `key <= target_idx` gate would never release them.
        """
        with self._prompt_condition:
            self._closing_requested = False
            last_prompt = self._last_speech_prompt
        avatar = self.engine.avatar
        ramp = self.config.mouth_ramp_frames
        if last_prompt is None or avatar is None or avatar.idle_prompt is None or ramp <= 0:
            return
        try:
            base = self.total_frames
            prompts, cycles = [], []
            for step in range(ramp):
                weight = (step + 1) / (ramp + 1)
                prompts.append(torch.lerp(last_prompt.float(), avatar.idle_prompt.float(), weight))
                cycles.append(base + step)
            frames = self.engine.render_batch(prompts, cycles, cycle_indices=cycles)
            with self._prompt_condition:
                # A new turn (or a barge-in) may have started while this rendered;
                # dropping it then avoids showing a stale mouth over fresh speech.
                if not self.is_speaking:
                    self._closing_frames.extend(frames)
        except Exception as e:
            logger.error(f"[RenderWorker] Closing ramp failed: {e}")

    def render_next_frame(self) -> Optional[np.ndarray]:
        if self.blank_avatar:
            # Every frame is the same black frame, and AvatarVideoTrack already
            # reuses its cached VideoFrame when this returns None (the repeated-
            # frame path). That skips the per-frame rgb24 -> yuv420p convert, so
            # a session costs essentially no CPU on the small dev box — while
            # recv() still paces and stamps pts at the normal 25 fps.
            self.total_frames += 1
            self.metrics.record_display(generated=False, repeated=True)
            self.metrics.maybe_log()
            return None
        # Mouth opening: play it out before any audio-clocked frame. Only while
        # no real speech frame has shown yet, so a late-arriving ramp can never
        # play over speech already in progress.
        if self._opening_frames and self.is_speaking and not self._spoke_a_frame:
            frame = self._opening_frames.popleft()
            self._last_speech_frame = frame
            self.total_frames += 1
            self.metrics.record_display(generated=True, repeated=False)
            return frame
        target_idx = self._current_audio_target_frame()
        min_ready_idx = max(0, target_idx - self.config.max_render_lag_frames)
        frame = None
        with self._prompt_condition:
            stale_rendered = [key for key in self._rendered_frames if key < min_ready_idx]
            for key in stale_rendered:
                self._rendered_frames.pop(key, None)
            ready_indices = [key for key in self._rendered_frames if min_ready_idx <= key <= target_idx]
            if ready_indices:
                selected_idx = max(ready_indices)
                frame = self._rendered_frames.pop(selected_idx)
                for key in ready_indices:
                    if key != selected_idx:
                        self._rendered_frames.pop(key, None)
            self.metrics.observe_queues(len(self._prompt_queue), len(self._rendered_frames))
        if frame is not None:
            self._last_speech_frame = frame
            self._spoke_a_frame = True
            self._opening_frames.clear()
            self.total_frames += 1
            self.metrics.record_display(generated=True, repeated=False)
            self.metrics.maybe_log()
            return frame
        if self.is_speaking and target_idx > 0:
            self.total_frames += 1
            self.metrics.record_display(generated=False, repeated=True)
            self.metrics.maybe_log()
            return self._last_speech_frame
        # Turn just ended: play the mouth shutting, then fall through to idle.
        if self._closing_frames:
            frame = self._closing_frames.popleft()
            self._last_speech_frame = frame
            self.total_frames += 1
            self.metrics.record_display(generated=True, repeated=False)
            self.metrics.maybe_log()
            return frame
        if self._closing_hold_until and time.monotonic() < self._closing_hold_until:
            # Ramp still rendering — hold the last spoken frame instead of
            # cutting to the closed idle mouth, which is the snap we are fixing.
            self.total_frames += 1
            self.metrics.record_display(generated=False, repeated=True)
            self.metrics.maybe_log()
            return self._last_speech_frame
        self._closing_hold_until = 0.0
        frame = self.engine.idle_frame_rgb(self.total_frames)
        self.total_frames += 1
        self.metrics.maybe_log()
        return frame

    def _on_gpt_text_delta(self, text: str):
        self._current_assistant_text += text
        self._send_dc({"event": "llm_text_chunk", "text": text})

    def _on_gpt_transcript_delta(self, text: str):
        self._current_assistant_transcript += text
        self._send_dc({"event": "llm_text_chunk", "text": text})

    def _on_gpt_response_created(self, event: dict):
        self._current_assistant_transcript = ""
        self._current_assistant_text = ""
        # A new response supersedes any cancel — without this, a barge-in
        # during drain (no active response to cancel) would wedge the flag
        # and mute the next reply's audio.
        self._pending_cancel = False
        self._turn_started_at = self._turn_started_at or time.time()
        self._send_dc({"event": "llm_start"})

    def _on_gpt_response_done(self, event: dict):
        response = event.get("response", {})
        status = response.get("status")
        usage = response.get("usage")
        if usage:
            logger.info(f"[TokenUsage] turn status={status} | {json.dumps(usage)}")
            self._current_turn_usage = usage
        # Clear unconditionally: the response is over, so the flag has no
        # remaining job. Clearing it only on status == "cancelled" meant a
        # speech_started that Azure never acted on left the flag set, muting
        # every remaining delta of a still-running response.
        was_pending = self._pending_cancel
        was_vad_barge_in = self._pending_cancel_reason == "vad"
        self._pending_cancel = False
        self._pending_cancel_reason = ""
        if was_pending and was_vad_barge_in and status != "cancelled":
            # We tore down local playback for a barge-in that the upstream VAD
            # never converted into a cancel — almost always background noise.
            self._false_barge_ins += 1
            logger.warning(
                f"[Session] barge-in flushed playback but response finished with "
                f"status={status!r} (not cancelled) — suspected false barge-in "
                f"({self._false_barge_ins} this session)"
            )
            self.emit_debug("relay_decision", {
                "action": "barge_in_no_cancel",
                "status": status,
                "falseBargeIns": self._false_barge_ins,
            })
        # Close out the turn's transcript. A cancelled turn still counts: the
        # learner heard what the tutor said before barging in (relay parity —
        # the old code skipped cancelled/failed turns entirely).
        self._pairer.on_response_done(self._assistant_final_text())
        self._current_assistant_transcript = ""
        self._current_assistant_text = ""
        # Only inject the clock after responses that produced audio (actual
        # conversational turns). Function-call-only and text-only responses
        # (probe acks, show_objects calls) must NOT get a clock message — it
        # would land between a function_call and its function_call_output,
        # corrupting the conversation and causing status=failed chains.
        audio_tokens = (
            (usage or {}).get("output_token_details", {}).get("audio_tokens", 0)
        )
        if audio_tokens > 0:
            self._inject_turn_clock()
        if self.audio_track:
            self.audio_track.force_playback()
        self._flush_lip_sync_features(lambda: self._finish_gpt_response_done(status))

    def _assistant_final_text(self) -> str:
        return (self._current_assistant_transcript or self._current_assistant_text).strip()

    def _persist_exchange(self, user_message: str, assistant_message: str):
        if not self.taiboli_bridge:
            return
        self._exchange_number += 1
        exchange_number = self._exchange_number
        latency_ms = int((time.time() - self._turn_started_at) * 1000) if self._turn_started_at else None
        tool_calls = self._current_turn_tool_calls[:] if self._current_turn_tool_calls else None
        tool_results = self._current_turn_tool_results[:] if self._current_turn_tool_results else None
        token_usage = self._current_turn_usage
        self._current_turn_tool_calls.clear()
        self._current_turn_tool_results.clear()
        self._current_turn_usage = None
        task = asyncio.create_task(
            self._store_exchange_with_retry(
                exchange_number, user_message, assistant_message,
                latency_ms, tool_calls, tool_results, token_usage,
            )
        )
        self._pending_exchange_tasks.add(task)
        task.add_done_callback(self._pending_exchange_tasks.discard)
        self._turn_started_at = None

    async def _store_exchange_with_retry(self, exchange_number, user_message, assistant_message, latency_ms, tool_calls=None, tool_results=None, token_usage=None):
        for attempt in range(3):
            try:
                await self.taiboli_bridge.store_exchange(
                    exchange_number, user_message, assistant_message,
                    latency_ms, tool_calls, tool_results, token_usage,
                )
                self._tool_result_tracker.on_exchange_persisted(exchange_number)
                logger.info(f"[Taiboli] Stored exchange {exchange_number} for session {self.taiboli_session_id}")
                return
            except Exception as e:
                logger.error(f"[Taiboli] Exchange {exchange_number} write failed (attempt {attempt + 1}): {e}")
                if attempt < 2:
                    await asyncio.sleep(0.5 * (attempt + 1))

    def _finish_gpt_response_done(self, status: Optional[str] = None):
        if self._pending_segment is not None:
            # A play_song segment intercept is awaiting browser playback —
            # suppress llm_done/llm_error until the post-segment continuation
            # response completes (relay parity). The drain below still runs so
            # the spoken preamble finishes and video returns to idle.
            pass
        elif status == "failed":
            self._send_dc({"event": "llm_error", "error": status})
        else:
            # "cancelled" is a normal barge-in and "incomplete" ends quietly —
            # surfacing them as llm_error made the UI flash a spurious pill.
            self._send_dc({"event": "llm_done"})
        if self.is_speaking:
            self._speaking_done_task = asyncio.create_task(self._finish_speaking_when_drained())

    async def _finish_speaking_when_drained(self):
        started = time.time()
        try:
            while self.is_speaking and self.is_running:
                buffered = self.audio_track.buffered_samples() if self.audio_track else 0
                with self._prompt_condition:
                    pending = len(self._prompt_queue) + len(self._rendered_frames)
                with self._feature_condition:
                    feature_pending = len(self._feature_audio_chunks) + int(self._feature_flush_requested)
                if buffered == 0 and pending == 0 and feature_pending == 0:
                    break
                if time.time() - started > 30:
                    logger.warning("[Session] Speaking drain timed out")
                    break
                await asyncio.sleep(0.04)
        except asyncio.CancelledError:
            return
        finally:
            if self.is_speaking:
                # Queue the closing animation BEFORE flipping the flag, so the
                # display has something to show instead of cutting to idle.
                self._request_closing_ramp()
                self.is_speaking = False
                self._feature_generation += 1
                self._reset_feature_state()
                # Drop anything still rendered for this turn. render_next_frame
                # honours _rendered_frames regardless of is_speaking, so a
                # straggler here surfaced as a one-frame flash of an open mouth
                # a few hundred ms into idle (measured at +266 ms).
                with self._prompt_condition:
                    self._prompt_queue.clear()
                    self._rendered_frames.clear()
                if self._pending_segment is not None:
                    # Song segment in flight: end the internal turn (video
                    # idles during playback) but keep the browser's speaking
                    # envelope open — the continuation reply consumes the
                    # hold instead of emitting a fresh speaking_start.
                    self._segment_speaking_hold = True
                else:
                    self._send_dc({"event": "speaking_done"})
                logger.info("[Session] GPT audio drained")

    def _on_gpt_tool_call(self, event: dict):
        # GA usually omits `name` here — _maybe_emit_tool_call no-ops without
        # it and the response.output_item.done path (which carries the name)
        # does the real emit. The dedupe keeps deployments that send both
        # single-emitting.
        self._maybe_emit_tool_call(event.get("name"), event.get("call_id"), event.get("arguments") or "{}")

    def _on_output_item_done(self, event: dict):
        item = event.get("item") or {}
        if item.get("type") == "function_call":
            self._maybe_emit_tool_call(item.get("name"), item.get("call_id"), item.get("arguments") or "{}")

    def _maybe_emit_tool_call(self, name: Optional[str], call_id: Optional[str], arguments: str):
        if not name or not call_id or call_id in self._emitted_tool_call_ids:
            return
        self._emitted_tool_call_ids.add(call_id)
        try:
            parsed_args = json.loads(arguments)
        except (TypeError, ValueError):
            parsed_args = {"raw": arguments}
        self._current_turn_tool_calls.append({
            "name": name, "args": parsed_args, "callId": call_id,
        })
        if name == "request_selection" and self._reject_invalid_selection(call_id, arguments):
            return
        if name == "play_song" and self._try_intercept_segment_call(call_id, arguments):
            return
        if name == "submit_probe_result" and self._handle_probe_call(call_id, parsed_args):
            return
        self._coverage.on_tool_call_emitted(name, call_id, arguments)
        self._tool_result_tracker.on_tool_call_emitted(
            call_id, name, self._exchange_number + 1
        )
        if name == "play_song":
            arguments = self._enrich_play_song_meta(arguments)
        self._send_dc({"event": "tool_call", "tool_call_id": call_id, "name": name, "arguments": arguments})
        asyncio.create_task(self._wait_and_send_tool_result(call_id))

    def _reject_invalid_selection(self, call_id: str, arguments: str) -> bool:
        rejection = check_selection_rejection(
            arguments, self._selection_slug_enum
        )
        if not rejection:
            return False
        logger.warning(
            f"[Session] Rejected invalid request_selection: "
            f"reason={rejection.reason} "
            f"correctSlug={rejection.correct_slug!r} "
            f"options={rejection.options!r}"
        )
        self.emit_debug("request_selection_rejected", {
            "reason": rejection.reason,
            "correctSlug": rejection.correct_slug,
            "options": rejection.options,
        })
        asyncio.create_task(
            self.gpt_rt.send_tool_result(call_id, rejection.error_json)
        )
        return True

    def _handle_probe_call(self, call_id: str, parsed_args: dict) -> bool:
        if not hasattr(self, "_session_router") or self._session_router is None:
            return False
        asyncio.create_task(self._execute_probe_action(call_id, parsed_args))
        return True

    async def _execute_probe_action(self, call_id: str, parsed_args: dict):
        from relay.session_router import ContinueAction, ErrorAction, RouteAction

        action = await self._session_router.handle_probe(
            call_id=call_id,
            arguments=parsed_args,
            exchange_number=self._exchange_number,
        )
        if isinstance(action, (ContinueAction, ErrorAction)):
            tag = "continue" if isinstance(action, ContinueAction) else "error"
            logger.info(f"[Session] probe {tag}: probeIndex={parsed_args.get('probeIndex')}")
            await self.gpt_rt.send_tool_result(call_id, action.tool_result)
            return
        # RouteAction: tool result WITHOUT response.create, then session.update.
        # Wait for the model's current response to finish before inserting items.
        while self.gpt_rt._response_active:
            await asyncio.sleep(0.01)
        await self.gpt_rt._send({
            "type": "conversation.item.create",
            "item": {"type": "function_call_output", "call_id": call_id, "output": action.tool_result},
        })
        instructions = action.instructions
        tools = action.tools
        logger.info(
            f"[Session] RouteAction: level={action.assessed_level} "
            f"path={action.path} degraded={action.degraded} "
            f"instructionsReady={bool(instructions)} "
            f"tools={len(tools or [])} objects={len(action.objects)}"
        )
        if not instructions:
            logger.info("[Session] instructionsReady=false — refetching instructions")
            data = await self.taiboli_bridge.fetch_instructions()
            instructions = data["instructions"]
            tools = data.get("tools") or []
            logger.info(
                f"[Session] Refetched: instructions={len(instructions)} chars, "
                f"tools={[t.get('name', '?') for t in tools if isinstance(t, dict)]}"
            )
        confirmed = await self.gpt_rt.send_session_update(instructions, tools)
        if not confirmed:
            logger.error(f"[Session] Routing session.update timed out: path={action.path}")
        # Kick the model with a hidden user message, matching the greeting
        # pattern.  A bare response.create after a massive session.update
        # reliably fails (status=failed, 0 tokens).  The user message gives
        # the model a conversation turn to anchor its first Phase-3 response.
        await self.gpt_rt.send_user_text(
            "Your instructions have been updated — follow them now."
        )
        logger.info(f"[Session] Routed and triggered: level={action.assessed_level} path={action.path} confirmed={confirmed}")

    def _fire_coverage_flips(self, flips: list) -> None:
        """Fire-and-forget coverage flips. Tracked for drain before /end."""
        if not flips or not self.taiboli_bridge:
            return
        for flip in flips:
            task = asyncio.create_task(self._do_flip(flip))
            self._pending_flips.add(task)
            task.add_done_callback(self._pending_flips.discard)

    async def _do_flip(self, flip: "ContentFlip") -> None:
        try:
            content_id = flip.content_id
            if flip.content_type == "OBJECT":
                content_id = self._slug_to_object_id.get(flip.content_id, "")
                if not content_id:
                    logger.warning(
                        f"[Session] Coverage flip skipped — no objectId for slug "
                        f"{flip.content_id!r}"
                    )
                    return
            await self.taiboli_bridge.flip_content(
                flip.content_type,
                content_id,
                flip.event_metadata,
            )
        except TaiboliBridgeError as e:
            logger.warning(
                f"[Session] Coverage flip failed: "
                f"type={flip.content_type} id={flip.content_id} "
                f"status={e.status}"
            )
        except Exception as e:
            logger.warning(
                f"[Session] Coverage flip error: "
                f"type={flip.content_type} id={flip.content_id} "
                f"{type(e).__name__}: {str(e)[:120]}"
            )

    def _fire_late_patch(self, late: "LateToolResult") -> None:
        """Fire-and-forget patch for a late tool result."""
        if not self.taiboli_bridge:
            return
        task = asyncio.create_task(self._do_late_patch(late))
        self._pending_flips.add(task)
        task.add_done_callback(self._pending_flips.discard)

    async def _do_late_patch(self, late: "LateToolResult") -> None:
        try:
            try:
                parsed_result = json.loads(late.result)
            except (TypeError, ValueError):
                parsed_result = {"raw": late.result}
            await self.taiboli_bridge.patch_tool_result(
                late.exchange_number,
                late.name,
                late.call_id,
                parsed_result,
            )
            logger.info(
                f"[Session] Late tool result patched: "
                f"exchange={late.exchange_number} call_id={late.call_id}"
            )
        except TaiboliBridgeError as e:
            logger.warning(
                f"[Session] Late tool result patch failed: "
                f"exchange={late.exchange_number} call_id={late.call_id} "
                f"status={e.status}"
            )
        except Exception as e:
            logger.warning(
                f"[Session] Late tool result patch error: "
                f"exchange={late.exchange_number} call_id={late.call_id} "
                f"{type(e).__name__}: {str(e)[:120]}"
            )

    def _inject_turn_clock(self) -> None:
        """Inject a hidden clock message into the conversation after response.done."""
        if not self._runtime_clock:
            return
        clock_text = render_turn_clock_block(
            self._runtime_clock,
            self._exchange_number + 1,
            last_user_turn_at=self._last_user_turn_at,
        )
        asyncio.create_task(self._send_clock_item(clock_text))

    async def _send_clock_item(self, text: str) -> None:
        try:
            await self.gpt_rt.send_raw({
                "type": "conversation.item.create",
                "item": {
                    "type": "message",
                    "role": "user",
                    "content": [{"type": "input_text", "text": text}],
                },
            })
        except Exception as e:
            logger.warning(f"[Session] Clock injection failed: {type(e).__name__}: {str(e)[:80]}")

    def _enrich_play_song_meta(self, arguments: str) -> str:
        return relay_protocol.enrich_play_song_arguments(arguments, self._song_metadata)

    def _try_intercept_segment_call(self, call_id: str, arguments_json: str) -> bool:
        """Intercept a play_song segment/singalong call: resolve the segment
        locally, send taiboli.play_segment to the browser, and hold the tool
        call open until taiboli.segment_finished. Non-segment calls (and songs
        without lyrics data) fall through to the generic tool_call relay."""
        planned = relay_protocol.plan_segment_intercept(self._song_lyrics, call_id, arguments_json)
        if planned is None:
            return False
        pending, payload = planned
        self._pending_segment = pending
        self._mic_muted_for_segment = True
        self._cancel_segment_timer()
        self._segment_timer_handle = asyncio.get_event_loop().call_later(
            45.0, self._on_segment_timeout, call_id
        )
        self._send_dc(payload)
        logger.info(
            f"[Session] Intercepted play_song segment mode: {pending.song_id} "
            f"segment {pending.segment.get('index')} (call {call_id})"
        )
        return True

    def _handle_segment_finished(self, call_id: str):
        """Browser finished segment playback — send the lyrics tool result to
        Azure to resume the conversation. Mismatched/missing callIds are
        ignored (relay parity)."""
        pending = self._pending_segment
        if not pending or pending.call_id != call_id:
            return
        self._cancel_segment_timer()
        self._mic_muted_for_segment = False
        output = relay_protocol.build_segment_finished_output(pending)
        self._pending_segment = None
        asyncio.create_task(self.gpt_rt.send_tool_result(call_id, output))
        self._fire_coverage_flips(
            self._coverage.on_segment_finished(
                pending.song_id, pending.segment
            )
        )
        logger.info(
            f"[Session] Segment finished — tool result sent ({pending.song_id} "
            f"segment {pending.segment.get('index')}, next={pending.next_segment})"
        )

    def _on_segment_timeout(self, call_id: str) -> None:
        """45s timeout: browser never sent segment_finished."""
        self._segment_timer_handle = None
        pending = self._pending_segment
        if not pending or pending.call_id != call_id:
            return
        logger.warning(
            f"[Session] Segment playback timed out — releasing tool call "
            f"({pending.song_id} segment {pending.segment.get('index')}, call {call_id})"
        )
        self._pending_segment = None
        self._mic_muted_for_segment = False
        timeout_result = json.dumps({
            "success": False,
            "error": "segment_playback_timeout",
            "songId": pending.song_id,
            "segment": {"index": pending.segment.get("index")},
        })
        asyncio.create_task(self.gpt_rt.send_tool_result(call_id, timeout_result))

    def _cancel_segment_timer(self) -> None:
        if self._segment_timer_handle is not None:
            self._segment_timer_handle.cancel()
            self._segment_timer_handle = None

    async def _wait_and_send_tool_result(self, call_id: str):
        result = await self._wait_for_tool_result(call_id)
        await self.gpt_rt.send_tool_result(call_id, result)

    async def _wait_for_tool_result(self, tool_call_id: str, timeout: float = 60.0) -> str:
        future = self._loop.create_future()
        self._pending_tool_results[tool_call_id] = future
        try:
            return await asyncio.wait_for(future, timeout=timeout)
        except asyncio.TimeoutError:
            return json.dumps({"error": "Tool execution timed out"})
        finally:
            self._pending_tool_results.pop(tool_call_id, None)

    def _receive_tool_result(self, tool_call_id: str, content: str):
        future = self._pending_tool_results.get(tool_call_id)
        if future and not future.done():
            future.set_result(content)
        try:
            parsed_result = json.loads(content)
        except (TypeError, ValueError):
            parsed_result = {"raw": content}
        tool_name = None
        for tc in self._current_turn_tool_calls:
            if tc.get("callId") == tool_call_id:
                tool_name = tc["name"]
                break
        self._current_turn_tool_results.append({
            "name": tool_name or "unknown",
            "result": parsed_result,
            "callId": tool_call_id,
        })
        self._fire_coverage_flips(
            self._coverage.on_tool_result(tool_call_id)
        )
        late = self._tool_result_tracker.on_tool_result(tool_call_id, content)
        if late:
            self._fire_late_patch(late)

    def _barge_in_corroborated(self) -> bool:
        """Second opinion on an upstream speech_started, from the local gate.

        Deliberately biased toward AGREEING. The costs are asymmetric: a false
        veto breaks real barge-in and undermines the core interaction, whereas
        a false agreement is merely the status quo — which the pending_cancel
        watchdog already made survivable. So anything uncertain corroborates:
        feature off, gate disabled, or not enough windows seen yet.

        The look-back window is generous (1.5 s default) because upstream
        speech_started lags the audio that caused it by network RTT plus the
        service's own prefix padding, and our gate runs a further pre_roll_ms
        behind. A tight window would veto genuine barge-ins.
        """
        mode = self.config.barge_in_corroboration
        if mode == "off":
            return True
        gate = self.mic_gate
        if not gate.enabled or gate.windows_total < MIC_GATE_CORROBORATION_WARMUP_WINDOWS:
            return True
        window_ms = self.config.barge_in_corroboration_ms
        if mode == "near":
            # Only *nearby* speech counts, so a voice in the next room stops
            # cutting the tutor off. Falls back to any-speech when proximity
            # tracking isn't running.
            if gate.proximity_mode == mic_gate.PROXIMITY_OFF:
                return gate.saw_speech_within(window_ms)
            return gate.saw_near_speech_within(window_ms)
        return gate.saw_speech_within(window_ms)

    def _on_user_speech_started(self, event: dict):
        self._turn_started_at = time.time()
        self._speech_started_count += 1
        if not self._barge_in_corroborated():
            # The local VAD saw nothing speech-like, so treat the upstream
            # speech_started as noise: leave playback and rendering alone.
            self._barge_ins_vetoed += 1
            self._vetoed_speech_started = True
            logger.info(
                f"[Session] vetoed upstream speech_started — local gate saw no "
                f"{'near ' if self.config.barge_in_corroboration == 'near' else ''}speech "
                f"in the last {self.config.barge_in_corroboration_ms} ms "
                f"({self._barge_ins_vetoed} vetoed this session)"
            )
            self.emit_debug("relay_decision", {
                "action": "barge_in_vetoed",
                "vetoed": self._barge_ins_vetoed,
            })
            return
        self._send_dc({"event": "user_speech_started"})
        # Azure's semantic_vad owns interruption — no response.cancel here
        # (the server-side cancel was the relay's reply-cutoff bug, D5). The
        # avatar still flushes its local playback/render pipelines so speech
        # stops promptly; the cancelled response's own response.done then
        # ends the turn with a quiet llm_done + speaking_done.
        if self.is_speaking:
            self._flush_playback_buffers()
            self._pending_cancel = True
            self._pending_cancel_reason = "vad"
            self._pending_cancel_deadline = (
                time.monotonic() + self.config.pending_cancel_grace_ms / 1000.0
            )

    def _on_user_speech_stopped(self, event: dict):
        if self._vetoed_speech_started:
            # Suppress the pair, not just the start — the browser (and
            # taiboli-app's frontend) may hold state keyed on matching
            # start/stop events, and an unpaired stop would desync it.
            self._vetoed_speech_started = False
            return
        self._send_dc({"event": "user_speech_stopped"})

    def _on_input_transcript_delta(self, event: dict):
        delta = event.get("delta", "")
        if delta:
            self._send_dc({"event": "input_transcript_delta", "text": delta})

    def _on_input_transcript(self, event: dict):
        transcript = event.get("transcript") or ""
        self._last_user_turn_at = time.time()
        self._pairer.on_input_transcript(transcript)
        self._send_dc({"event": "input_transcript", "text": transcript})

    def _on_gpt_error(self, event: dict):
        error = event.get("error") or {}
        message = error.get("message") or str(event)
        # "Cancellation failed: no active response found" is a benign race:
        # send_tool_result sees _response_active=True but the response.done
        # is already in-flight. The pending_response_create path recovers.
        if "no active response" in message.lower():
            logger.debug(f"[AzureRT] Benign cancel race: {message}")
        else:
            logger.error(f"[AzureRT] Error: {message}")
        self._send_dc({"event": "llm_error", "error": message})

    def _retry_session_update_if_silent(self):
        """Silent-rejection fallback: no error, no session.updated, just
        nothing. Drops the experimental fields and resends so the session at
        least runs with the relay-parity config."""
        if not self.is_running or self.gpt_rt._session_updated_seen:
            return
        asyncio.create_task(
            self.gpt_rt._strip_experimental_and_resend(
                f"no session.updated within {SESSION_UPDATE_RETRY_SECONDS}s"
            )
        )

    def _on_session_updated(self, event: dict):
        # Azure has applied our session.update — safe to greet now (D5).
        self._send_greeting_once()

    def _send_greeting_once(self):
        """Send the D5 greeting once — via session.updated if Azure confirms
        in time, or via the fallback timer otherwise. No-op past the first
        call and for standalone (non-taiboli) sessions."""
        if not self.greeting_enabled or self._greeting_sent:
            return
        # The greeting is the first thing the learner hears, and it fires on
        # session.updated — which can beat the render thread's one-off CUDA warm
        # (~0.8 s). Greeting into a cold thread is exactly the freeze this whole
        # path exists to avoid, so hold briefly. Bounded: past the deadline we
        # greet regardless rather than sit silent if warmup never signals.
        if not self._render_warm.is_set() and time.monotonic() < self._greeting_warm_deadline:
            self._loop.call_later(0.05, self._send_greeting_once)
            return
        # Open the mic gate before the response.create is even queued so the
        # ordering matches the relay (greetingSent flips first).
        self._greeting_sent = True
        if self._greeting_fallback_handle is not None:
            self._greeting_fallback_handle.cancel()
            self._greeting_fallback_handle = None
        # Feed the greeting user message into the pairer so the model's
        # greeting response gets persisted as an exchange instead of being
        # dropped as an assistant-only turn. Matches the fake user message
        # injected via conversation.item.create in send_greeting.
        self._pairer.on_user_text(relay_protocol.GREETING_USER_MESSAGE)
        self._turn_started_at = time.time()
        asyncio.create_task(self.gpt_rt.send_greeting())
        elapsed = (time.monotonic() - self._started_mono) * 1000
        logger.info(f"[Session] Greeting sent ({elapsed:.0f} ms after session.start)")
        self.emit_debug("relay_decision", {"action": "greeting_sent"})

    def _on_azure_raw_event(self, event: dict):
        # Raw passthrough for the playground debug drawer. The relay gates
        # this per-user; we only have the env flag, so redact the one payload
        # that carries the full system prompt (session config echoes).
        if not self.config.session_debug:
            return
        raw = event
        if event.get("type") in ("session.created", "session.updated"):
            session_obj = event.get("session")
            if isinstance(session_obj, dict) and session_obj.get("instructions"):
                raw = {**event, "session": {**session_obj, "instructions": "<redacted>"}}
        self.emit_debug("azure_event", {"raw": raw})

    def _on_realtime_closed(self):
        # The upstream Realtime socket died mid-session. Tear the whole peer
        # down so the browser sees a retryable failure instead of a zombie
        # avatar idling forever (relay parity: azure close/error → cleanup).
        if not self.is_running:
            return
        logger.error("[Session] Realtime connection lost — closing session")
        if self.on_fatal:
            try:
                self.on_fatal()
            except Exception as e:
                logger.error(f"[Session] on_fatal handler failed: {e}")
        else:
            asyncio.create_task(self.close(reason="technical_error"))

    def emit_debug(self, dtype: str, payload: Optional[dict] = None) -> bool:
        """Single emission point for all debug.* data channel messages (D6
        analog). Env-gated via SESSION_DEBUG; dropped when the channel is
        missing, closed, or backpressured. Callers never pass brief content
        or full instructions."""
        if not self.config.session_debug:
            return False
        dc = self.data_channel
        if dc is None or dc.readyState != "open":
            return False
        if getattr(dc, "bufferedAmount", 0) > relay_protocol.DEBUG_BUFFERED_AMOUNT_LIMIT:
            return False
        try:
            dc.send(json.dumps({"event": f"debug.{dtype}", **(payload or {})}, ensure_ascii=False, default=str))
            return True
        except Exception as e:
            logger.warning(f"[Session] Debug DC send failed: {e}")
            return False

    def flush_pending_debug(self):
        """Emit the deferred session_config debug event once the data channel
        exists — unlike the relay, Azure is connected before the browser
        channel opens, so the payload is staged in start()."""
        if self._debug_session_config_payload is None:
            return
        if self.emit_debug("session_config", self._debug_session_config_payload):
            self._debug_session_config_payload = None

    def _send_dc(self, data: dict):
        if self.data_channel and self.data_channel.readyState == "open":
            try:
                self.data_channel.send(json.dumps(data))
            except Exception as e:
                logger.warning(f"[Session] Data channel send failed: {e}")

    def _flush_playback_buffers(self):
        """Stop in-flight avatar speech on a VAD barge-in: clear the playback
        buffer and lip-sync pipeline so the tutor goes quiet promptly. Leaves
        the mic input queue alone — on a barge-in it holds the learner's own
        utterance. Does not emit speaking_done: that arrives via the cancelled
        response's response.done drain, matching the relay's event order."""
        drain_active = self._speaking_done_task and not self._speaking_done_task.done()
        if drain_active:
            self._speaking_done_task.cancel()
        if self.audio_track:
            self.audio_track.clear_audio()
        # A barge-in supersedes the old turn; its closing animation is stale.
        self._opening_frames.clear()
        self._closing_frames.clear()
        self._closing_hold_until = 0.0
        with self._prompt_condition:
            self._prompt_queue.clear()
            self._rendered_frames.clear()
            self._prompt_condition.notify_all()
        self._feature_generation += 1
        self._reset_feature_state()
        self._current_turn_tool_calls.clear()
        self._current_turn_tool_results.clear()
        if drain_active and self.is_speaking:
            # The response already completed (its tail was draining), so no
            # response.done(cancelled) will arrive to close the turn — end it
            # here or is_speaking wedges True and the next turn never resets.
            self.is_speaking = False
            if self._pending_segment is not None:
                self._segment_speaking_hold = True
            else:
                self._send_dc({"event": "speaking_done"})

    def _clear_audio_buffers(self):
        """Full stop for an explicit browser interrupt (and teardown): flush
        playback AND the queued mic audio, end the speaking turn immediately."""
        if self._speaking_done_task and not self._speaking_done_task.done():
            self._speaking_done_task.cancel()
        if self.audio_track:
            self.audio_track.clear_audio()
        # A barge-in supersedes the old turn; its closing animation is stale.
        self._opening_frames.clear()
        self._closing_frames.clear()
        self._closing_hold_until = 0.0
        while True:
            try:
                self._input_audio_queue.get_nowait()
                self._input_audio_queue.task_done()
            except asyncio.QueueEmpty:
                break
        with self._prompt_condition:
            self._prompt_queue.clear()
            self._rendered_frames.clear()
            self._prompt_condition.notify_all()
        self._feature_generation += 1
        self._reset_feature_state()
        self._pending_segment = None
        self._mic_muted_for_segment = False
        self._cancel_segment_timer()
        self._segment_speaking_hold = False
        if self.is_speaking:
            self.is_speaking = False
            # Skip the cancelled response's stale audio deltas (relay parity).
            # This path DID send response.cancel, so response.done(cancelled)
            # arrives promptly and the grace deadline never expires — it is set
            # only so the watchdog can't fire on a genuinely cancelled turn.
            self._pending_cancel = True
            self._pending_cancel_reason = "interrupt"
            self._pending_cancel_deadline = (
                time.monotonic() + self.config.pending_cancel_grace_ms / 1000.0
            )
            self._send_dc({"event": "speaking_done"})

    async def close(self, reason: str = "abandoned"):
        self.is_running = False
        # start() may still be mid-connect when the peer goes away (it now runs
        # concurrently with SDP negotiation). Cancel and drain it first so the
        # upstream socket below is closed no matter which order they land in.
        if self.start_task is not None and not self.start_task.done():
            self.start_task.cancel()
            with contextlib.suppress(asyncio.CancelledError, Exception):
                await self.start_task
        self._feature_generation += 1
        self._pending_segment = None
        self._mic_muted_for_segment = False
        self._segment_speaking_hold = False
        self._cancel_segment_timer()
        if self._greeting_fallback_handle is not None:
            self._greeting_fallback_handle.cancel()
            self._greeting_fallback_handle = None
        self._pairer.close(partial_assistant=self._assistant_final_text())
        if self._speaking_done_task and not self._speaking_done_task.done():
            self._speaking_done_task.cancel()
        if self._input_audio_sender_task and not self._input_audio_sender_task.done():
            self._input_audio_sender_task.cancel()
        if self.video_track:
            self.video_track.stop()
        if self.audio_track:
            self.audio_track.stop()
        with self._feature_condition:
            self._feature_worker_stop = True
            self._feature_condition.notify_all()
        if self._feature_worker.is_alive():
            self._feature_worker.join(timeout=2.0)
        with self._prompt_condition:
            self._render_worker_stop = True
            self._prompt_condition.notify_all()
        if self._render_worker.is_alive():
            self._render_worker.join(timeout=2.0)
        if self._pending_exchange_tasks:
            await asyncio.gather(*list(self._pending_exchange_tasks), return_exceptions=True)
        if self._pending_flips:
            await asyncio.gather(*list(self._pending_flips), return_exceptions=True)
        self._tool_result_tracker.clear()
        if self._session_router is not None:
            await self._session_router._client.close()
        if self.taiboli_bridge and not self._ended:
            self._ended = True
            for attempt in range(3):
                try:
                    await self.taiboli_bridge.end_session(reason, self._first_audio_latency_ms)
                    break
                except Exception as e:
                    logger.error(f"[Taiboli] End-session call failed (attempt {attempt + 1}): {e}")
                    if attempt < 2:
                        await asyncio.sleep(0.5 * (attempt + 1))
        await self.gpt_rt.close()
        self.audio_executor.shutdown(wait=False)
        self.render_executor.shutdown(wait=False)


class WebRTCServer:
    def __init__(self, config: ServerConfig):
        self.config = config
        # BlankAvatarEngine is a full stand-in, so nothing downstream of here
        # (sessions, tracks, /health, /metrics) has to know which one it got.
        self.engine = BlankAvatarEngine(config) if config.blank_avatar else MuseTalkEngine(config)
        self.sessions = {}
        self.pcs = set()
        self.ice_provider = IceServerProvider(env_prefix="AVATAR")

    async def initialize(self):
        loop = asyncio.get_running_loop()
        await loop.run_in_executor(None, self.engine.initialize)

    async def handle_offer(self, request: web.Request) -> web.Response:
        try:
            params = await request.json()
        except json.JSONDecodeError:
            return _json_response(400, {"error": "Invalid JSON body"})

        session_id = _parse_session_id(params)
        request_id = params.get("requestId") or request.headers.get("x-request-id") or str(uuid.uuid4())
        if not params.get("sdp") or params.get("type") != "offer":
            return _json_response(400, {"error": "Valid WebRTC offer is required"})

        taiboli_bridge = None
        pre_opened_ws = None
        raw_system_prompt = params.get("systemPrompt") or params.get("system_prompt")
        system_prompt = str(raw_system_prompt).strip() if raw_system_prompt is not None else ""
        if not system_prompt:
            system_prompt = self.config.system_prompt

        if session_id:
            clerk_user_id, clerk_session_id = _read_trusted_clerk_identity(params, request)
            if not clerk_user_id:
                return _json_response(401, {"error": "clerkUserId is required for sessionId-backed sessions"})
            taiboli_bridge = TaiboliBridgeClient(
                self.config,
                session_id,
                clerk_user_id,
                clerk_session_id=clerk_session_id,
                request_id=request_id,
            )
            pre_connect_task = asyncio.create_task(_preconnect_azure_ws(self.config))
            try:
                taiboli_session = await taiboli_bridge.fetch_instructions()
            except TaiboliBridgeError as e:
                pre_connect_task.cancel()
                logger.error(
                    "[Taiboli] Instruction fetch failed: "
                    f"status={e.status} "
                    f"session_id={session_id} "
                    f"clerk_user_id={taiboli_bridge._safe_clerk_user_id()} "
                    f"request_id={request_id} "
                    f"message={e.message!r}"
                )
                return _json_response(500, {"error": INTERNAL_SERVER_ERROR})
            except Exception as e:
                pre_connect_task.cancel()
                logger.error(
                    "[Taiboli] Instruction fetch crashed: "
                    f"session_id={session_id} "
                    f"clerk_user_id={taiboli_bridge._safe_clerk_user_id()} "
                    f"request_id={request_id} "
                    f"error={type(e).__name__}: {e}"
                )
                return _json_response(500, {"error": INTERNAL_SERVER_ERROR})
            system_prompt = taiboli_session["instructions"]
            pre_opened_ws = await pre_connect_task

        # Taiboli sessions run with exactly the tools the brief produced
        # (possibly none — relay parity); the greeting is personalised from
        # the brief's student snapshot; exchange numbering continues from the
        # session's recorded history so a reconnect doesn't restart at 1.
        session_tools = None
        initial_exchange_number = 0
        runtime_clock = None
        if taiboli_bridge:
            session_tools = taiboli_session.get("tools") or []
            brief = taiboli_session.get("brief") or {}
            recent = (taiboli_session.get("history") or {}).get("recentExchanges") or []
            initial_exchange_number = max(
                (int(e.get("exchangeNumber") or 0) for e in recent if isinstance(e, dict)),
                default=0,
            )
            runtime_clock = RuntimeClockConfig.from_dict(
                taiboli_session.get("runtimeClock")
            )

        slug_to_object_id = {}
        song_lyrics: Dict[str, dict] = {}
        song_metadata: Dict[str, dict] = {}
        if taiboli_bridge:
            for obj in taiboli_session.get("sessionObjects") or []:
                if isinstance(obj, dict) and obj.get("conceptSlug") and obj.get("objectId"):
                    slug_to_object_id[obj["conceptSlug"]] = obj["objectId"]
            if slug_to_object_id:
                logger.info(f"[Objects] Resolved {len(slug_to_object_id)} slug→objectId mappings")
            else:
                logger.warning("[Objects] No sessionObjects in instructions response — slug→UUID resolution unavailable")
            song_lyrics, song_metadata = relay_protocol.split_song_metadata(
                taiboli_session.get("songMetadata")
            )
            if song_lyrics:
                logger.info(f"[Songs] Session has {len(song_lyrics)} songs with lyrics, {len(song_metadata)} total")

        offer = RTCSessionDescription(sdp=params["sdp"], type=params["type"])
        try:
            configured_servers = await self.ice_provider.get_ice_servers()
            ice_servers = [
                RTCIceServer(
                    urls=srv["urls"],
                    username=srv.get("username"),
                    credential=srv.get("credential")
                )
                for srv in configured_servers
            ]
        except Exception as e:
            logger.warning(f"[Server] Failed to fetch ICE servers from provider: {e}. Falling back to default STUN.")
            ice_servers = [RTCIceServer(urls=DEFAULT_ICE_SERVERS[0]["urls"])]
        logger.info(f"[Server] ICE servers configured: {len(ice_servers)}")
        pc = RTCPeerConnection(configuration=RTCConfiguration(iceServers=ice_servers))
        pc_id = id(pc)
        self.pcs.add(pc)
        session = AvatarSession(
            self.engine,
            self.config,
            taiboli_bridge=taiboli_bridge,
            system_prompt=system_prompt,
            tools=session_tools,
            greeting_enabled=taiboli_bridge is not None,
            initial_exchange_number=initial_exchange_number,
            song_lyrics=song_lyrics,
            song_metadata=song_metadata,
            runtime_clock=runtime_clock,
            slug_to_object_id=slug_to_object_id,
        )
        session.on_fatal = lambda: asyncio.create_task(
            self._cleanup_peer(pc, pc_id, reason="technical_error")
        )
        # Initialize probe routing if session has submit_probe_result tool
        if taiboli_bridge and session_tools:
            has_probe_tool = any(
                t.get("name") == "submit_probe_result"
                for t in session_tools if isinstance(t, dict)
            )
            if has_probe_tool:
                from relay.probe_client import ProbeClient, ProbeClientConfig
                from relay.probe_tracker import ProbeTracker
                from relay.session_router import SessionRouter

                probe_cfg = ProbeClientConfig(
                    base_url=self.config.taiboli_api_base_url,
                    api_key=self.config.taiboli_avatar_api_key,
                    clerk_user_id=taiboli_bridge.clerk_user_id,
                    session_id=session_id,
                )
                probe_client = ProbeClient(probe_cfg)
                await probe_client.start()
                session._session_router = SessionRouter(probe_client, ProbeTracker())
        self.sessions[pc_id] = session

        @pc.on("connectionstatechange")
        async def on_connectionstatechange():
            logger.info(f"[Server] Connection state: {pc.connectionState}")
            if pc.connectionState == "failed":
                await self._cleanup_peer(pc, pc_id, reason="technical_error")
            elif pc.connectionState == "closed":
                await self._cleanup_peer(pc, pc_id, reason="abandoned")

        @pc.on("iceconnectionstatechange")
        async def on_iceconnectionstatechange():
            logger.info(f"[Server] ICE connection state: {pc.iceConnectionState}")

        @pc.on("icegatheringstatechange")
        async def on_icegatheringstatechange():
            logger.info(f"[Server] ICE gathering state: {pc.iceGatheringState}")

        @pc.on("datachannel")
        def on_datachannel(channel):
            logger.info(f"[Server] Data channel established: {channel.label}")
            if channel.label != "audio":
                session.data_channel = channel
                session.flush_pending_debug()

            @channel.on("message")
            def on_message(message):
                try:
                    if isinstance(message, bytes):
                        session.queue_user_audio_bytes(message)
                        return
                    try:
                        data = json.loads(message)
                    except json.JSONDecodeError as e:
                        logger.error(f"[Server] Failed to parse data channel message as JSON: {e}. Message: {_truncate_for_log(str(message))}")
                        return
                    # Taiboli custom events and raw Realtime passthrough are
                    # type-keyed, not event-keyed.
                    msg_type = data.get("type")
                    if msg_type == "taiboli.segment_finished":
                        session._handle_segment_finished(str(data.get("callId") or ""))
                        return
                    if msg_type in ("conversation.item.create", "response.create"):
                        # The browser speaks raw Realtime protocol for
                        # request_selection outcomes and structured text —
                        # forward verbatim, and feed the user text into
                        # transcript pairing.
                        if msg_type == "conversation.item.create":
                            text = relay_protocol.extract_user_input_text(data)
                            if text:
                                session.record_user_text(text)
                        asyncio.create_task(session.gpt_rt.send_raw(data))
                        return
                    event = data.get("event")
                    if event == "set_system_prompt":
                        if session.taiboli_bridge:
                            channel.send(json.dumps({
                                "event": "system_prompt_rejected",
                                "error": "System prompts are fetched from Taiboli for sessionId-backed sessions.",
                            }))
                        else:
                            prompt = data.get("prompt", "")
                            if prompt:
                                session.system_prompt = prompt
                                asyncio.create_task(session.gpt_rt.update_system_prompt(prompt))
                                channel.send(json.dumps({"event": "system_prompt_ack"}))
                    elif event == "audio_stream_config":
                        sample_rate = int(data.get("sample_rate") or AUDIO_SAMPLE_RATE)
                        session.set_input_audio_sample_rate(sample_rate)
                        channel.send(json.dumps({"event": "audio_stream_config_ack", "sample_rate": sample_rate}))
                    elif event == "user_audio":
                        audio_b64 = data.get("audio", "")
                        sample_rate = int(data.get("sample_rate") or AUDIO_SAMPLE_RATE)
                        if audio_b64:
                            try:
                                decoded_audio = base64.b64decode(audio_b64)
                            except Exception as e:
                                logger.error(f"[Server] Failed to base64 decode user_audio: {e}")
                                return
                            session.queue_user_audio_bytes(decoded_audio, sample_rate)
                    elif event == "user_message":
                        text = data.get("text", "")
                        if text:
                            channel.send(json.dumps({"event": "user_message_ack", "text": text[:50]}))
                            asyncio.create_task(session.send_user_text(text))
                    elif event == "message":
                        text = data.get("text", "")
                        if text:
                            asyncio.create_task(session.send_user_text(text))
                            channel.send(json.dumps({"event": "queued", "text": text[:50]}))
                    elif event == "interrupt":
                        asyncio.create_task(session.gpt_rt.interrupt())
                        session._clear_audio_buffers()
                    elif event == "tool_result":
                        tool_call_id = data.get("tool_call_id", "")
                        content = data.get("content", "{}")
                        if tool_call_id:
                            session._receive_tool_result(tool_call_id, content)
                    elif event == "status":
                        channel.send(json.dumps({
                            "event": "status",
                            "is_speaking": session.is_speaking,
                            "total_frames": session.total_frames,
                            "avatar": self.engine.avatar.avatar_id if self.engine.avatar else None,
                        }))
                except Exception as e:
                    logger.error(f"[Server] Message error processing event {event if 'event' in locals() else 'unknown'}: {e}")

        video_track = AvatarVideoTrack(session)
        audio_track = AvatarAudioTrack(session)
        session.video_track = video_track
        session.audio_track = audio_track

        # Bring the Realtime backend up CONCURRENTLY with SDP negotiation instead
        # of serialising them. The upstream connect is a WebSocket handshake plus a
        # session.update round-trip; making the browser wait for it before it even
        # receives an answer delays ICE and therefore first video for every session.
        # Nothing here needs the backend yet: the mic is gated until the greeting is
        # sent (_greeting_sent) and the greeting itself fires off session.updated or
        # the fallback timer.
        session_start_task = asyncio.create_task(session.start(pre_opened_ws=pre_opened_ws))
        # close() cancels this if teardown beats the connect, so a peer that dies
        # during negotiation can't leave an orphaned upstream socket behind.
        session.start_task = session_start_task

        def _on_session_start_done(task: asyncio.Task):
            if task.cancelled():
                return
            err = task.exception()
            if err is None:
                return
            # The answer has already gone out, so we can no longer fail the HTTP
            # request. Tear the peer down through the same path a mid-session
            # backend death uses, so the browser sees a clean retryable failure.
            logger.error(f"[Server] Azure RT session failed after answer: {err}")
            asyncio.create_task(self._cleanup_peer(pc, pc_id, reason="technical_error"))

        session_start_task.add_done_callback(_on_session_start_done)

        await pc.setRemoteDescription(offer)
        for transceiver in pc.getTransceivers():
            if transceiver.kind == "video" and transceiver.sender.track is None:
                transceiver.sender.replaceTrack(video_track)
                transceiver.direction = "sendrecv"
            elif transceiver.kind == "audio" and transceiver.sender.track is None:
                transceiver.sender.replaceTrack(audio_track)
                transceiver.direction = "sendrecv"
        _prefer_vp8_video_codec(pc)
        answer = await pc.createAnswer()
        await pc.setLocalDescription(answer)
        response_payload = {"sdp": pc.localDescription.sdp, "type": pc.localDescription.type, "requestId": request_id}
        if session_id:
            response_payload["sessionId"] = session_id
        return web.Response(content_type="application/json", text=json.dumps(response_payload))

    async def _cleanup_peer(self, pc: RTCPeerConnection, pc_id: int, reason: str = "abandoned"):
        if pc_id not in self.sessions and pc not in self.pcs:
            return
        session = self.sessions.pop(pc_id, None)
        if session:
            await session.close(reason=reason)
        self.pcs.discard(pc)
        if pc.connectionState != "closed":
            await pc.close()
        logger.info(f"[Server] Cleaned up connection: {pc_id}")

    async def handle_index(self, request: web.Request) -> web.Response:
        index_path = os.path.join(ROOT_DIR, "index.html")
        with open(index_path, "r", encoding="utf-8") as f:
            return web.Response(content_type="text/html", text=f.read())

    async def handle_ice_servers(self, request: web.Request) -> web.Response:
        try:
            servers = await self.ice_provider.get_ice_servers()
        except Exception as e:
            logger.error(f"[ICE] Provider error: {e}")
            servers = []
        return web.Response(
            content_type="application/json",
            text=json.dumps({"iceServers": servers}),
        )

    async def handle_health(self, request: web.Request) -> web.Response:
        return web.Response(
            content_type="application/json",
            text=json.dumps({
                "status": "ok",
                "active_connections": len(self.pcs),
                "musetalk_ready": self.engine.avatar is not None,
                "avatar": self.engine.avatar.avatar_id if self.engine.avatar else None,
                # "blank" means this deployment renders no avatar at all — a
                # black frame at production geometry. Callers checking
                # musetalk_ready alone would not be able to tell.
                "mode": "blank" if self.config.blank_avatar else "avatar",
                "video": {
                    "canvas": f"{self.config.canvas_width}x{self.config.canvas_height}",
                    # Effective background, not just the flag: it is normally
                    # discovered per-avatar from data/background/<video_name>.png.
                    "canvas_background": resolve_canvas_background_path(
                        self.config,
                        self.engine.avatar.video_path if self.engine.avatar else "",
                    ) or "black",
                    "output_size": self.config.output_size,
                    "fps": self.config.fps,
                    "target_bitrate": self.config.video_bitrate,
                },
                "audio": {
                    "playback_sample_rate": self.config.playback_sample_rate,
                    "lipsync_sample_rate": AUDIO_SAMPLE_RATE,
                },
            }),
        )

    async def handle_metrics(self, request: web.Request) -> web.Response:
        """Per-session render/queue telemetry. MuseTalkRuntimeMetrics already
        computes all of this for the --musetalk_profile log line; this exposes the
        same window without needing to scrape logs."""
        sessions = []
        for pc_id, session in list(self.sessions.items()):
            m = session.metrics
            with m._lock:
                elapsed = max(1e-6, time.monotonic() - m.window_started_at)
                frame_samples = list(m.render_frame_ms_samples)
                sessions.append({
                    "pc_id": pc_id,
                    "taiboli_session_id": session.taiboli_session_id,
                    "is_speaking": session.is_speaking,
                    "total_frames": session.total_frames,
                    "window_seconds": round(elapsed, 3),
                    "render_ms_per_frame_avg": round(m.render_ms / m.render_frames, 2) if m.render_frames else 0.0,
                    "render_ms_per_frame_p95": round(float(np.percentile(frame_samples, 95)), 2) if frame_samples else 0.0,
                    # Splits render time into GPU (UNet+VAE) vs CPU (paste-back
                    # blend) so a stall can be attributed instead of guessed at.
                    "blend_ms_per_frame": round(m.blend_ms / m.render_frames, 2) if m.render_frames else 0.0,
                    "gpu_ms_per_frame": round((m.render_ms - m.blend_ms) / m.render_frames, 2) if m.render_frames else 0.0,
                    "render_batches": m.render_batches,
                    "frames_per_batch": round(m.render_frames / m.render_batches, 2) if m.render_batches else 0.0,
                    "feature_runs": m.feature_runs,
                    "feature_ms_per_run": round(m.feature_ms / m.feature_runs, 2) if m.feature_runs else 0.0,
                    "feature_prompts": m.feature_prompts,
                    # delivered_fps counts every frame handed to WebRTC including
                    # idle ones, so it is non-zero even when nobody is speaking;
                    # generated/displayed only move during a talking turn.
                    "delivered_fps": round(m.frames_delivered / elapsed, 2),
                    "generated_fps": round(m.display_generated / elapsed, 2),
                    "displayed_fps": round((m.display_generated + m.display_repeated) / elapsed, 2),
                    "repeated_frames": m.display_repeated,
                    "stale_prompt_drops": m.stale_prompt_drops,
                    "max_prompt_queue": m.max_prompt_queue,
                    "max_rendered_queue": m.max_rendered_queue,
                })
            sessions[-1]["dropped_mic_chunks"] = session._dropped_input_audio_chunks
            sessions[-1]["dropped_mic_ms"] = round(session._dropped_input_audio_ms, 1)
            # Barge-in health. false_barge_ins is the headline number for the
            # noisy-environment problem: upstream VAD said the learner started
            # speaking, we tore down playback, and then the response finished
            # normally — i.e. the "speech" was almost certainly room noise.
            sessions[-1]["speech_started_total"] = session._speech_started_count
            sessions[-1]["false_barge_ins"] = session._false_barge_ins
            sessions[-1]["pending_cancel_recovered"] = session._pending_cancel_recovered
            # Whether upstream input filtering is actually in force. "requested"
            # is what we asked for; "echoed" is what the endpoint confirmed —
            # they differ when the field is silently swallowed.
            gpt_rt = session.gpt_rt
            sessions[-1]["noise_reduction_requested"] = session.config.input_noise_reduction or None
            sessions[-1]["noise_reduction_echoed"] = gpt_rt.noise_reduction_echoed
            sessions[-1]["session_fields_stripped"] = gpt_rt.session_fields_stripped
            sessions[-1]["barge_ins_vetoed"] = session._barge_ins_vetoed
            # open_ratio doubles as a "how noisy is this learner's room" signal;
            # a low level_spread_db means AGC is probably still on at capture,
            # which defeats proximity detection.
            sessions[-1]["mic_gate"] = session.mic_gate.snapshot()
        return _json_response(200, {"active_connections": len(self.pcs), "sessions": sessions})

    async def on_shutdown(self, app: web.Application):
        await asyncio.gather(*[pc.close() for pc in self.pcs], return_exceptions=True)
        self.pcs.clear()
        await asyncio.gather(
            *[session.close(reason="abandoned") for session in list(self.sessions.values())],
            return_exceptions=True,
        )
        self.sessions.clear()


def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="MuseTalk Azure Realtime WebRTC production server")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=int(os.environ.get("AVATAR_PORT", 8000)))
    parser.add_argument("--frame_rate", type=int, default=25)
    parser.add_argument("--fps", type=int, default=25)
    parser.add_argument("--avatar_config", default="configs/inference/realtime.yaml")
    parser.add_argument("--avatar_id", default=None)
    parser.add_argument("--video_path", default=None)
    parser.add_argument("-S", "--source_path", default=None, help="Deprecated alias for --video_path")
    parser.add_argument("--iteration", type=int, default=None, help="Accepted for old prod compatibility; ignored")
    parser.add_argument("--result_dir", default="./results")
    parser.add_argument("--version", default="v15", choices=["v1", "v15"])
    parser.add_argument("--gpu_id", type=int, default=0)
    parser.add_argument("--vae_type", default="sd-vae")
    parser.add_argument("--unet_config", default="./models/musetalkV15/musetalk.json")
    parser.add_argument("--unet_model_path", default="./models/musetalkV15/unet.pth")
    parser.add_argument("--whisper_dir", default="./models/whisper")
    parser.add_argument("--bbox_shift", type=int, default=0)
    parser.add_argument("--extra_margin", type=int, default=10)
    parser.add_argument("--parsing_mode", default="jaw")
    parser.add_argument("--left_cheek_width", type=int, default=90)
    parser.add_argument("--right_cheek_width", type=int, default=90)
    parser.add_argument("--recreate_avatar", action="store_true")
    parser.add_argument("--musetalk_batch_size", type=int, default=4)
    parser.add_argument("--render_max_wait_ms", type=int, default=8)
    parser.add_argument("--av_sync_prebuffer_ms", type=int, default=240)
    parser.add_argument("--musetalk_profile", action="store_true")
    parser.add_argument("--musetalk_metrics_interval_ms", type=int, default=2000)
    parser.add_argument("--feature_step_ms", type=int, default=120)
    parser.add_argument("--mouth_ramp_frames", type=int, default=ServerConfig.mouth_ramp_frames,
                        help="Frames over which the mouth opens/closes at turn boundaries (0 = snap).")
    parser.add_argument("--feature_lead_frames", type=int, default=ServerConfig.feature_lead_frames,
                        help="Max video frames lip-sync feature extraction may run ahead of playback. "
                             "Bounds the CPU burst at turn start that otherwise freezes the avatar; "
                             "0 disables pacing.")
    parser.add_argument("--max_render_lag_frames", type=int, default=3)
    parser.add_argument("--render_ahead_frames", type=int, default=ServerConfig.render_ahead_frames,
                        help="Frames the renderer may work ahead of the audio clock. Controls batch "
                             "efficiency, not latency; too small pins it to batch~1 with no headroom.")
    parser.add_argument("--output_size", type=int, default=720,
                        help="Delivered video size (square); 0 = native source resolution. Does not affect lipsync model quality (256px face crop).")
    parser.add_argument("--compile_models", action="store_true",
                        help="torch.compile the UNet (fixed padded batch). Throughput win; adds startup compile time. Env: COMPILE_MODELS=1")
    parser.add_argument("--compile_mode", choices=["default", "reduce-overhead"],
                        default=None,
                        help="torch.compile mode. 'default' is safer; 'reduce-overhead' uses CUDA graphs (may break). Env: COMPILE_MODE")
    parser.add_argument("--vae_decoder", choices=["sd", "taesd"], default="sd",
                        help="VAE decoder: sd (full quality) or taesd (~10x faster tiny decoder; VALIDATE face/teeth quality first).")
    parser.add_argument("--warmup_musetalk", action="store_true")
    parser.add_argument("--warmup_seconds", type=float, default=1.5)
    # BooleanOptionalAction, not store_true: the CPU image bakes
    # AVATAR_BLANK_MODE=1, so the default here can be True — and with store_true
    # there would be no way to turn blank mode back OFF from the command line.
    # An env var leaking onto a GPU host would then serve black to real learners
    # with no override available. --no-blank_avatar is that override.
    parser.add_argument("--blank_avatar", action=argparse.BooleanOptionalAction,
                        default=_env_bool("AVATAR_BLANK_MODE", ServerConfig.blank_avatar),
                        help="Dev mode: serve a black frame at the normal delivered resolution "
                             "instead of a rendered avatar. Loads no models, needs no weights and "
                             "no GPU; the realtime voice loop, tool calling and the Taiboli bridge "
                             "are untouched. Also settable with AVATAR_BLANK_MODE=1.")
    parser.add_argument("--idle_mode", choices=["unet_closed", "unet_silence"], default="unet_closed",
                        help="Idle mouth source: unet_closed (searched closed-mouth prompt) or unet_silence (neutral prompt). Both share the talking lip color.")
    parser.add_argument("--idle_silence_noise", type=float, default=0.0,
                        help="unet_silence only: noise-floor RMS (0..1) to avoid the parted 'whistle' mouth from pure zeros")
    parser.add_argument("--canvas_width", type=int, default=ServerConfig.canvas_width,
                        help="Delivered frame width; avatar is centred on it. 0 = deliver the avatar frame as-is.")
    parser.add_argument("--canvas_height", type=int, default=ServerConfig.canvas_height,
                        help="Delivered frame height. Default 1280x720 gives a 16:9 stream from a square avatar.")
    parser.add_argument("--canvas_background", default=ServerConfig.canvas_background,
                        help="Override the still image behind the avatar. Default: data/background/"
                             "<video_name>.png for the selected avatar, else black bars.")
    parser.add_argument("--video_bitrate", type=int, default=ServerConfig.video_bitrate,
                        help="Target VP8 bitrate in bits/sec. aiortc's own ceiling is 1.5 Mbps, which visibly "
                             "limits a 720px talking head; 0 keeps aiortc defaults.")
    parser.add_argument("--cv_threads", type=int, default=ServerConfig.cv_threads,
                        help="OpenCV worker threads (0 = leave alone). Bounded so the CV pool does not "
                             "oversubscribe the event loop and render worker.")
    parser.add_argument("--playback_sample_rate", type=int, default=ServerConfig.playback_sample_rate,
                        help="Audio rate delivered to the browser. Defaults to Azure's native 24000; the old "
                             "16000 discarded everything above 8 kHz. Lip-sync always uses 16 kHz internally.")
    parser.add_argument("--azure_openai_endpoint", default=ServerConfig.azure_openai_endpoint)
    parser.add_argument("--azure_openai_deployment", default=ServerConfig.azure_openai_deployment)
    parser.add_argument("--azure_api_version", default=ServerConfig.azure_api_version)
    parser.add_argument("--azure_realtime_url_style", choices=["ga", "preview"], default=ServerConfig.azure_realtime_url_style)
    parser.add_argument("--gpt_rt_voice", default=ServerConfig.gpt_rt_voice)
    parser.add_argument("--input_transcription_model", default=ServerConfig.input_transcription_model)
    parser.add_argument("--vad_threshold", type=float, default=ServerConfig.vad_threshold)
    parser.add_argument("--vad_prefix_padding_ms", type=int, default=ServerConfig.vad_prefix_padding_ms)
    parser.add_argument("--vad_silence_duration_ms", type=int, default=ServerConfig.vad_silence_duration_ms)
    # Upstream input filtering. "" omits the field (relay parity); "none" sends
    # an explicit null as a zero-risk probe that the endpoint parses it.
    parser.add_argument("--input_noise_reduction", choices=["", "none", "near_field", "far_field"],
                        default=ServerConfig.input_noise_reduction,
                        help="upstream noise reduction, applied before the remote VAD (default: omit the field)")
    parser.add_argument("--vad_eagerness", choices=["", "low", "medium", "high", "auto"],
                        default=ServerConfig.semantic_vad_eagerness,
                        help="semantic_vad turn-END eagerness; 'low' gives a hesitating learner more room")
    # Local mic gate. Off by default; every knob also readable from env.
    parser.add_argument("--mic_gate", choices=["off", "energy", "silero"], default=ServerConfig.mic_gate,
                        help="attenuate non-speech before it reaches the upstream VAD")
    parser.add_argument("--mic_gate_mode", choices=["attenuate", "silence", "dither"],
                        default=ServerConfig.mic_gate_mode)
    parser.add_argument("--mic_gate_attenuation_db", type=float, default=ServerConfig.mic_gate_attenuation_db)
    parser.add_argument("--mic_gate_open_threshold", type=float, default=ServerConfig.mic_gate_open_threshold)
    parser.add_argument("--mic_gate_preroll_ms", type=int, default=ServerConfig.mic_gate_preroll_ms,
                        help="look-ahead; adds this much latency but makes onset clipping zero")
    parser.add_argument("--mic_proximity", choices=["off", "veto", "gate"], default=ServerConfig.mic_proximity,
                        help="level-based near/far speech discrimination (needs AGC off at capture)")
    parser.add_argument("--mic_proximity_margin_db", type=float, default=ServerConfig.mic_proximity_margin_db)
    parser.add_argument("--barge_in_corroboration", choices=["off", "energy", "gate", "near"],
                        default=ServerConfig.barge_in_corroboration,
                        help="require the local gate to confirm an upstream speech_started")
    parser.add_argument("--taiboli_api_base_url", default=ServerConfig.taiboli_api_base_url)
    parser.add_argument("--system_prompt", default=ServerConfig.system_prompt)
    parser.add_argument("--prepare_only", action="store_true")
    parser.add_argument("--dry_run", action="store_true")
    return parser


def config_from_args(args) -> ServerConfig:
    video_path = args.video_path or args.source_path
    if args.source_path and not args.video_path:
        logger.warning("[Config] -S/--source_path is deprecated; using it as --video_path")
    if args.iteration is not None:
        logger.info("[Config] --iteration is ignored by MuseTalk")
    return ServerConfig(
        host=args.host,
        port=args.port,
        frame_rate=min(args.frame_rate, 25),
        fps=min(args.fps, 25),
        system_prompt=args.system_prompt,
        azure_openai_endpoint=args.azure_openai_endpoint,
        azure_openai_deployment=args.azure_openai_deployment,
        azure_api_version=args.azure_api_version,
        azure_realtime_url_style=args.azure_realtime_url_style,
        gpt_rt_voice=args.gpt_rt_voice,
        input_transcription_model=args.input_transcription_model,
        vad_threshold=args.vad_threshold,
        vad_prefix_padding_ms=args.vad_prefix_padding_ms,
        vad_silence_duration_ms=args.vad_silence_duration_ms,
        input_noise_reduction=args.input_noise_reduction,
        semantic_vad_eagerness=args.vad_eagerness,
        mic_gate=args.mic_gate,
        mic_gate_mode=args.mic_gate_mode,
        mic_gate_attenuation_db=args.mic_gate_attenuation_db,
        mic_gate_open_threshold=args.mic_gate_open_threshold,
        mic_gate_preroll_ms=args.mic_gate_preroll_ms,
        mic_proximity=args.mic_proximity,
        mic_proximity_margin_db=args.mic_proximity_margin_db,
        barge_in_corroboration=args.barge_in_corroboration,
        taiboli_api_base_url=args.taiboli_api_base_url,
        avatar_config=args.avatar_config,
        avatar_id=args.avatar_id,
        video_path=video_path,
        result_dir=args.result_dir,
        version=args.version,
        gpu_id=args.gpu_id,
        vae_type=args.vae_type,
        unet_config=args.unet_config,
        unet_model_path=args.unet_model_path,
        whisper_dir=args.whisper_dir,
        bbox_shift=args.bbox_shift,
        extra_margin=args.extra_margin,
        parsing_mode=args.parsing_mode,
        left_cheek_width=args.left_cheek_width,
        right_cheek_width=args.right_cheek_width,
        recreate_avatar=args.recreate_avatar,
        musetalk_batch_size=max(1, args.musetalk_batch_size),
        render_max_wait_ms=max(0, args.render_max_wait_ms),
        av_sync_prebuffer_ms=max(0, args.av_sync_prebuffer_ms),
        musetalk_profile=bool(args.musetalk_profile),
        musetalk_metrics_interval_ms=max(250, args.musetalk_metrics_interval_ms),
        feature_step_ms=max(20, args.feature_step_ms),
        feature_lead_frames=max(0, args.feature_lead_frames),
        mouth_ramp_frames=max(0, min(10, args.mouth_ramp_frames)),
        max_render_lag_frames=min(6, max(0, args.max_render_lag_frames)),
        render_ahead_frames=min(200, max(0, args.render_ahead_frames)),
        output_size=max(0, args.output_size),
        compile_models=bool(args.compile_models) or _env_bool("COMPILE_MODELS", False),
        compile_mode=args.compile_mode or _env_choice("COMPILE_MODE", "reduce-overhead", ("default", "reduce-overhead")),
        vae_decoder=args.vae_decoder,
        warmup_musetalk=bool(args.warmup_musetalk),
        warmup_seconds=max(0.1, args.warmup_seconds),
        idle_mode=args.idle_mode,
        idle_silence_noise=max(0.0, args.idle_silence_noise),
        canvas_width=max(0, args.canvas_width),
        canvas_height=max(0, args.canvas_height),
        canvas_background=args.canvas_background,
        video_bitrate=max(0, args.video_bitrate),
        cv_threads=max(0, args.cv_threads),
        playback_sample_rate=max(8000, args.playback_sample_rate),
        blank_avatar=bool(args.blank_avatar),
    )


async def run_server(config: ServerConfig):
    limit_cpu_thread_pools(config.cv_threads)
    # Must happen before any RTCPeerConnection builds an encoder.
    raise_video_bitrate_ceiling(config.video_bitrate)
    server = WebRTCServer(config)
    await server.initialize()
    app = web.Application()
    app.on_shutdown.append(server.on_shutdown)

    try:
        import aiohttp_cors
        # "*" together with allow_credentials echoes back whatever Origin asked
        # and permits cookies, so any site could drive a credentialed /offer.
        # AVATAR_ALLOWED_ORIGINS (comma-separated) narrows it; credentials are
        # only granted to explicitly listed origins.
        raw_origins = os.environ.get("AVATAR_ALLOWED_ORIGINS", "").strip()
        allowed_origins = [o.strip().rstrip("/") for o in raw_origins.split(",") if o.strip()]
        if allowed_origins:
            defaults = {
                origin: aiohttp_cors.ResourceOptions(
                    allow_credentials=True,
                    expose_headers="*",
                    allow_headers="*",
                )
                for origin in allowed_origins
            }
            logger.info(f"[Server] CORS restricted to {len(allowed_origins)} origin(s): {', '.join(allowed_origins)}")
        else:
            # Permissive default: the browser sends credentials: "include", and a
            # literal "*" is invalid alongside Allow-Credentials, so aiohttp_cors
            # reflects the request Origin instead. Any site can therefore make
            # credentialed calls here — fine for a dev box, not for one real
            # learners connect to. Set AVATAR_ALLOWED_ORIGINS to lock it down
            # without a code change.
            defaults = {
                "*": aiohttp_cors.ResourceOptions(
                    allow_credentials=True,
                    expose_headers="*",
                    allow_headers="*",
                )
            }
            logger.warning(
                "[Server] AVATAR_ALLOWED_ORIGINS is unset - reflecting ANY origin with credentials. "
                "Set it to a comma-separated origin list before this serves real users."
            )
        cors = aiohttp_cors.setup(app, defaults=defaults)
    except Exception as e:
        logger.warning(f"[Server] CORS setup unavailable: {e}")
        cors = None

    app.router.add_get("/", server.handle_index)
    offer_route = app.router.add_post("/offer", server.handle_offer)
    ice_route = app.router.add_get("/ice-servers", server.handle_ice_servers)
    health_route = app.router.add_get("/health", server.handle_health)
    metrics_route = app.router.add_get("/metrics", server.handle_metrics)
    # NOTE: this used to be add_static("/static/", path=ROOT_DIR), which published
    # the entire repo over HTTP - source, configs, avatar videos, and any .env
    # sitting in the root. index.html is fully self-contained (inline CSS/JS, mic
    # worklet from a Blob URL), so only an explicit assets dir is exposed, and
    # only if it exists.
    static_dir = os.path.join(ROOT_DIR, "static")
    if os.path.isdir(static_dir):
        app.router.add_static("/static/", path=static_dir, name="static")
        logger.info(f"[Server] Serving static assets from {static_dir}")
    if cors is not None:
        cors.add(offer_route)
        cors.add(ice_route)
        cors.add(health_route)
        cors.add(metrics_route)

    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, config.host, config.port)
    await site.start()
    avatar_id = server.engine.avatar.avatar_id if server.engine.avatar else "unknown"
    logger.info(f"Server started at http://{config.host}:{config.port}")
    if config.blank_avatar:
        logger.warning("MuseTalk avatar: DISABLED (--blank_avatar) — serving a black frame")
    else:
        logger.info(f"MuseTalk avatar: {avatar_id}")
    logger.info(f"Azure RT deployment: {config.azure_openai_deployment}")
    await asyncio.Event().wait()


def main():
    parser = build_arg_parser()
    args = parser.parse_args()
    config = config_from_args(args)
    if args.prepare_only or args.dry_run:
        if config.blank_avatar:
            # Both build/benchmark the real avatar cache, which is exactly what
            # blank mode has no models for. Fail loudly instead of importing a
            # stack the CPU image doesn't ship.
            parser.error("--blank_avatar cannot be combined with --prepare_only/--dry_run")
        engine = MuseTalkEngine(config)
        engine.initialize()
        if args.dry_run:
            engine.dry_run()
        return
    try:
        asyncio.run(run_server(config))
    except KeyboardInterrupt:
        logger.info("\n[Server] Stopped")


if __name__ == "__main__":
    main()
